{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "panels": [
    {
      "type": "logs",
      "title": "All service logs (last 15m, errors)",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{job=~\".+\"} | json | level=\"error\" or level=\"fatal\"",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Scheduler job failures (fatal)",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=\"scheduler\"} | json | event=\"scheduler_job_failing_repeatedly\"",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Super-admin cross-tenant ops",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=\"auth-service\"} |= \"super-admin\"",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["lumaara", "logs"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Lumaara · Errors + security events",
  "uid": "lumaara-logs",
  "version": 1
}
