# Lumaara auth-service unit. Deploy at /etc/systemd/system/lumaara-auth.service.
# See infra/systemd/README.md for the full unit set + install steps.
[Unit]
Description=Lumaara auth-service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=lumaara
Group=lumaara
WorkingDirectory=/opt/lumaara/services/auth-service
# Sourced secrets: chmod 600 /etc/lumaara/env, owner=lumaara. Every unit
# reads the same file so a secret rotation is one edit + one restart.
EnvironmentFile=/etc/lumaara/env
Environment=PORT=4001
Environment=NODE_ENV=production
# Workspace packages ship source TS — `pnpm start` = tsx src/index.ts.
# See infra/systemd/README.md for why we can't ship compiled JS today.
ExecStart=/usr/bin/pnpm --filter @lumaara/auth-service start
# Block `systemctl start` from returning until the app answers /health/ready.
# nginx never sees a half-booted upstream; a rolling restart of a single unit
# doesn't 502. See infra/systemd/wait-ready.sh for the polling logic.
ExecStartPost=/opt/lumaara/infra/systemd/wait-ready.sh 4001 60

# Restart discipline. `on-failure` skips clean exits (SIGTERM = graceful
# shutdown → don't restart). Backoff prevents tight-crash loops on
# misconfigured secrets: 3 crashes in 5min → hold off 30s.
Restart=on-failure
RestartSec=5
StartLimitBurst=3
StartLimitIntervalSec=300

# journald captures every stdout/stderr line. Our JSON structured logger
# already writes single-line JSON — journalctl -o cat -u lumaara-auth
# produces clean grep-friendly output.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lumaara-auth

# Filesystem lockdown: service can only write to its own dir + backups.
# Prevents a compromised process from touching /etc or /home.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lumaara/backups /var/log/lumaara /opt/lumaara/services/auth-service/.next-cache

# Graceful shutdown window matches installGracefulShutdown's drain time
# (15s in mcp-server, similar elsewhere).
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=lumaara.target
