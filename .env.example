# ─────────────────────────────────────────────────────────────────────
# Lumaara ERP — environment variables
# ─────────────────────────────────────────────────────────────────────
#
# Copy to .env for local dev. For production, do NOT commit .env — use
# your orchestrator's secret store (Docker Compose .env with chmod 600,
# AWS Secrets Manager, HashiCorp Vault, Fly secrets, etc.).
#
# docker-compose.prod.yml uses ${VAR:?err} syntax that refuses to boot
# if any required secret is unset, so you cannot accidentally ship with
# the dev defaults below.
#
# See PRODUCTION.md for the full go-live checklist (secret rotation,
# TLS termination, backup, lumaara_app role + RLS flip, modular DB).

# ─────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────
# Runtime connection used by services at request time. In production
# this SHOULD point at the NOSUPERUSER + NOBYPASSRLS `lumaara_app` role
# once you have run the RLS context switch (see PRODUCTION.md).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumaara?schema=public

# Admin connection used only by Prisma migrations + schema introspection.
# Needs CREATE SCHEMA, GRANT, ALTER TABLE SET SCHEMA privileges —
# usually the postgres superuser. Kept separate so runtime services can
# drop to lumaara_app without breaking `prisma migrate deploy`.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/lumaara?schema=public

# ─────────────────────────────────────────────────────────────────────
# Service ports (backend)
# ─────────────────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=4001
ACCOUNTING_SERVICE_PORT=4002
STOCK_SERVICE_PORT=4003
CRM_SERVICE_PORT=4004
HR_SERVICE_PORT=4005
PROJECTS_SERVICE_PORT=4006
SCHEDULER_PORT=4009
MCP_SERVER_PORT=4110

# ─────────────────────────────────────────────────────────────────────
# Frontend ports
# ─────────────────────────────────────────────────────────────────────
SHELL_PORT=3000
ACCOUNTING_WEB_PORT=3001
BUYING_WEB_PORT=3002
STOCK_WEB_PORT=3003
CRM_WEB_PORT=3004
HR_WEB_PORT=3005
PROJECTS_WEB_PORT=3006
PORTAL_WEB_PORT=3007

# ─────────────────────────────────────────────────────────────────────
# Secrets — ROTATE EVERY ONE OF THESE BEFORE GOING LIVE
# ─────────────────────────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
#
# JWT_SECRET          — signs staff auth tokens. Rotating invalidates
#                       every existing session (users must re-login).
# PORTAL_JWT_SECRET   — signs portal (customer-facing) user tokens.
# UNSUBSCRIBE_SECRET  — HMACs email unsubscribe links. Rotating breaks
#                       already-sent unsubscribe URLs.
# MASTER_SECRET_KEY   — encrypts TenantIntegration.secrets +
#                       AnonymizationArchive payloads. LOSING THIS
#                       BRICKS ALL ENCRYPTED DATA — back it up to a
#                       separate secret store. 32+ chars required.
#                       Rotating requires re-encrypting every row;
#                       see PRODUCTION.md.
JWT_SECRET=change-me-32chars-min-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
PORTAL_JWT_SECRET=change-me-32chars-min-openssl-rand-hex-32
UNSUBSCRIBE_SECRET=change-me-32chars-min-openssl-rand-hex-32
MASTER_SECRET_KEY=change-me-32chars-min-openssl-rand-hex-32

# Scheduler → service HTTP fanout. Bearer token the scheduler uses to
# call the other services' internal endpoints (e.g. recurring invoice
# generation). Rotate independently of JWT_SECRET.
SCHEDULER_API_TOKEN=change-me-32chars-min-openssl-rand-hex-32

# ─────────────────────────────────────────────────────────────────────
# Service → service URLs
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:4001
NEXT_PUBLIC_ACCOUNTING_SERVICE_URL=http://localhost:4002
NEXT_PUBLIC_STOCK_SERVICE_URL=http://localhost:4003
NEXT_PUBLIC_CRM_SERVICE_URL=http://localhost:4004
NEXT_PUBLIC_HR_SERVICE_URL=http://localhost:4005
NEXT_PUBLIC_PROJECTS_SERVICE_URL=http://localhost:4006
PUBLIC_AUTH_URL=http://localhost:4001

# Show the "Demo: demo@lumaara.local · demo1234" hint on the login +
# landing pages. ONLY set to "1" in dev/sandbox environments. Must be
# unset or "0" in production.
NEXT_PUBLIC_SHOW_DEMO_CREDENTIALS=1

# Shell proxy targets (next.config.js rewrites use these to reach
# the microfrontend apps). Replace with internal hostnames in prod.
ACCOUNTING_WEB_URL=http://localhost:3001
BUYING_WEB_URL=http://localhost:3002
STOCK_WEB_URL=http://localhost:3003
CRM_WEB_URL=http://localhost:3004
HR_WEB_URL=http://localhost:3005
PROJECTS_WEB_URL=http://localhost:3006
PORTAL_PUBLIC_URL=http://localhost:3007

# Base URL customers see in email links, OAuth redirects, invoice PDFs.
# Required for correctness of outbound links; defaults to localhost dev.
PUBLIC_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────
# Security — CORS + tenant isolation
# ─────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of origins permitted to call the services.
# Required in production — services refuse to boot without it when
# NODE_ENV=production. Dev falls back to a built-in localhost list.
# ALLOWED_ORIGINS=https://app.example.com,https://portal.example.com

# Tenant guard mode — the Prisma middleware that refuses tenant-scoped
# queries without a `tenantId` filter.
#   enforce  (prod default)  throw on violation — data-leak protection
#   warn     (dev default)   log to stderr, don't throw
#   off      scripts only    bypass entirely — DO NOT USE IN PROD
TENANT_GUARD_MODE=warn

# Row-level security context propagation. When true AND services connect
# as `lumaara_app` (NOSUPERUSER + NOBYPASSRLS), every tenant-scoped
# query auto-wraps in a transaction that sets `app.current_tenant_id`
# so Postgres RLS policies enforce isolation at the DB layer.
# See PRODUCTION.md § "Activate RLS context propagation".
RLS_ENFORCE=false

# ─────────────────────────────────────────────────────────────────────
# Async work — Redis / BullMQ
# ─────────────────────────────────────────────────────────────────────
# Leave unset to run queues in inline mode (jobs execute next-tick in the
# enqueueing process; nothing persists across restarts — fine for dev,
# NOT for prod). Set to a real Redis for retries, distributed workers,
# dead-letter queue, rate-limit tokens shared across replicas.
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────
# OTLP/HTTP endpoint for OpenTelemetry traces + metrics. Point at any
# OTLP collector (Jaeger, Grafana Alloy, Honeycomb, Datadog, etc.).
# Leave unset to disable OTel export (console-only logging still works).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Semver or git SHA — surfaces in logs + OTel attributes. Helpful when
# correlating a prod incident with a specific deploy.
APP_VERSION=dev

# Log level: debug | info | warn | error. Default info.
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────
# SMTP (transactional email)
# ─────────────────────────────────────────────────────────────────────
# Leave SMTP_HOST unset in dev; email sending is logged + no-op'd.
# Prod: use SES, SendGrid, Postmark, Mailgun, or your own relay.
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com

# ─────────────────────────────────────────────────────────────────────
# AI providers (platform-level fallback)
# ─────────────────────────────────────────────────────────────────────
# These are DEV-ONLY fallbacks for when PlatformAiProvider has no row.
# In production, configure providers via Super Admin → AI Providers
# (encrypted at rest with MASTER_SECRET_KEY) rather than env vars.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# SAML SSO — per-tenant, configured via /sso-providers admin API.
# ─────────────────────────────────────────────────────────────────────
# No env vars required. Configure per-tenant with:
#   POST /sso-providers { provider:"saml", issuer, clientId, clientSecret, ... }
#
# Fields:
#   provider                     = "saml"
#   issuer                       = SP entityID (your side — any URL/URN)
#   clientId                     = IdP SSO entryPoint URL
#   clientSecret                 = IdP signing cert (PEM, stored encrypted)
#   samlEmailAttr                = attribute name holding email (default: NameID → "email")
#   samlDisplayNameAttr          = attribute name holding display name (default: "displayName" → "cn")
#   samlWantAssertionsSigned     = require signed assertions (default: true, keep true in prod)
#   samlSpPrivateKey + samlSpCert = SP keypair (PEM) for signed AuthnRequests + encrypted assertions
#   samlSignRequests             = sign outbound AuthnRequests (needs SP keypair)
#   samlLogoutUrl                = IdP SLO endpoint — enables Single Logout
#   samlValidateInResponseTo     = "always" (default) | "ifPresent" | "never"
#   allowedEmailDomains          = ["acme.com"] — empty allows any domain
#   autoProvision                = JIT-create users on first SSO login (default true)
#   defaultRole                  = role for auto-provisioned users (default "user")
#
# Discovery endpoints (unauth):
#   GET  /auth/sso/saml/:tenantSlug/metadata     SP metadata XML
#   GET  /auth/sso/saml/:tenantSlug/login        SP-initiated login redirect
#   POST /auth/sso/saml/:tenantSlug/acs          SAMLResponse consumer
#   POST /auth/sso/saml/:tenantSlug/slo          IdP-initiated logout
#   POST /auth/sso/saml/:tenantSlug/slo-initiate SP-initiated logout
