# Production env vars for docker-compose.prod.yml.
# Copy to `.env` in this directory and fill in real values.
# chmod 600 .env — this file contains secrets.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# Compose will REFUSE to boot if any ${VAR:?err} entry is unset.

# --- Postgres ---
POSTGRES_USER=lumaara
POSTGRES_PASSWORD=CHANGE-ME-strong-random-password
POSTGRES_DB=lumaara

# --- Secrets (must be 32+ char random, use `openssl rand -hex 32`) ---
JWT_SECRET=
PORTAL_JWT_SECRET=
MASTER_SECRET_KEY=
SCHEDULER_API_TOKEN=

# --- URLs ---
PORTAL_PUBLIC_URL=https://portal.your-domain.com
PUBLIC_URL=https://erp.your-domain.com

# --- Backend service base URLs (external — what browsers hit) ---
# Set these to the public-facing URLs your reverse proxy exposes. In a
# single-domain deploy, use path-based routing (e.g. /api/auth → auth-service:4001).
AUTH_SERVICE_URL=https://erp.your-domain.com/api/auth
ACCOUNTING_SERVICE_URL=https://erp.your-domain.com/api/accounting
STOCK_SERVICE_URL=https://erp.your-domain.com/api/stock
CRM_SERVICE_URL=https://erp.your-domain.com/api/crm
HR_SERVICE_URL=https://erp.your-domain.com/api/hr
PROJECTS_SERVICE_URL=https://erp.your-domain.com/api/projects

# --- Frontend host ports (behind your TLS reverse proxy) ---
SHELL_HOST_PORT=8080
PORTAL_HOST_PORT=8081

# --- SMTP (optional; leave SMTP_HOST empty to log emails to stdout) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@your-domain.com
SMTP_USER=
SMTP_PASSWORD=

# --- Backup retention (days + count, applied after every successful backup) ---
BACKUP_KEEP_LAST=30
BACKUP_KEEP_DAYS=90

# --- Automated daily backups (opt-in) ---
# Set BACKUP_AUTO_ENABLE=1 to have the scheduler run backups automatically
# every BACKUP_AUTO_INTERVAL_HOURS (default 24). Only fires for tenants who
# have configured an active s3 TenantIntegration — the S3 upload is the
# signal that they want off-host copies.
BACKUP_AUTO_ENABLE=0
BACKUP_AUTO_INTERVAL_HOURS=24

# --- Weekly backup verification (opt-in, strongly recommended) ---
# Runs pg_restore --list against the latest Succeeded backup per tenant
# every BACKUP_VERIFY_INTERVAL_HOURS (default 168 = weekly). Prefers the
# S3 copy over local — proves the offsite bytes are readable + parseable
# (catches truncation, wrong format, bit rot, S3 partial download).
# Failure writes a BackupVerification row (status=Failed) + a Notification
# to every SystemManager in the tenant. Turn on the moment BACKUP_AUTO is
# enabled — otherwise "Succeeded but silently corrupt" backups are
# invisible until you actually need to restore.
BACKUP_VERIFY_ENABLE=0
BACKUP_VERIFY_INTERVAL_HOURS=168

# --- Observability (optional; set endpoint to enable OTLP export) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Cross-tenant guard ---
# When NODE_ENV=production, the default is `enforce`: any set-returning
# Prisma query on a tenant-scoped model that omits `where.tenantId` throws
# (see packages/db/src/tenant-guard.ts). This is the correct posture for
# prod — a missing tenantId is a data-leak bug and must fail loud.
#
# During a first-boot rollout you MAY set this to `warn` for a short soak
# window (queries proceed but violations are logged). Grep journalctl for
# `[tenant-guard]` for a day, fix any hits, then REMOVE this line so the
# default `enforce` takes over.
#
# Options: enforce (default in prod) | warn (soak-only) | off (never in prod)
# TENANT_GUARD_MODE=enforce

# --- India e-invoice IRN adapter selection ---
# `stub` (default) — deterministic sha256 IRN, no network call. Use for demos
#   and for tenants under the ₹5cr B2B threshold who don't need real IRNs.
# `live`           — LiveIrpAdapter picks up TenantIntegration provider="irp"
#   secrets per tenant (configure via admin UI /admin/integrations) and calls
#   the GSP. If a tenant has no IRP integration, that tenant silently falls
#   back to stub with a log warning — invoice creation flows never break on
#   missing config.
EINVOICE_ADAPTER=stub

# --- Version tag (surfaces in logs + OTEL) ---
APP_VERSION=v0.1.0

# --- JWT expiry (default 7d — shorten for higher-security deployments) ---
JWT_EXPIRES_IN=7d
