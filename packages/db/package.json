{
  "name": "@lumaara/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tree": "./src/tree.ts",
    "./calendar": "./src/calendar.ts",
    "./i18n": "./src/i18n.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "seed:agents": "tsx scripts/seed-agent-defaults.ts",
    "seed:demo-analytics": "tsx scripts/seed-demo-analytics.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "tenant-export": "tsx scripts/tenant-export.ts",
    "tenant-delete": "tsx scripts/tenant-delete.ts",
    "rotate-master-key": "tsx scripts/rotate-master-key.ts",
    "check:tenant-guard": "tsx scripts/check-tenant-guard-sync.ts",
    "check:tenant-index": "tsx scripts/check-tenant-index-coverage.ts",
    "check:nplus1": "tsx scripts/check-nplus1.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@lumaara/shared-types": "workspace:*",
    "@prisma/client": "^5.20.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@vitest/coverage-v8": "^3.2.7",
    "bcryptjs": "^2.4.3",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7",
    "zod": "^3.23.8"
  }
}
