// Prisma schema — mirrors ERPNext DocType names where possible.
// Every business row carries tenantId. All queries must filter on it.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  // Runtime connection — services connect as the NOSUPERUSER + NOBYPASSRLS
  // `lumaara_app` role so RLS is actually enforced on tenant-scoped tables.
  url      = env("DATABASE_URL")
  // Migrations + introspection use the superuser URL so DDL (CREATE SCHEMA,
  // GRANT, ALTER TABLE SET SCHEMA, etc.) can run. Falls back to DATABASE_URL
  // in local dev where the two can be the same.
  directUrl = env("DATABASE_ADMIN_URL")
  // Six logical schemas matching the five business modules + platform
  // (cross-cutting infra: tenants, users, auth, subscriptions, audit).
  // Services connect as per-schema roles (lumaara_<module>_app) in prod
  // so an HR service that gets compromised can't SELECT accounting rows.
  // See docs/SCHEMA-MODULARIZATION.md for the full architecture.
  schemas  = ["public", "platform", "hrms", "payroll", "finance", "sales", "manufacturing"]
}

// ---------- Tenancy & Identity ----------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Default account IDs (populated by seedTenantDefaults after Accounts exist).
  // ERPNext-style: needed for auto-posting from documents.
  defaultReceivableAccountId                String?
  defaultPayableAccountId                   String?
  defaultCashAccountId                      String?
  defaultBankAccountId                      String?
  defaultIncomeAccountId                    String?
  defaultExpenseAccountId                   String?
  // Perpetual inventory accounting (DeliveryNote / PurchaseReceipt posting).
  defaultStockInHandAccountId               String?
  defaultCogsAccountId                      String?
  defaultStockReceivedButNotBilledAccountId String?
  // Payroll accounting (Salary Slip posting).
  defaultSalaryExpenseAccountId             String?
  defaultEmployeePayableAccountId           String?
  defaultStatutoryPayableAccountId          String?
  // FX gain/loss recognition on payment settlement (booked when payment's
  // conversionRate differs from the invoice's — see PaymentEntry submit).
  defaultFxGainLossAccountId                String?
  // Employee loans: outstanding principal accrues on defaultLoanReceivableAccountId
  // (Asset). Interest portion of each repayment credits defaultInterestIncomeAccountId.
  defaultLoanReceivableAccountId            String?
  defaultInterestIncomeAccountId            String?
  // Year-end closing (B7): closing JE credits net income here after zeroing
  // out every Income/Expense account.
  defaultRetainedEarningsAccountId          String?
  // B12: SI/PI submit posts the rounding delta (Math.round(grandTotal) −
  // grandTotal) to this account so ledgers stay tidy round-number totals.
  // Null → rounding is disabled, docs post their raw grandTotal.
  defaultRoundOffAccountId                  String?
  // C3: Stock Reconciliation writes the +/- valuation delta (from re-count
  // or re-rate) into this expense account (shrinkage / stock gain).
  defaultStockAdjustmentAccountId           String?
  // D5+: Loyalty point redemption discount. When a customer redeems points
  // against an SI, submit posts DR here for the discount amount so the
  // Debtors debit drops correspondingly. Typically a contra-income
  // ("Loyalty Discount Given") or a marketing expense account. Null →
  // loyalty redemption is disallowed at submit time (helpful error).
  defaultLoyaltyDiscountAccountId           String?
  // D12+: Deferred Revenue recognition. When an Item has
  // enableDeferredRevenue=true, SI submit credits this LIABILITY account
  // (instead of Sales) for that item's line net, and materializes a
  // DeferredRevenueSchedule of monthly recognitions. The scheduler tick
  // walks due rows and posts DR here / CR Sales to move the amount out of
  // deferred and into recognized income. Null → deferred revenue is
  // disallowed at SI submit time.
  defaultDeferredRevenueAccountId           String?
  // C4: default price lists used to auto-fill SI/PI/PO/Quotation rates.
  // Optional; when null the doc uses item.standardRate as before.
  defaultSellingPriceListId                 String?
  defaultBuyingPriceListId                  String?
  // E1: fallback holiday list used when Employee.holidayListId is null.
  defaultHolidayListId                      String?
  // Multi-currency: GL is always in base currency; invoice amounts multiplied
  // by invoice.conversionRate at post time. Defaults to "INR" for new tenants.
  baseCurrency                              String  @default("INR")
  // Default UI locale for this tenant. Individual users can override
  // via localStorage `lumaara.locale`. Server-side reports (emails,
  // PDFs) use this. See packages/db/src/i18n.ts for supported values.
  locale                                    String  @default("en")
  // India GST home identifiers. companyGstin drives IGST vs CGST+SGST split
  // in GSTR-1: when customer's GSTIN state code matches homeStateCode →
  // CGST+SGST (intra-state); mismatch → IGST (inter-state).
  companyGstin                              String?
  homeStateCode                             String? // 2-digit numeric prefix of companyGstin (e.g. "27" for MH)
  // India TAN — 10-char Tax deduction & collection Account Number, required
  // on Form 16A + quarterly 26Q. Format: [A-Z]{4}[0-9]{5}[A-Z].
  companyTan                                String?
  // India PAN of the tenant/company (distinct from GSTIN which encodes PAN
  // in positions 3-12). Format: [A-Z]{5}[0-9]{4}[A-Z]. Required on Form 16A.
  companyPan                                String?
  // Locale used by print templates when no ?locale= query param is passed.
  // BCP-47-ish tag; only lookups the print/i18n module supports actually
  // change output (unknown → falls back to en).
  defaultLocale                             String? @default("en")
  // Marketing P3 (approvals): when true, Campaign / SocialPost / Broadcast
  // sends refuse to leave Draft/Scheduled unless an active MarketingApproval
  // (status=Approved, ≤30d old) exists. Default false so existing tenants
  // keep the unchanged send flow.
  requireMarketingApproval                  Boolean @default(false)
  // Payment reminders — day counts after invoice.dueDate at which the
  // scheduler auto-emails each escalating reminder. JSON so tenants can
  // add / remove tiers without a migration. Shape:
  //   { "first": 7, "second": 30, "final": 60 }
  // Null → reminders disabled for this tenant. See pure helpers in
  // packages/db/src/reminders.ts for pickReminderKind semantics.
  reminderThresholds                        Json?

