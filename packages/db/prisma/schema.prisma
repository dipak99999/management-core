// ---------- CRM: Sales Target + Actual ----------

model CrmTarget {
  id           String   @id @default(cuid())
  tenantId     String
  ownerUserId  String?
  employeeId   String?
  territoryId  String?
  itemGroupId  String?
  periodType   String // Monthly | Quarterly | Yearly
  periodStart  DateTime @db.Date
  periodEnd    DateTime @db.Date
  targetQty    Decimal? @db.Decimal(18, 4)
  targetAmount Decimal? @db.Decimal(18, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerUserId, periodStart])
  @@index([tenantId, employeeId, periodStart])
  @@map("crm_targets")
  @@schema("public")
}

model CrmTargetActual {
  id            String   @id @default(cuid())
  tenantId      String
  targetId      String?
  ownerUserId   String?
  employeeId    String?
  postingDate   DateTime @db.Date
  actualQty     Decimal  @default(0) @db.Decimal(18, 4)
  actualAmount  Decimal  @default(0) @db.Decimal(18, 4)
  sourceDoctype String? // SalesInvoice | SalesOrder | Quotation
  sourceDocId   String?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerUserId, postingDate])
  @@index([tenantId, targetId])
  @@map("crm_target_actuals")
  @@schema("public")
}

// ---------- CRM: Work Plan + Daily Worksheet + Process ----------

model WorkPlan {
  id            String   @id @default(cuid())
  tenantId      String
  ownerUserId   String
  employeeId    String?
  weekStartDate DateTime @db.Date
  planTitle     String
  summary       String?
  status        String   @default("Draft") // Draft | Approved | InProgress | Completed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  WorkPlanItem[]

  @@index([tenantId, ownerUserId, weekStartDate])
  @@map("work_plans")
  @@schema("public")
}

model WorkPlanItem {
  id         String  @id @default(cuid())
  workPlanId String
  dayOffset  Int // 0..6 within weekStartDate
  activity   String
  target     String?
  status     String  @default("Planned") // Planned | Done | Skipped
  sortOrder  Int     @default(0)

  workPlan WorkPlan @relation(fields: [workPlanId], references: [id], onDelete: Cascade)

  @@index([workPlanId])
  @@map("work_plan_items")
  @@schema("public")
}

model DailyWorksheet {
  id           String   @id @default(cuid())
  tenantId     String
  ownerUserId  String
  employeeId   String?
  postingDate  DateTime @db.Date
  visitCount   Int      @default(0)
  callsMade    Int      @default(0)
  quotesGiven  Int      @default(0)
  ordersBooked Int      @default(0)
  amountBooked Decimal  @default(0) @db.Decimal(18, 4)
  distanceKm   Decimal? @db.Decimal(9, 2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ownerUserId, postingDate])
  @@index([tenantId, postingDate])
  @@map("daily_worksheets")
  @@schema("public")
}

model CrmProcess {
  id            String    @id @default(cuid())
  tenantId      String
  processName   String
  category      String? // Onboarding | Renewal | Escalation | Custom
  ownerUserId   String?
  currentStep   String?
  status        String    @default("Active") // Active | OnHold | Completed | Cancelled
  slaTargetDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category, status])
  @@map("crm_processes")
  @@schema("public")
}

// ---------- CRM: Project Planning (ODR-style) ----------

model ProjectPlanning {
  id           String    @id @default(cuid())
  tenantId     String
  projectName  String
  customerId   String?
  ownerUserId  String?
  startDate    DateTime? @db.Date
  targetDate   DateTime? @db.Date
  budgetAmount Decimal?  @db.Decimal(18, 4)
  currentStage String? // Enquiry | Proposal | Approved | InExecution | Handover | Closed
  progressPct  Decimal   @default(0) @db.Decimal(5, 2)
  status       String    @default("Open") // Open | OnHold | Completed | Cancelled
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer? @relation("ProjectPlanningCustomer", fields: [customerId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("project_plannings")
  @@schema("public")
}

// ---------- Manufacturing: Material Movements ----------
//
// StockEntry is the generic Receipt/Issue/Transfer catch-all; the reports
// spec calls for named-and-typed variants. These entities cross-reference a
// StockEntry (nullable) so both models can coexist during the transition.

model MaterialIssue {
  id                String   @id @default(cuid())
  tenantId          String
  issueNo           String // MI-####
  postingDate       DateTime @db.Date
  sourceWarehouseId String?
  purpose           String? // Consumption | Production | Sample | Damage
  requestedBy       String?
  issuedBy          String?
  status            String   @default("Draft") // Draft | Submitted | Cancelled
  stockEntryId      String?
  totalQty          Decimal  @default(0) @db.Decimal(18, 4)
  totalValue        Decimal  @default(0) @db.Decimal(18, 4)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceWarehouse Warehouse?          @relation("MaterialIssueSource", fields: [sourceWarehouseId], references: [id])
  items           MaterialIssueItem[]

  @@unique([tenantId, issueNo])
  @@index([tenantId, postingDate])
  @@index([tenantId, status])
  @@map("material_issues")
  @@schema("public")
}

model MaterialIssueItem {
  id              String  @id @default(cuid())
  materialIssueId String
  itemId          String
  qty             Decimal @db.Decimal(18, 4)
  rate            Decimal @default(0) @db.Decimal(18, 4)
  amount          Decimal @default(0) @db.Decimal(18, 4)
  batchNo         String?
  serialNo        String?

  materialIssue MaterialIssue @relation(fields: [materialIssueId], references: [id], onDelete: Cascade)
  item          Item          @relation("MaterialIssueItemItem", fields: [itemId], references: [id])

  @@index([materialIssueId])
  @@map("material_issue_items")
  @@schema("public")
}

model MaterialTransfer {
  id                String   @id @default(cuid())
  tenantId          String
  transferNo        String // MT-####
  postingDate       DateTime @db.Date
  sourceWarehouseId String?
  targetWarehouseId String?
  requestedBy       String?
  transferredBy     String?
  status            String   @default("Draft") // Draft | InTransit | Received | Cancelled
  stockEntryId      String?
  totalQty          Decimal  @default(0) @db.Decimal(18, 4)
  totalValue        Decimal  @default(0) @db.Decimal(18, 4)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceWarehouse Warehouse?             @relation("MaterialTransferSource", fields: [sourceWarehouseId], references: [id])
  targetWarehouse Warehouse?             @relation("MaterialTransferTarget", fields: [targetWarehouseId], references: [id])
  items           MaterialTransferItem[]

  @@unique([tenantId, transferNo])
  @@index([tenantId, postingDate])
  @@index([tenantId, status])
  @@map("material_transfers")
  @@schema("public")
}

model MaterialTransferItem {
  id                 String  @id @default(cuid())
  materialTransferId String
  itemId             String
  qty                Decimal @db.Decimal(18, 4)
  rate               Decimal @default(0) @db.Decimal(18, 4)
  amount             Decimal @default(0) @db.Decimal(18, 4)
  batchNo            String?

  materialTransfer MaterialTransfer @relation(fields: [materialTransferId], references: [id], onDelete: Cascade)
  item             Item             @relation("MaterialTransferItemItem", fields: [itemId], references: [id])

  @@index([materialTransferId])
  @@map("material_transfer_items")
  @@schema("public")
}

model MaterialReturn {
  id             String   @id @default(cuid())
  tenantId       String
  returnNo       String // MR-####
  postingDate    DateTime @db.Date
  returnType     String // ToSupplier | ToWarehouse
  againstDoctype String? // PurchaseOrder | PurchaseReceipt | MaterialIssue
  againstDocId   String?
  supplierId     String?
  warehouseId    String?
  reason         String?
  status         String   @default("Draft") // Draft | Submitted | Cancelled
  stockEntryId   String?
  totalQty       Decimal  @default(0) @db.Decimal(18, 4)
  totalValue     Decimal  @default(0) @db.Decimal(18, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier?            @relation("MaterialReturnSupplier", fields: [supplierId], references: [id])
  warehouse Warehouse?           @relation("MaterialReturnWarehouse", fields: [warehouseId], references: [id])
  items     MaterialReturnItem[]

  @@unique([tenantId, returnNo])
  @@index([tenantId, postingDate])
  @@index([tenantId, returnType])
  @@map("material_returns")
  @@schema("public")
}

model MaterialReturnItem {
  id               String  @id @default(cuid())
  materialReturnId String
  itemId           String
  qty              Decimal @db.Decimal(18, 4)
  rate             Decimal @default(0) @db.Decimal(18, 4)
  amount           Decimal @default(0) @db.Decimal(18, 4)

  materialReturn MaterialReturn @relation(fields: [materialReturnId], references: [id], onDelete: Cascade)
  item           Item           @relation("MaterialReturnItemItem", fields: [itemId], references: [id])

  @@index([materialReturnId])
  @@map("material_return_items")
  @@schema("public")
}

// ---------- Manufacturing: Weighment (truck weighbridge) ----------

model Weighment {
  id            String   @id @default(cuid())
  tenantId      String
  weighmentNo   String // WB-####
  postingDate   DateTime @db.Date
  vehicleNo     String
  driverName    String?
  transporter   String?
  itemId        String?
  supplierId    String?
  customerId    String?
  weighmentType String // Inward | Outward
  grossWeight   Decimal  @db.Decimal(12, 3) // kg
  tareWeight    Decimal  @db.Decimal(12, 3) // kg
  netWeight     Decimal  @db.Decimal(12, 3) // kg
  moisturePct   Decimal? @db.Decimal(5, 2)
  quality       String?
  rate          Decimal? @db.Decimal(18, 4)
  amount        Decimal? @db.Decimal(18, 4)
  status        String   @default("Weighed") // Weighed | Verified | Billed | Cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item     Item?               @relation("WeighmentItem", fields: [itemId], references: [id])
  supplier Supplier?           @relation("WeighmentSupplier", fields: [supplierId], references: [id])
  customer Customer?           @relation("WeighmentCustomer", fields: [customerId], references: [id])
  ionNotes InwardOutwardNote[] @relation("IONWeighment")

  @@unique([tenantId, weighmentNo])
  @@index([tenantId, postingDate])
  @@index([tenantId, weighmentType])
  @@map("weighments")
  @@schema("public")
}

model InwardOutwardNote {
  id          String   @id @default(cuid())
  tenantId    String
  noteNo      String // ION-####
  postingDate DateTime @db.Date
  noteType    String // Inward | Outward
  vehicleNo   String?
  weighmentId String?
  refDoctype  String? // PurchaseReceipt | DeliveryNote | MaterialTransfer
  refDocId    String?
  driverName  String?
  purpose     String?
  gatePassNo  String?
  status      String   @default("Open") // Open | Closed | Cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  weighment Weighment? @relation("IONWeighment", fields: [weighmentId], references: [id])

  @@unique([tenantId, noteNo])
  @@index([tenantId, postingDate])
  @@index([tenantId, noteType])
  @@map("inward_outward_notes")
  @@schema("public")
}

// ---------- Manufacturing: Sales Enquiry ----------
//
// Pre-quotation stage. Similar to Lead but item-focused (specific goods
// enquiry from a specific customer/prospect).

model SalesEnquiry {
  id              String    @id @default(cuid())
  tenantId        String
  enquiryNo       String // ENQ-####
  enquiryDate     DateTime  @db.Date
  customerId      String?
  leadId          String?
  distributorId   String? // when routed via a distributor
  channel         String? // Direct | Distributor | Website | Referral
  source          String?
  ownerUserId     String?
  itemDescription String?
  totalQty        Decimal?  @db.Decimal(18, 4)
  status          String    @default("Open") // Open | Quoted | Won | Lost | Closed
  followUpDate    DateTime? @db.Date
  closingReason   String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer?          @relation("SalesEnquiryCustomer", fields: [customerId], references: [id])
  lead        Lead?              @relation("SalesEnquiryLead", fields: [leadId], references: [id])
  distributor Customer?          @relation("SalesEnquiryDistributor", fields: [distributorId], references: [id])
  items       SalesEnquiryItem[]

  @@unique([tenantId, enquiryNo])
  @@index([tenantId, enquiryDate])
  @@index([tenantId, status])
  @@index([tenantId, ownerUserId])
  @@map("sales_enquiries")
  @@schema("public")
}

model SalesEnquiryItem {
  id              String   @id @default(cuid())
  salesEnquiryId  String
  itemId          String?
  itemDescription String
  qty             Decimal  @db.Decimal(18, 4)
  targetRate      Decimal? @db.Decimal(18, 4)
  targetAmount    Decimal? @db.Decimal(18, 4)

  salesEnquiry SalesEnquiry @relation(fields: [salesEnquiryId], references: [id], onDelete: Cascade)
  item         Item?        @relation("SalesEnquiryItemItem", fields: [itemId], references: [id])

  @@index([salesEnquiryId])
  @@map("sales_enquiry_items")
  @@schema("public")
}

// ---------- Manufacturing: MRP / ItemSitePlanning / Routing ----------

model MrpRun {
  id               String   @id @default(cuid())
  tenantId         String
  runNo            String // MRP-####
  runDate          DateTime @db.Date
  horizonDays      Int      @default(30)
  scope            String? // AllItems | SiteScope | ItemGroup
  siteFilter       String?
  status           String   @default("Draft") // Draft | Running | Completed | Failed
  triggeredBy      String?
  suggestionsCount Int      @default(0)
  errorMessage     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  suggestions MrpSuggestion[]

  @@unique([tenantId, runNo])
  @@index([tenantId, runDate])
  @@map("mrp_runs")
  @@schema("public")
}

model MrpSuggestion {
  id           String    @id @default(cuid())
  mrpRunId     String
  itemId       String
  warehouseId  String?
  requiredQty  Decimal   @db.Decimal(18, 4)
  onHandQty    Decimal   @default(0) @db.Decimal(18, 4)
  suggestedQty Decimal   @db.Decimal(18, 4)
  actionType   String // Manufacture | Purchase | Transfer
  requiredBy   DateTime? @db.Date
  status       String    @default("Suggested") // Suggested | Acted | Ignored

  mrpRun MrpRun @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  item   Item   @relation("MrpSuggestionItem", fields: [itemId], references: [id])

  @@index([mrpRunId])
  @@index([itemId])
  @@map("mrp_suggestions")
  @@schema("public")
}

model ItemSitePlanning {
  id           String   @id @default(cuid())
  tenantId     String
  itemId       String
  warehouseId  String
  reorderLevel Decimal  @default(0) @db.Decimal(18, 4)
  reorderQty   Decimal  @default(0) @db.Decimal(18, 4)
  maxLevel     Decimal? @db.Decimal(18, 4)
  safetyStock  Decimal? @db.Decimal(18, 4)
  leadTimeDays Int?
  supplierId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      Item      @relation("ItemSitePlanningItem", fields: [itemId], references: [id])
  warehouse Warehouse @relation("ItemSitePlanningWarehouse", fields: [warehouseId], references: [id])
  supplier  Supplier? @relation("ItemSitePlanningSupplier", fields: [supplierId], references: [id])

  @@unique([tenantId, itemId, warehouseId])
  @@index([tenantId, itemId])
  @@map("item_site_plannings")
  @@schema("public")
}

model RoutingMaster {
  id          String   @id @default(cuid())
  tenantId    String
  routingName String
  itemId      String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item       Item?              @relation("RoutingItem", fields: [itemId], references: [id])
  operations RoutingOperation[]

  @@unique([tenantId, routingName])
  @@map("routing_masters")
  @@schema("public")
}

model RoutingOperation {
  id            String   @id @default(cuid())
  routingId     String
  sortOrder     Int      @default(0)
  operationName String
  workstationId String?
  timeInMins    Decimal  @default(0) @db.Decimal(10, 2)
  setupTimeMins Decimal? @db.Decimal(10, 2)
  scrapPct      Decimal? @db.Decimal(5, 2)
  notes         String?

  routing     RoutingMaster @relation(fields: [routingId], references: [id], onDelete: Cascade)
  workstation Workstation?  @relation("RoutingOpWorkstation", fields: [workstationId], references: [id])

  @@index([routingId])
  @@map("routing_operations")
  @@schema("public")
}

// ---------- Manufacturing: Plant Maintenance ----------

model MaintenanceRequest {
  id            String    @id @default(cuid())
  tenantId      String
  requestNo     String // MR-####
  requestDate   DateTime  @db.Date
  machineName   String // free-text or Workstation.name
  workstationId String?
  requesterName String?
  priority      String    @default("Medium") // Low | Medium | High | Critical
  requestType   String // Breakdown | Preventive | Predictive | Improvement
  description   String
  status        String    @default("Open") // Open | Acknowledged | InProgress | Completed | Cancelled
  assignedTo    String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workstation Workstation?        @relation("MaintenanceRequestWorkstation", fields: [workstationId], references: [id])
  actions     MaintenanceAction[]

  @@unique([tenantId, requestNo])
  @@index([tenantId, requestDate])
  @@index([tenantId, priority, status])
  @@map("maintenance_requests")
  @@schema("public")
}

model MaintenanceSchedule {
  id            String    @id @default(cuid())
  tenantId      String
  scheduleName  String
  workstationId String?
  machineName   String?
  intervalDays  Int       @default(30)
  nextDueDate   DateTime  @db.Date
  lastDoneDate  DateTime? @db.Date
  scheduleType  String    @default("Preventive") // Preventive | Calibration | Inspection
  status        String    @default("Active") // Active | Paused | Discontinued
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workstation Workstation? @relation("MaintenanceScheduleWorkstation", fields: [workstationId], references: [id])

  @@index([tenantId, nextDueDate])
  @@index([tenantId, status])
  @@map("maintenance_schedules")
  @@schema("public")
}

model MachineLogger {
  id            String   @id @default(cuid())
  tenantId      String
  workstationId String?
  machineName   String
  loggedAt      DateTime
  loggedBy      String?
  eventType     String // Startup | Shutdown | Alarm | ProductionRate | Maintenance | Idle
  parameter     String? // e.g. Temperature | Pressure | Speed
  value         Decimal? @db.Decimal(18, 4)
  unit          String? // e.g. °C | bar | rpm
  isAlarm       Boolean  @default(false)
  severity      String? // Info | Warning | Critical
  notes         String?
  createdAt     DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workstation Workstation? @relation("MachineLoggerWorkstation", fields: [workstationId], references: [id])

  @@index([tenantId, workstationId, loggedAt])
  @@index([tenantId, isAlarm, severity])
  @@map("machine_loggers")
  @@schema("public")
}

model MaintenanceAction {
  id            String   @id @default(cuid())
  tenantId      String
  requestId     String?
  actionDate    DateTime @db.Date
  actionType    String // Inspect | Replace | Repair | Adjust | Lubricate
  performedBy   String?
  timeSpentMins Int?
  partsUsed     String?
  costAmount    Decimal? @db.Decimal(18, 4)
  notes         String?
  createdAt     DateTime @default(now())

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request MaintenanceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([tenantId, actionDate])
  @@index([tenantId, requestId])
  @@map("maintenance_actions")
  @@schema("public")
}

// ---------- P3 · Finance additions ----------
//
// BankGuarantee + LetterOfCredit — trade-finance instruments the reports
// spec calls out ("LC And BG · Bank Guarantee Tracking"). Kept compact.

model BankGuarantee {
  id               String   @id @default(cuid())
  tenantId         String
  bgNumber         String // bank-issued reference
  bankName         String
  bgType           String // Performance | Financial | Bid | Advance
  beneficiaryName  String?
  issueDate        DateTime @db.Date
  expiryDate       DateTime @db.Date
  amount           Decimal  @db.Decimal(18, 4)
  currency         String   @default("INR")
  marginPct        Decimal? @db.Decimal(5, 2)
  commissionAmount Decimal? @db.Decimal(18, 4)
  purpose          String?
  status           String   @default("Active") // Active | Extended | Cancelled | Expired | Invoked
  linkedProject    String?
  supplierId       String?
  customerId       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation("BGSupplier", fields: [supplierId], references: [id])
  customer Customer? @relation("BGCustomer", fields: [customerId], references: [id])

  @@unique([tenantId, bgNumber])
  @@index([tenantId, expiryDate])
  @@index([tenantId, status])
  @@map("bank_guarantees")
  @@schema("public")
}

// ---------- P6 · Payroll additions ----------
//
// India-flavoured payroll adds 20+ statutory + operational entities. Each
// stays compact — one row per (employee, period, doctype) with the fields
// the corresponding report needs. Full computation logic (rules engine,
// slab tables, formulas) can be added incrementally on top.

model Form12BB {
  id               String    @id @default(cuid())
  tenantId         String
  employeeId       String
  fiscalYearId     String?
  submittedDate    DateTime? @db.Date
  hraLandlordName  String?
  hraAmount        Decimal?  @db.Decimal(18, 2)
  ltaAmount        Decimal?  @db.Decimal(18, 2)
  homeLoanInterest Decimal?  @db.Decimal(18, 2)
  section80CTotal  Decimal?  @db.Decimal(18, 2)
  section80DTotal  Decimal?  @db.Decimal(18, 2)
  section80GTotal  Decimal?  @db.Decimal(18, 2)
  otherDeductions  Decimal?  @db.Decimal(18, 2)
  totalClaimed     Decimal?  @db.Decimal(18, 2)
  status           String    @default("Draft") // Draft | Submitted | Verified | Rejected
  verifiedBy       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, fiscalYearId])
  @@index([tenantId, status])
  @@map("form_12bb")
  @@schema("public")
}

model Saving {
  id             String    @id @default(cuid())
  tenantId       String
  employeeId     String
  savingType     String // PPF | ELSS | LIC | NSC | Bank FD | Others | Internal
  isInternal     Boolean   @default(false)
  section        String? // 80C | 80D | 80G | 80E | Other
  investmentDate DateTime  @db.Date
  amount         Decimal   @db.Decimal(18, 2)
  provider       String?
  policyNumber   String?
