model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String
  fullName     String
  // Legacy free-form role kept for backward compat; real access-control now
  // lives in UserRole → Role → RolePermission. "admin" auto-maps to
  // SystemManager, which is granted every permission by seedTenantRoles.
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // TOTP 2FA. `totpSecret` is the base32 shared secret (populated at enroll,
  // *not* verified). `totpEnabledAt` gates whether login requires the second
  // step — set only after the user proves possession with a valid code.
  totpSecret      String?
  totpEnabledAt   DateTime?
  // Email verification. New signups start unverified; login is still allowed
  // (soft-verify for now) but the UI shows a banner until verified.
  emailVerifiedAt DateTime?
  // Super admin can manage subscription plans + assign plans to any tenant.
  // Not scoped by tenantId — a super-admin User in Tenant X can still
  // administer Tenant Y's subscription. Guard this with care.
  isSuperAdmin    Boolean   @default(false)
  // Any JWT/session issued with `iat < tokenEpoch` is rejected by requireAuth.
  // Bumped on password change / password reset / admin-forced re-auth so a
  // compromised token stops working the instant the user rotates credentials.
  tokenEpoch      DateTime  @default(now())
  // Account-level brute-force lockout. `failedLoginAttempts` counts
  // consecutive failures since the last successful login (or unlock). When it
  // hits LOGIN_LOCKOUT_THRESHOLD, `lockedUntil` is stamped LOGIN_LOCKOUT_MS in
  // the future — /auth/login refuses until now() > lockedUntil, regardless of
  // rate-limit state. Belt-and-braces on top of per-IP rate limiting: a
  // botnet-distributed guess (many IPs, one email) is caught here even
  // though each IP is under the per-IP limit.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // SCIM 2.0 provisioning. `active=false` is the SCIM-standard way to
  // deactivate without deleting; blocks login + hides from most queries.
  // `externalId` is the identity provider's own id for this user — enables
  // bi-directional sync (e.g. Okta → us → Okta without id collisions).
  // `deactivatedAt` records when `active` was last flipped to false.
  active        Boolean   @default(true)
  externalId    String?
  deactivatedAt DateTime?

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles               UserRole[]
  apiTokens               ApiToken[]
  totpBackupCodes         TotpBackupCode[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sessions                UserSession[]
  oauthAuthCodes          OAuthAuthCode[]
  oauthAccessTokens       OAuthAccessToken[]
  oauthConsents           OAuthConsent[]
  posOpeningEntries       POSOpeningEntry[]        @relation("POSOpeningUser")
  posClosingEntries       POSClosingEntry[]        @relation("POSClosingUser")
  companyAccess           UserCompanyAccess[]
  aiInboxPreferences      AiInboxPreference?

  @@unique([tenantId, email])
  @@map("users")
  @@schema("public")
}

// Multi-company Phase 6: per-user company allowlist.
//
// Semantics (matches the role-based default the tenant picked):
//   * If the user's role is SystemManager (legacy `role="admin"` maps to
//     this), all companies visible — the rows on this table are ignored
//     for admins.
//   * Otherwise: user sees ONLY the companies with a matching row. Zero
//     rows = user sees nothing.
//   * Backwards compat: a one-shot backfill grandfathers every existing
//     non-admin user by writing one row per (user, company) pair, so
//     nobody loses access on migration. New non-admin users start with
//     zero rows (deny-by-default) and an admin must add access.
//
// The middleware (packages/service-auth/src/company-access.ts) loads
// `allowedCompanyIds` for each request; route handlers use it to filter
// GLEntry aggregations, `/companies` responses, and IC JE creation.
model UserCompanyAccess {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  companyId String
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([tenantId, userId])
  @@map("user_company_access")
  @@schema("public")
}

// Session tracking for JWTs. Every /auth/login (and /auth/2fa/challenge)
// registers one row. `jti` (JWT ID) is stamped into the token so requireAuth
// can look up the session on each request and refuse revoked ones. This adds
// one DB lookup per JWT auth — acceptable for now; caching is a scale-time
// concern.
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  jti          String    @unique
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jti])
  @@map("user_sessions")
  @@schema("public")
}

// Password reset token — one-shot, 1h TTL. Only the sha256 hash is stored;
// the raw token is delivered to the user (via email in prod, returned in the
// dev response body for now — see MailService deferred item).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
  @@schema("public")
}

// One-time signup email-verification token. Delivered via email; user clicks
// the link to activate. Same shape as reset token but different semantics —
// separate model keeps the state machine tidy.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
  @@schema("public")
}

// One-shot backup codes users can redeem instead of a TOTP code when they
// lose their device. 10 codes generated at enrollment (shown once), each is
// invalidated on use.
model TotpBackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String // sha256 of raw code
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("totp_backup_codes")
  @@schema("public")
}

// Fine-grained access control (ERPNext-style Role + Role Permission Manager).
// Roles are tenant-scoped so tenants can add custom roles later without
// clashing with other tenants.
model Role {
  id        String   @id @default(cuid())
  tenantId  String
  roleName  String
  // Non-editable seeded roles (SystemManager, SalesUser, etc.); custom roles
  // added by tenant admins have isSystem = false.
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, roleName])
  @@map("roles")
  @@schema("public")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
  @@schema("public")
}

// One row per (role, doctype, action). Action is a coarse verb — read/write/
// create/delete/submit/cancel. If a user has ANY role that grants a permission,
// they're authorised. No "if_owner" / party-permission granularity in v1.
model RolePermission {
  id       String @id @default(cuid())
  tenantId String
  roleId   String
  doctype  String
  action   String // read | write | create | delete | submit | cancel

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, doctype, action])
  @@index([tenantId, doctype])
  @@map("role_permissions")
  @@schema("public")
}

// ---------- Workflow ----------
//
// ERPNext-style: a Workflow attaches to a doctype and defines a state machine
// over the doctype's `status` field. When active, the workflow's transition
// buttons render on the doctype's detail page and let allowed users move the
// doc between arbitrary states (e.g. Draft → Pending Approval → Approved →
// Submitted). At most one active workflow per (tenant, doctype).

model Workflow {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  doctype     String
  isActive    Boolean  @default(false)
  // Which column on the target doctype holds the workflow state. Every
  // workflow-eligible doctype uses "status" — the field is kept explicit here
  // for future flexibility (e.g. a custom workflow_state field).
  statusField String   @default("status")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  states      WorkflowState[]
  transitions WorkflowTransition[]

  @@unique([tenantId, name])
  @@index([tenantId, doctype, isActive])
  @@map("workflows")
  @@schema("public")
}

model WorkflowState {
  id         String  @id @default(cuid())
  workflowId String
  stateName  String
  // Mirrors ERPNext's docstatus: 0=Draft, 1=Submitted, 2=Cancelled. Optional
  // — informational only, we don't enforce it at the DB level.
  docStatus  Int     @default(0)
  // Tailwind badge classes for rendering the state pill (e.g. "bg-yellow-100 text-yellow-800").
  style      String?
  // Display order in the workflow editor and detail-page badge.
  sortOrder  Int     @default(0)

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stateName])
  @@map("workflow_states")
  @@schema("public")
}

model WorkflowTransition {
  id           String   @id @default(cuid())
  workflowId   String
  fromState    String
  actionLabel  String // Button text shown to the user (e.g. "Approve", "Reject")
  toState      String
  // Role names (from Role.roleName) allowed to trigger this transition. If
  // empty, only SystemManager can. Stored as a Postgres String[] for cheap
  // whole-array reads.
  allowedRoles String[]

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, fromState])
  @@map("workflow_transitions")
  @@schema("public")
}

// ---------- Accounting: Masters ----------

// ---------- CRM: Contacts + Addresses (D1) ----------
// Polymorphic address + contact records. Each row is linked to at most one
// parent doctype via `linkedDoctype` + `linkedId` (Customer | Supplier | Lead).
// Simpler than ERPNext's separate DynamicLink table for the sizes we
// currently deal with; can normalize later if a row needs multi-link.

model Address {
  id            String   @id @default(cuid())
  tenantId      String
  linkedDoctype String // Customer | Supplier | Lead
  linkedId      String
  addressType   String   @default("Billing") // Billing | Shipping | Office | Other
  addressLine1  String
  addressLine2  String?
  city          String?
  state         String?
  country       String?
  pincode       String?
  phone         String?
  email         String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, linkedDoctype, linkedId])
  @@map("addresses")
  @@schema("public")
}

model Contact {
  id            String   @id @default(cuid())
  tenantId      String
  linkedDoctype String // Customer | Supplier | Lead
  linkedId      String
  firstName     String
  lastName      String?
  designation   String?
  email         String?
  mobile        String?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, linkedDoctype, linkedId])
  @@map("contacts")
  @@schema("public")
}

// ---------- Pricing: Pricing Rule (D3) ----------
// Conditional rate override / discount. Matches by any combination of
// (item, customer, customerGroup, territory) + qty range + validity window.
// SI/PI/Quote/SO forms call /pricing-rules/lookup on item pick and, if a
// rule matches, apply the discount or price override to the line rate.
//
// Precedence when multiple rules match: highest `priority` wins; ties
// broken by narrower scope (item-specific > group > territory > catch-all).

model PricingRule {
  id              String    @id @default(cuid())
  tenantId        String
  title           String // human-readable name for admin UI
  applyOn         String    @default("Selling") // Selling | Buying
  // Filters — any combination. NULL = "any".
  itemId          String?
  customerId      String?
  customerGroupId String?
  territoryId     String?
  minQty          Decimal   @default(0) @db.Decimal(18, 4)
  maxQty          Decimal?  @db.Decimal(18, 4)
  // Effect: either an absolute price override or a discount %.
  ruleType        String    @default("Discount %") // Discount % | Rate
  discountPercent Decimal   @default(0) @db.Decimal(9, 4)
  ratePrice       Decimal   @default(0) @db.Decimal(18, 4)
  priority        Int       @default(0)
  validFrom       DateTime?
  validUpto       DateTime?
  disabled        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coupons CouponCode[] @relation("CouponRule")

  @@index([tenantId, applyOn, disabled])
  @@index([tenantId, itemId])
  @@index([tenantId, customerId])
  @@map("pricing_rules")
  @@schema("public")
}

// ---------- Sales: Subscription (D11) ----------
// Recurring SI generator. Materializes a Draft SalesInvoice on each due
// date; user submits it (or a cron can auto-submit later).

model Subscription {
  id                 String    @id @default(cuid())
  tenantId           String
  name               String // SUB-0001
  customerId         String
  frequency          String    @default("Monthly") // Weekly | Monthly | Quarterly | Yearly
  startDate          DateTime
  endDate            DateTime?
  nextGenerationDate DateTime
  currency           String    @default("INR")
  taxTemplateId      String?
  autoSubmit         Boolean   @default(false)
  status             String    @default("Active") // Active | Paused | Completed | Cancelled
  remarks            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer           @relation("SubscriptionCustomer", fields: [customerId], references: [id])
  items    SubscriptionItem[]

  @@unique([tenantId, name])
  @@index([tenantId, status, nextGenerationDate])
  @@map("subscriptions")
  @@schema("public")
}

model SubscriptionItem {
  id             String  @id @default(cuid())
  subscriptionId String
  itemId         String
  qty            Decimal @db.Decimal(18, 4)
  rate           Decimal @db.Decimal(18, 4)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  item         Item         @relation("SubscriptionItemItem", fields: [itemId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_items")
  @@schema("public")
}

// ---------- Payments: Payment Terms Template (D10) ----------
// Named schedule of due-date fractions (e.g. "50% net-30 / 50% net-60").
// SI/PI can attach a template and materialize a per-invoice payment
// schedule (deferred: current version only ships schema + CRUD).

model PaymentTermsTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms            PaymentTermsTemplateItem[]
  salesInvoices    SalesInvoice[]             @relation("SIPaymentTerms")
  purchaseInvoices PurchaseInvoice[]          @relation("PIPaymentTerms")
  supplierDefaults Supplier[]                 @relation("SupplierDefaultPaymentTerms")
  customerDefaults Customer[]                 @relation("CustomerDefaultPaymentTerms")

  @@unique([tenantId, name])
  @@index([tenantId, enabled])
  @@map("payment_terms_templates")
  @@schema("public")
}

model PaymentTermsTemplateItem {
  id             String  @id @default(cuid())
  templateId     String
  description    String
  invoicePortion Decimal @db.Decimal(5, 2) // percent 0..100
  dueDays        Int // days after invoice postingDate
  sortOrder      Int     @default(0)

  template PaymentTermsTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("payment_terms_template_items")
  @@schema("public")
}

// D10: materialized payment schedule for a single invoice. Written at SI/PI
// submit when the invoice has a paymentTermsTemplateId. Exactly one of
// (salesInvoiceId, purchaseInvoiceId) is non-null. `paidAmount` allocation
// on PE apply is deferred — for now `status` derives from (dueDate vs today)
// + parent-invoice status (Paid parent → all rows Paid).
model InvoicePaymentSchedule {
  id                String   @id @default(cuid())
  tenantId          String
  salesInvoiceId    String?
  purchaseInvoiceId String?
  sortOrder         Int      @default(0)
  description       String
  invoicePortion    Decimal  @db.Decimal(5, 2)
  dueDate           DateTime @db.Date
  amount            Decimal  @db.Decimal(18, 4)
  paidAmount        Decimal  @default(0) @db.Decimal(18, 4)
  status            String   @default("Upcoming") // Upcoming | Overdue | Paid | Partial
  createdAt         DateTime @default(now())

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoice    SalesInvoice?     @relation("SIPaymentSchedule", fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  purchaseInvoice PurchaseInvoice?  @relation("PIPaymentSchedule", fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  reminders       PaymentReminder[] @relation("SchedulePaymentReminder")

  @@index([tenantId, salesInvoiceId, sortOrder])
  @@index([tenantId, purchaseInvoiceId, sortOrder])
  @@index([tenantId, dueDate, status])
  @@map("invoice_payment_schedules")
  @@schema("public")
}

// ---------- CRM: Campaign (D8) ----------
// Marketing initiative. Leads + Opportunities are attributed to a campaign
// so ROI reports can attribute revenue back to spend.

// Campaign — was a lightweight "marketing bucket" (name + budget + attribution
// only). Extended to a full Zoho-Campaigns-Plus-style email marketing entity:
// stores the message template (subject + HTML body + from address), tracking
// toggles, scheduled-send timestamp, and rolled-up delivery counters. The
// per-recipient detail lives in CampaignRecipient (below).
model Campaign {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  startDate       DateTime?
  endDate         DateTime?
  budget          Decimal   @default(0) @db.Decimal(18, 4)
  expectedRevenue Decimal   @default(0) @db.Decimal(18, 4)
  // status: legacy values (Planned|Active|Completed|Cancelled) still accepted.
  // Post-P1 preferred state machine: Draft|Scheduled|Sending|Paused|Sent|Cancelled.
  // Existing rows migrate lazily via UI actions; no data-fix migration needed.
  status          String    @default("Draft")

  // Email-campaign fields — nullable so existing campaigns without an email
  // component still work.
  channel         String    @default("Email") // Email | SMS | Multi
  subject         String?
  bodyHtml        String? // supports {{merge}} tags rendered at send
  fromEmail       String?
  fromName        String?
  replyTo         String?
  trackOpens      Boolean   @default(true)
  trackClicks     Boolean   @default(true)
  scheduledFor    DateTime? // null = send-now on POST /send
  sentAt          DateTime?
  // Rolled-up counters — updated by the send job + tracking pixels.
  totalRecipients Int       @default(0)
  totalSent       Int       @default(0)
  totalOpened     Int       @default(0)
  totalClicked    Int       @default(0)
  totalBounced    Int       @default(0)
  totalUnsubs     Int       @default(0)

  // P1 additions
  archiveEnabled  Boolean   @default(false) // when true, /a/:archiveSlug is public
  archiveSlug     String?   @unique // must be unique across all tenants (public URL space)
  rateLimitPerMin Int? // null = no throttle; otherwise sends/min ceiling
  testSentAt      DateTime? // last test-send timestamp

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leads          Lead[]              @relation("LeadCampaign")
  opportunities  Opportunity[]       @relation("OpportunityCampaign")
  recipients     CampaignRecipient[]
  listLinks      CampaignListLink[]
  suppressions   Suppression[]
  trackingEvents TrackingEvent[]
  variants       CampaignVariant[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, scheduledFor])
  @@map("campaigns")
  @@schema("public")
}

// One row per intended recipient of a campaign. Carries a unique trackingId
// used in the tracking-pixel URL + click-redirect URLs so we can attribute
// opens/clicks back to (recipient, campaign).
model CampaignRecipient {
  id           String    @id @default(cuid())
  tenantId     String
  campaignId   String
  variantId    String? // P2: set when campaign has CampaignVariant[]; null = no A/B
  contactType  String // Customer | Lead
  contactId    String
  emailTo      String
  trackingId   String    @unique @default(cuid())
  status       String    @default("Pending") // Pending | Sent | Failed | Bounced | Unsubscribed | Suppressed
  sentAt       DateTime?
  openedAt     DateTime? // first open — subsequent opens bump openCount
  openCount    Int       @default(0)
  clickedAt    DateTime? // first click
  clickCount   Int       @default(0)
  bouncedAt    DateTime?
  bounceReason String?

  campaign       Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  variant        CampaignVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trackingEvents TrackingEvent[]

  @@unique([campaignId, contactType, contactId])
  @@index([tenantId, campaignId, status])
  @@index([trackingId])
  @@map("campaign_recipients")
  @@schema("public")
}

// ContactList — a segment of Customers/Leads. Can be static (manual add) or
// dynamic (resolved from a filter each send). Filter format:
//   { doctype: "Customer" | "Lead", where: <Prisma-where JSON> }
model ContactList {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isDynamic   Boolean  @default(false)
  filterJson  Json? // required when isDynamic = true
  memberCount Int      @default(0) // materialised counter for static lists
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members   ContactListMember[]
  campaigns CampaignListLink[]
  sequences EmailSequence[]     @relation("SequenceTriggerList")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("contact_lists")
  @@schema("public")
}

model ContactListMember {
  id          String   @id @default(cuid())
  listId      String
  contactType String // Customer | Lead
  contactId   String
  addedAt     DateTime @default(now())

  list ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, contactType, contactId])
  @@index([listId])
  @@map("contact_list_members")
  @@schema("public")
}

model CampaignListLink {
  campaignId String
  listId     String

  campaign Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  list     ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([campaignId, listId])
  @@map("campaign_list_links")
  @@schema("public")
}

// EmailSequence — a drip campaign. Steps fire N days apart per enrollment.
// Triggered manually (POST /enroll) or automatically on list-add or new-lead.
model EmailSequence {
  id             String  @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  triggerType    String  @default("Manual") // Manual | OnListAdd | OnLeadCreated
  triggerListId  String?
  isActive       Boolean @default(false)
  totalEnrolled  Int     @default(0)
  totalCompleted Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  triggerList ContactList?         @relation("SequenceTriggerList", fields: [triggerListId], references: [id])
  steps       EmailSequenceStep[]
  enrollments SequenceEnrollment[]

  @@unique([tenantId, name])
  @@map("email_sequences")
  @@schema("public")
}

model EmailSequenceStep {
  id         String @id @default(cuid())
  sequenceId String
  stepOrder  Int // 0-indexed
  delayDays  Int    @default(1) // days after previous step (0 for first)
  subject    String
  bodyHtml   String

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, stepOrder])
  @@map("email_sequence_steps")
  @@schema("public")
}

model SequenceEnrollment {
  id          String   @id @default(cuid())
  tenantId    String
  sequenceId  String
  contactType String // Customer | Lead
  contactId   String
  emailTo     String
  currentStep Int      @default(0) // next step to send
  status      String   @default("Active") // Active | Completed | Paused | Unsubscribed
  enrolledAt  DateTime @default(now())
  nextSendAt  DateTime // when scheduler should fire the next step

  sequence EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, contactType, contactId])
  @@index([tenantId, status, nextSendAt])
  @@map("sequence_enrollments")
  @@schema("public")
}

// ---------- SalesIQ: live chat + visitor tracking ----------
//
// Every anonymous website visitor becomes a SiqVisitor keyed by a
// tenant-scoped fingerprint (a hash the widget generates from user-agent +
// screen + timezone + a UUID stored in localStorage). Page views append to
// SiqPageView. When the visitor opens a chat, one SiqChatSession is created
// and each turn appends a SiqChatMessage. The `linkedLeadId` field converts
// the visitor to a CRM Lead when an operator does so from the chat panel.

model SiqVisitor {
  id           String   @id @default(cuid())
  tenantId     String
  fingerprint  String // browser fingerprint (widget-computed)
  displayName  String? // "Anonymous #4231" — auto-assigned on first sight
  email        String? // if the visitor identified themselves via a form
  phone        String?
  ipAddress    String?
  userAgent    String?
  country      String?
  city         String?
  referrer     String? // where they landed from
  currentUrl   String? // last page they were on
  pageCount    Int      @default(0)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  status       String   @default("Active") // Active | Idle | Away | Chatting
  linkedLeadId String?

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pageViews    SiqPageView[]
  chatSessions SiqChatSession[]

  @@unique([tenantId, fingerprint])
  @@index([tenantId, status, lastSeenAt])
  @@map("siq_visitors")
  @@schema("public")
}

model SiqPageView {
  id        String   @id @default(cuid())
  visitorId String
  url       String
  title     String?
  referrer  String?
  createdAt DateTime @default(now())

  visitor SiqVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId, createdAt])
  @@map("siq_page_views")
  @@schema("public")
}

model SiqChatSession {
  id                String    @id @default(cuid())
  tenantId          String
  visitorId         String
  operatorUserId    String? // null until an operator picks it up
  status            String    @default("Open") // Open | Assigned | Closed | Bot
  subject           String? // first message or bot-flow topic
  startedAt         DateTime  @default(now())
  closedAt          DateTime?
  unreadForOperator Int       @default(0)
  unreadForVisitor  Int       @default(0)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitor  SiqVisitor       @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  messages SiqChatMessage[]

  @@index([tenantId, status, startedAt])
  @@map("siq_chat_sessions")
  @@schema("public")
}

model SiqChatMessage {
  id           String   @id @default(cuid())
  sessionId    String
  sender       String // Visitor | Operator | Bot | System
  senderUserId String? // set for Operator messages
  senderName   String?
  body         String
  createdAt    DateTime @default(now())

  session SiqChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("siq_chat_messages")
  @@schema("public")
}

// Per-tenant widget appearance + bot flow. One row per tenant (soft
// singleton — enforced by unique tenantId).
model SiqWidgetSettings {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  brandName      String   @default("Support")
  greeting       String   @default("Hi! How can we help?")
  primaryColor   String   @default("#7C3AED")
  position       String   @default("bottom-right") // bottom-right | bottom-left
  botEnabled     Boolean  @default(true)
  botFlowJson    Json? // simple canned-question tree
  offlineMessage String   @default("We're offline. Leave a message and we'll email you.")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("siq_widget_settings")
  @@schema("public")
}

// ---------- Desk: Full-featured helpdesk ----------
//
// Zoho-Desk-style ticket system. Sits alongside PortalTicket (which is the
// customer-facing complaint form) — a DeskTicket can be created directly by
// an agent OR mirrored from a PortalTicket (`portalTicketId`).
//
// Lifecycle: New → Open → InProgress → OnHold → Resolved → Closed. SLA
// timers start on create, freeze on OnHold, resolve on Resolved. Assignment
// happens via AssignmentRule (round-robin / load-balanced) at create time OR
// manual pick from the agent inbox.

model DeskTicket {
  id          String  @id @default(cuid())
  tenantId    String
  name        String // TKT-0001
  subject     String
  description String?
  status      String  @default("New") // New | Open | InProgress | OnHold | Resolved | Closed
  priority    String  @default("Medium") // Low | Medium | High | Urgent
  type        String  @default("Question") // Question | Problem | FeatureRequest | Incident | Task
  channel     String  @default("Manual") // Email | Portal | Chat | Phone | Manual | API

  // Requester — copy of contact info so the ticket survives party deletion.
  requesterEmail   String?
  requesterName    String?
  requesterPhone   String?
  // Optional links to CRM records.
  linkedCustomerId String?
  linkedLeadId     String?
  portalTicketId   String? // when mirrored from portal

  // Assignment
  assigneeUserId String? // agent responsible
  teamId         String? // future: team-based routing

  // SLA
  slaPolicyId              String?
  firstResponseDueAt       DateTime?
  resolutionDueAt          DateTime?
  firstResponseAt          DateTime?
  resolvedAt               DateTime?
  closedAt                 DateTime?
  onHoldAt                 DateTime?
  slaFirstResponseBreached Boolean   @default(false)
  slaResolutionBreached    Boolean   @default(false)

  // Tags — string array kept short (index-friendly).
  tags       String[]
  customData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slaPolicy    DeskSlaPolicy?      @relation(fields: [slaPolicyId], references: [id])
  replies      DeskTicketReply[]
  timeEntries  DeskTimeEntry[]
  csatRating   DeskCsatRating?
  aiSuggestion AITicketSuggestion?

  @@unique([tenantId, name])
  @@index([tenantId, status, priority])
  @@index([tenantId, assigneeUserId, status])
  @@index([tenantId, firstResponseDueAt])
  @@index([tenantId, resolutionDueAt])
  @@map("desk_tickets")
  @@schema("public")
}

model DeskTicketReply {
  id           String   @id @default(cuid())
  ticketId     String
  direction    String   @default("Public") // Public | Private (internal note)
  authorType   String // Agent | Customer | System
  authorUserId String? // set for Agent replies
  authorName   String?
  body         String
  createdAt    DateTime @default(now())

  ticket DeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("desk_ticket_replies")
  @@schema("public")
}

// ---------- Helpdesk: Knowledge Base (Module 52) ----------
//
// Category tree + Article. Articles have publish/draft states and a
// view counter — the ticket form queries GET /kb-articles/search
// against the query text and shows matching published articles.
//
// Self-service via portal-web: published articles are readable by
// PortalUser sessions without auth.

model KBCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  parentId    String?
  sortOrder   Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   KBCategory?  @relation("KBCategoryTree", fields: [parentId], references: [id])
  children KBCategory[] @relation("KBCategoryTree")
  articles KBArticle[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("kb_categories")
  @@schema("public")
}

model KBArticle {
  id           String    @id @default(cuid())
  tenantId     String
  categoryId   String?
  title        String
  slug         String
  bodyMarkdown String
  // Simple lifecycle: Draft not visible; Published is visible to
  // portal + suggested on ticket form; Archived hidden from search
  // but URLs still resolve for existing bookmarks.
  status       String    @default("Draft") // Draft | Published | Archived
  publishedAt  DateTime?
  viewCount    Int       @default(0)
  // Coarse tags for filtering / search relevance. Simple string
  // array kept in Postgres text[] (Prisma handles as String[]).
  tags         String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category KBCategory? @relation(fields: [categoryId], references: [id])

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("kb_articles")
  @@schema("public")
}

// ---------- Helpdesk: Service Contract (Module 53) ----------
//
// A support agreement with a customer: covers a window, links to an
// SLA policy (existing DeskSlaPolicy), tracks used vs entitled hours
// or ticket counts. When a customer's ticket is filed, the desk
// route can look up their active ServiceContract to enforce SLA
// tier + decrement the running usage.

model ServiceContract {
  id            String   @id @default(cuid())
  tenantId      String
  name          String // SC-0001
  customerId    String
  slaPolicyId   String?
  contractType  String   @default("Fixed Hours") // Fixed Hours | Unlimited | Per Ticket
  startDate     DateTime @db.Date
  endDate       DateTime @db.Date
  // For Fixed Hours: total entitled hours. For Per Ticket: ticket count.
  entitledUnits Decimal  @default(0) @db.Decimal(10, 2)
  usedUnits     Decimal  @default(0) @db.Decimal(10, 2)
  // Denormalized rate for reporting; doesn't move the ledger — a
  // separate SO/PI is expected for billing.
  contractValue Decimal  @default(0) @db.Decimal(18, 4)
  currency      String   @default("INR")
  status        String   @default("Active") // Active | Expired | Cancelled | Exhausted
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer       @relation("ServiceContractCustomer", fields: [customerId], references: [id])
  slaPolicy DeskSlaPolicy? @relation("ServiceContractSla", fields: [slaPolicyId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("service_contracts")
  @@schema("public")
}

// SlaPolicy — per-priority targets. `rules` is an array like
//   [{ priority: "Urgent", firstResponseMins: 15, resolutionMins: 240 }, …]
// A tenant can define many policies; one is marked `isDefault` and used
// when no other rule matches.
model DeskSlaPolicy {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  description       String?
  isDefault         Boolean  @default(false)
  businessHoursOnly Boolean  @default(false)
  rulesJson         Json // see doc-comment
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tickets          DeskTicket[]
  serviceContracts ServiceContract[] @relation("ServiceContractSla")

  @@unique([tenantId, name])
  @@index([tenantId, isDefault])
  @@map("desk_sla_policies")
  @@schema("public")
}

// AssignmentRule — auto-picks an agent when a ticket is created.
// `ruleType = RoundRobin` cycles through `agentUserIds` in order (state
// stored in `rrCursor`). `LoadBalanced` picks the agent with the fewest
// currently-open tickets. Conditions match on ticket channel/priority/type.
model DeskAssignmentRule {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  isActive        Boolean  @default(true)
  ruleType        String   @default("RoundRobin") // RoundRobin | LoadBalanced
  agentUserIds    String[] // candidate pool
  matchConditions Json? // { channel?: string[], priority?: string[], type?: string[] }
  priority        Int      @default(0) // higher wins when multiple match
  rrCursor        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isActive, priority])
  @@map("desk_assignment_rules")
  @@schema("public")
}

model DeskCannedResponse {
  id         String   @id @default(cuid())
  tenantId   String
  name       String // shortcut label — "greeting", "refund-policy"
  category   String? // free-text grouping
  subject    String?
  body       String
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, category])
  @@map("desk_canned_responses")
  @@schema("public")
}

model DeskTimeEntry {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  minutes   Int
  notes     String?
  billable  Boolean  @default(false)
  startedAt DateTime @default(now())

  ticket DeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([userId])
  @@map("desk_time_entries")
  @@schema("public")
}

model DeskCsatRating {
  id       String   @id @default(cuid())
  ticketId String   @unique
  score    Int // 1..5
  comment  String?
  ratedAt  DateTime @default(now())

  ticket DeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("desk_csat_ratings")
  @@schema("public")
}

// ---------- Marketing Plus: Web Forms + Landing Pages ----------
//
// WebForm — a public lead-capture form. `fieldsJson` is an ordered array of
// field specs the renderer walks to build the HTML. `mapping` says which
// form fields feed which Lead/Customer columns on submit. `afterSubmit`
// governs the redirect target + optional add-to-list + optional sequence
// enrollment (drip auto-triggers from the enrollment).
//
// Two rendering paths — both live and both worth having:
//   1. `/public/web-forms/:slug` (JSON schema)   → the operator UI's
//                                                   live-preview + a raw JSON
//                                                   API for iframe embeds.
//   2. `/public/web-forms/:slug/render` (HTML)   → a plain-HTML dropped in
//                                                   any site via <iframe>.
model WebForm {
  id                String   @id @default(cuid())
  tenantId          String
  name              String // internal
  publicSlug        String   @unique // /public/web-forms/<slug>
  title             String // shown at top of the form
  description       String?
  submitLabel       String   @default("Submit")
  successMessage    String   @default("Thanks — we'll be in touch shortly.")
  redirectUrl       String? // if set, browser navigates here after submit
  targetType        String   @default("Lead") // Lead | Customer
  addToListId       String? // optional list to enroll on submit
  triggerSequenceId String? // optional drip to enroll on submit
  fieldsJson        Json // [{ key, label, type, required, options?, placeholder? }]
  submissionCount   Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submissions WebFormSubmission[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("web_forms")
  @@schema("public")
}

model WebFormSubmission {
  id            String   @id @default(cuid())
  webFormId     String
  tenantId      String
  fieldsJson    Json // whatever the visitor submitted, keyed by field.key
  createdLeadId String?
  ipAddress     String?
  userAgent     String?
  referrer      String?
  createdAt     DateTime @default(now())

  webForm WebForm @relation(fields: [webFormId], references: [id], onDelete: Cascade)

  @@index([webFormId, createdAt])
  @@index([tenantId, createdAt])
  @@map("web_form_submissions")
  @@schema("public")
}

// LandingPage — self-contained marketing page. Body is raw HTML rendered
// verbatim at /public/pages/:slug. Views + conversions counted so
// campaigns can attribute revenue.
model LandingPage {
  id              String   @id @default(cuid())
  tenantId        String
  name            String // internal
  publicSlug      String   @unique
  title           String // <title> + og:title
  description     String? // meta description
  bodyHtml        String // rendered body content
  headHtml        String? // optional custom <head> chunk (CSS, tracking, etc.)
  isPublished     Boolean  @default(false)
  linkedWebFormId String? // for conversion tracking
  viewCount       Int      @default(0)
  conversionCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  views  LandingPageView[]

  @@unique([tenantId, name])
  @@index([tenantId, isPublished])
  @@map("landing_pages")
  @@schema("public")
}

model LandingPageView {
  id        String   @id @default(cuid())
  pageId    String
  ipAddress String?
  userAgent String?
  referrer  String?
  utm       Json? // { source, medium, campaign, term, content }
  createdAt DateTime @default(now())

  page LandingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@map("landing_page_views")
  @@schema("public")
}

// ---------- Survey ----------
//
// Zoho-Survey-style: a Survey has an ordered list of SurveyQuestions of
// various types (text / textarea / rating / nps / multiple-choice single /
// multi / dropdown / yes-no / matrix). Public respondents hit a `publicSlug`
// URL, POST an anonymous SurveyResponse with a SurveyAnswer per question.
//
// Analytics roll-ups happen on demand from SurveyAnswer.value:
//   - text/textarea → last-N responses list
//   - rating (1-5) → average + distribution
//   - nps (0-10)   → Promoters/Passives/Detractors + NPS score
//   - choice       → per-option counts
//
// `settings` holds display-time toggles (require-login, thank-you message,
// close date, response cap) without needing extra columns.
model Survey {
  id              String    @id @default(cuid())
  tenantId        String
  name            String // internal
  publicSlug      String    @unique
  title           String
  description     String?
  thankYouMessage String    @default("Thanks for your feedback!")
  isActive        Boolean   @default(false)
  closeAt         DateTime?
  responseCap     Int? // stop accepting after N responses
  responseCount   Int       @default(0)
  settingsJson    Json? // future: theme, colors, require-email, etc.
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("surveys")
  @@schema("public")
}

// SurveyQuestion — one row per question. `optionsJson` is used by choice-type
// questions (array of strings). `configJson` carries type-specific extras:
//   rating   → { min: 1, max: 5, labels?: { min, max } }
//   nps      → { labels?: { min: "Not likely", max: "Extremely likely" } }
//   matrix   → { rows: string[], cols: string[] }
model SurveyQuestion {
  id          String  @id @default(cuid())
  surveyId    String
  order       Int
  type        String // text | textarea | rating | nps | choice_single | choice_multi | dropdown | yes_no | matrix
  label       String
  description String?
  required    Boolean @default(false)
  optionsJson Json? // string[]
  configJson  Json? // per-type config

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@unique([surveyId, order])
  @@map("survey_questions")
  @@schema("public")
}

model SurveyResponse {
  id              String   @id @default(cuid())
  surveyId        String
  tenantId        String
  respondentEmail String? // optional — set when survey collects it
  respondentName  String?
  ipAddress       String?
  userAgent       String?
  submittedAt     DateTime @default(now())
  completed       Boolean  @default(true)

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([surveyId, submittedAt])
  @@index([tenantId, submittedAt])
  @@map("survey_responses")
  @@schema("public")
}

model SurveyAnswer {
  id         String @id @default(cuid())
  responseId String
  questionId String
  // The value is stored as JSON so a single column serves all types:
  //   text/textarea → string
  //   rating/nps    → number
  //   choice_single/dropdown/yes_no → string
  //   choice_multi  → string[]
  //   matrix        → { row: string, col: string }[]
  value      Json

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("survey_answers")
  @@schema("public")
}

// ---------- Zoho Social ----------
//
// Multi-channel social publishing + monitoring. Real OAuth to Twitter / Meta /
// LinkedIn is out of MVP scope — we ship the framework (compose + schedule +
// per-channel routing + calendar + engagement inbox) with a MOCK publisher
// so the whole workflow demos end-to-end today. Wiring a real platform SDK
// later is one file per platform.
model SocialAccount {
  id             String    @id @default(cuid())
  tenantId       String
  platform       String // Twitter | Facebook | Instagram | LinkedIn | GoogleMyBusiness | YouTube
  externalId     String? // platform-side account id (post-OAuth)
  handle         String // "@lumaara"
  displayName    String
  avatarUrl      String?
  accessToken    String? // MVP: null; real OAuth stores encrypted here
  refreshToken   String?
  tokenExpiresAt DateTime?
  isActive       Boolean   @default(true)
  addedByUserId  String
  addedAt        DateTime  @default(now())

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  results SocialPostResult[]

  @@unique([tenantId, platform, handle])
  @@index([tenantId, isActive])
  @@map("social_accounts")
  @@schema("public")
}

model SocialPost {
  id            String    @id @default(cuid())
  tenantId      String
  authorUserId  String
  content       String // main text/caption
  mediaUrls     String[] // uploaded/linked image URLs
  linkUrl       String? // OG-attached link
  channelIds    String[] // SocialAccount ids to fan out to
  status        String    @default("Draft") // Draft | Scheduled | Publishing | Published | Failed
  scheduledFor  DateTime?
  publishedAt   DateTime?
  failureReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  results SocialPostResult[]

  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, publishedAt])
  @@map("social_posts")
  @@schema("public")
}

// One row per (post × channel). Captures per-channel publish state + rolled
// engagement metrics fetched periodically from each platform's insights API.
model SocialPostResult {
  id             String    @id @default(cuid())
  postId         String
  accountId      String
  platformPostId String? // ID on the target platform after publish
  status         String    @default("Pending") // Pending | Published | Failed
  publishedAt    DateTime?
  error          String?
  impressions    Int       @default(0)
  likes          Int       @default(0)
  shares         Int       @default(0)
  comments       Int       @default(0)
  clicks         Int       @default(0)
  lastSyncedAt   DateTime?

  post    SocialPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  account SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([postId, accountId])
  @@index([accountId])
  @@map("social_post_results")
  @@schema("public")
}

// Monitor — a saved search (keyword / hashtag / @-mention) that the platform
// polls periodically for new hits. Each hit becomes a SocialMention row.
model SocialMonitor {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  type      String // Keyword | Hashtag | Mention
  query     String
  platforms String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@map("social_monitors")
  @@schema("public")
}

model SocialMention {
  id           String   @id @default(cuid())
  tenantId     String
  platform     String
  externalId   String?
  authorHandle String
  authorName   String?
  authorAvatar String?
  content      String
  linkUrl      String?
  postedAt     DateTime
  keyword      String? // which monitor caught it
  sentiment    String   @default("Neutral") // Positive | Neutral | Negative
  isReplied    Boolean  @default(false)
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, postedAt])
  @@index([tenantId, sentiment])
  @@map("social_mentions")
  @@schema("public")
}

// ---------- Zoho Cliq: internal team chat ----------
//
// Channels come in 3 shapes:
//   Direct  — 1:1 DM. Exactly two members. Name is derived from the other
//             user on read. Auto-created on POST /cliq/dm.
//   Public  — anyone in the tenant can join. Shows up in channel browser.
//   Private — invite-only. Only listed members can read/post.
//
// Messages are flat within a channel; threads use `threadParentId` (nested
// only one level — like Slack). Reactions are separate rows so we can
// count uniques per emoji without JSON parsing.
model CliqChannel {
  id              String   @id @default(cuid())
  tenantId        String
  type            String // Direct | Public | Private
  name            String // e.g. "general", "product", or "" for Direct
  description     String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members  CliqChannelMember[]
  messages CliqMessage[]

  // Public channels have unique names per tenant; Direct channels use
  // "".
  @@unique([tenantId, name, type])
  @@index([tenantId, type])
  @@map("cliq_channels")
  @@schema("public")
}

model CliqChannelMember {
  id         String    @id @default(cuid())
  channelId  String
  userId     String
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime? // last message id/time this user has seen
  isMuted    Boolean   @default(false)
  isPinned   Boolean   @default(false)

  channel CliqChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId, isPinned])
  @@map("cliq_channel_members")
  @@schema("public")
}

model CliqMessage {
  id             String    @id @default(cuid())
  tenantId       String
  channelId      String
  senderUserId   String
  senderName     String // snapshot for display without join lookup
  body           String
  threadParentId String? // null = top-level; else replies to that message
  editedAt       DateTime?
  deletedAt      DateTime? // soft-delete → "Message deleted" tombstone
  createdAt      DateTime  @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel       CliqChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  threadParent  CliqMessage?   @relation("CliqThread", fields: [threadParentId], references: [id])
  threadReplies CliqMessage[]  @relation("CliqThread")
  reactions     CliqReaction[]

  @@index([tenantId, createdAt])
  @@index([channelId, createdAt])
  @@index([channelId, threadParentId])
  @@map("cliq_messages")
  @@schema("public")
}

model CliqReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message CliqMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("cliq_reactions")
  @@schema("public")
}

// ---------- CRM: Sales Person (D7) ----------
// Named seller (may or may not be an Employee) attached to sales docs.
// SalesInvoice snapshots commissionPercent at submit time so historical
// commissions don't drift when the SalesPerson's default rate changes.

model SalesPerson {
  id                       String   @id @default(cuid())
  tenantId                 String
  name                     String
  employeeId               String? // optional link to HR Employee
  defaultCommissionPercent Decimal  @default(0) @db.Decimal(5, 2)
  enabled                  Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  tenant      Tenant                              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee?                           @relation("SalesPersonEmployee", fields: [employeeId], references: [id])
  invoices    SalesInvoice[]                      @relation("SISalesPerson")
  allocations SalesInvoiceSalesPersonAllocation[]

  @@unique([tenantId, name])
  @@index([tenantId, enabled])
  @@map("sales_persons")
  @@schema("public")
}

// ---------- CRM: Loyalty Program (D5) ----------
// Customers accrue points on submitted SalesInvoices at the program's rate
// (points per unit of grand total). Points can be redeemed on future SIs;
// unused points expire after `expiryMonths`.

model LoyaltyProgram {
  id                   String   @id @default(cuid())
  tenantId             String
  name                 String
  // Points per 1 unit of invoice grandTotal (in base currency). Example:
  // pointsPerCurrency = 0.01 means ₹100 spend → 1 point.
  pointsPerCurrency    Decimal  @default(0.01) @db.Decimal(18, 6)
  // Optional: minimum redemption threshold + max redemption per invoice.
  minRedemptionPoints  Int      @default(0)
  maxRedemptionPercent Decimal  @default(100) @db.Decimal(5, 2) // % of grand total
  expiryMonths         Int      @default(24)
  enabled              Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers Customer[]          @relation("CustomerLoyaltyProgram")
  entries   LoyaltyPointEntry[]

  @@unique([tenantId, name])
  @@index([tenantId, enabled])
  @@map("loyalty_programs")
  @@schema("public")
}

model LoyaltyPointEntry {
  id             String    @id @default(cuid())
  tenantId       String
  programId      String
  customerId     String
  // Type: Earned (award), Redeemed (spend), Expired (cleanup).
  entryType      String    @default("Earned") // Earned | Redeemed | Expired
  points         Int // positive integer (sign inferred by type)
  postingDate    DateTime  @default(now())
  expiryDate     DateTime?
  salesInvoiceId String?
  remarks        String?
  createdAt      DateTime  @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program  LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId, entryType])
  @@index([tenantId, programId])
  @@map("loyalty_point_entries")
  @@schema("public")
}

// ---------- Pricing: Coupon Code (D4) ----------
// A named code that gates a PricingRule. When the customer/UI supplies the
// code, the lookup requires it to match and the rule fires. Optional usage
// cap + validity window.

model CouponCode {
  id            String    @id @default(cuid())
  tenantId      String
  code          String
  pricingRuleId String
  maxUses       Int?
  usedCount     Int       @default(0)
  validFrom     DateTime?
  validUpto     DateTime?
  disabled      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pricingRule PricingRule @relation("CouponRule", fields: [pricingRuleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, disabled])
  @@map("coupon_codes")
  @@schema("public")
}

// ---------- CRM: Customer segmentation (D2) ----------
// Hierarchical CustomerGroup + Territory. Same shape as Account/Warehouse
// trees: `parentId` for hierarchy, `isGroup` gates whether the row can be
// posted to (customers only link to leaf rows).

model CustomerGroup {
  id        String   @id @default(cuid())
  tenantId  String
  groupName String
  parentId  String?
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    CustomerGroup?  @relation("CustomerGroupTree", fields: [parentId], references: [id])
  children  CustomerGroup[] @relation("CustomerGroupTree")
  customers Customer[]      @relation("CustomerCustomerGroup")

  @@unique([tenantId, groupName])
  @@index([tenantId, parentId])
  @@map("customer_groups")
  @@schema("public")
}

model Territory {
  id            String   @id @default(cuid())
  tenantId      String
  territoryName String
  parentId      String?
  isGroup       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Territory?  @relation("TerritoryTree", fields: [parentId], references: [id])
  children  Territory[] @relation("TerritoryTree")
  customers Customer[]  @relation("CustomerTerritory")

  @@unique([tenantId, territoryName])
  @@index([tenantId, parentId])
  @@map("territories")
  @@schema("public")
}

model Customer {
  id                            String   @id @default(cuid())
  tenantId                      String
  // ERPNext: customer_name, customer_type, customer_group, territory
  customerName                  String
  customerType                  String   @default("Company") // Company | Individual
  // Legacy free-form group + territory kept nullable for backwards compat
  // with pre-D2 data. New writes should use the FK columns below.
  customerGroup                 String?
  territory                     String?
  // D2: normalized segmentation via CustomerGroup + Territory FKs.
  customerGroupId               String?
  territoryId                   String?
  // D5: loyalty program enrollment. SI submit awards points at the
  // program's rate; balance = Σ(Earned) − Σ(Redeemed) − Σ(Expired).
  loyaltyProgramId              String?
  // D6: credit limit — SI submit refuses when the new SI would push the
  // customer's total open outstandingAmt over this cap. 0 = no limit.
  // `creditLimitBypassAllowed` lets a user with the SystemManager role
  // override with `?override=true`.
  creditLimit                   Decimal  @default(0) @db.Decimal(18, 4)
  creditLimitBypassAllowed      Boolean  @default(false)
  email                         String?
  mobile                        String?
  gstin                         String? // India tax ID; keep as generic tax id later
  // India PAN — 10 chars, [A-Z]{5}[0-9]{4}[A-Z]. Used for TCS (206C(1H))
  // reporting when tenant collects tax at source on customer sales.
  pan                           String?
  // Default TCS category for this customer. SI create auto-populates from
  // here; can be overridden per SI. Symmetric to Supplier.taxWithholdingCategoryId.
  taxCollectionCategoryId       String?
  // D10: default payment terms template — pre-selected on SI create when
  // the customer is picked. Overridable per SI. Symmetric to
  // Supplier.defaultPaymentTermsTemplateId.
  defaultPaymentTermsTemplateId String?
  // Meta-driven custom fields keyed by CustomField.fieldName. Schema-less
  // JSONB — validation happens server-side against the CustomField meta.
  customData                    Json?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  tenant                      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerGroupRel            CustomerGroup?         @relation("CustomerCustomerGroup", fields: [customerGroupId], references: [id])
  territoryRel                Territory?             @relation("CustomerTerritory", fields: [territoryId], references: [id])
  loyaltyProgram              LoyaltyProgram?        @relation("CustomerLoyaltyProgram", fields: [loyaltyProgramId], references: [id])
  loyaltyEntries              LoyaltyPointEntry[]
  subscriptions               Subscription[]         @relation("SubscriptionCustomer")
  invoices                    SalesInvoice[]
  recurringInvoices           RecurringInvoice[]     @relation("CustomerRecurring")
  deliveryNotes               DeliveryNote[]
  leadsConvertedFrom          Lead[]                 @relation("LeadConvertedCustomer")
  opportunities               Opportunity[]          @relation("OpportunityCustomer")
  quotations                  Quotation[]            @relation("QuotationCustomer")
  salesOrders                 SalesOrder[]           @relation("SalesOrderCustomer")
  projects                    Project[]
  taxCollectionCategory       TaxCollectionCategory? @relation("CustomerTCSCategory", fields: [taxCollectionCategoryId], references: [id])
  defaultPaymentTermsTemplate PaymentTermsTemplate?  @relation("CustomerDefaultPaymentTerms", fields: [defaultPaymentTermsTemplateId], references: [id])
  warranties                  Warranty[]             @relation("WarrantyCustomer")
  weighments                  Weighment[]            @relation("WeighmentCustomer")
  salesEnquiries              SalesEnquiry[]         @relation("SalesEnquiryCustomer")
  salesEnquiryDistribs        SalesEnquiry[]         @relation("SalesEnquiryDistributor")
  projectPlannings            ProjectPlanning[]      @relation("ProjectPlanningCustomer")
  bankGuarantees              BankGuarantee[]        @relation("BGCustomer")
  lettersOfCredit             LetterOfCredit[]       @relation("LCCustomer")
  posProfilesDefault          POSProfile[]           @relation("POSProfileDefaultCustomer")
  blanketOrders               BlanketOrder[]         @relation("BlanketOrderCustomer")
  serviceContracts            ServiceContract[]      @relation("ServiceContractCustomer")
  patients                    Patient[]              @relation("PatientCustomer")
  roomBookings                RoomBooking[]          @relation("RoomBookingCustomer")

  @@index([tenantId])
  @@map("customers")
  @@schema("public")
}

model Supplier {
  id                            String   @id @default(cuid())
  tenantId                      String
  // ERPNext: supplier_name, supplier_type, supplier_group
  supplierName                  String
  supplierType                  String   @default("Company") // Company | Individual
  supplierGroup                 String?
  email                         String?
  mobile                        String?
  gstin                         String?
  // India PAN — 10 chars, [A-Z]{5}[0-9]{4}[A-Z]. Required for 26Q filing
  // (TDS return). When missing on a supplier that TDS was deducted from,
  // the TDS 26Q report flags the row so the operator can file at the higher
  // no-PAN rate (20% or the section rate, whichever is higher).
  pan                           String?
  // B13: default TDS category for payments to this supplier. PaymentEntry
  // form auto-populates from here; can be overridden per PE.
  taxWithholdingCategoryId      String?
  // D10: default payment terms template — pre-selected on PI create when
  // the supplier is picked. Overridable per PI. Null = no default,
  // operator picks manually (or leaves single-payment).
  defaultPaymentTermsTemplateId String?
  customData                    Json?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  tenant                      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices                    PurchaseInvoice[]
  purchaseReceipts            PurchaseReceipt[]
  purchaseOrders              PurchaseOrder[]
  taxWithholdingCategory      TaxWithholdingCategory? @relation("SupplierTDSCategory", fields: [taxWithholdingCategoryId], references: [id])
  defaultPaymentTermsTemplate PaymentTermsTemplate?   @relation("SupplierDefaultPaymentTerms", fields: [defaultPaymentTermsTemplateId], references: [id])
  warranties                  Warranty[]              @relation("WarrantySupplier")
  purchaseWarranties          PurchaseWarranty[]      @relation("PurchaseWarrantySupplier")
  materialReturns             MaterialReturn[]        @relation("MaterialReturnSupplier")
  weighments                  Weighment[]             @relation("WeighmentSupplier")
  itemSitePlannings           ItemSitePlanning[]      @relation("ItemSitePlanningSupplier")
  bankGuarantees              BankGuarantee[]         @relation("BGSupplier")
  lettersOfCredit             LetterOfCredit[]        @relation("LCSupplier")
  itemsDefaultFor             Item[]                  @relation("ItemDefaultSupplier")
  rfqInvitations              RFQSupplier[]           @relation("RFQSupplierSupplier")
  supplierQuotations          SupplierQuotation[]     @relation("SQSupplier")
  scorecards                  SupplierScorecard[]     @relation("SupplierScorecardSupplier")
  blanketOrders               BlanketOrder[]          @relation("BlanketOrderSupplier")

  @@index([tenantId])
  @@map("suppliers")
  @@schema("public")
}

// B13: withholding-tax categories (Indian TDS sections e.g. 194C, 194J).
// Each row is a rate + threshold + destination account (TDS Payable liability).
// PaymentEntry snapshot borrows rate + account so future edits don't retro-
// change historical postings.
model TaxWithholdingCategory {
  id              String    @id @default(cuid())
  tenantId        String
  name            String // e.g. "TDS 194C Contractor"
  // Income-tax section code — used to group 26Q return rows. e.g. "194C",
  // "194J", "194H". PE snapshots this along with rate at create time.
  sectionCode     String?
  rate            Decimal   @db.Decimal(9, 4)
  // Threshold semantics: `cumulativeYtd` (default true) treats threshold as
  // "TDS applies once cumulative payments to a party in this FY cross this
  // amount"; every subsequent payment is deducted. When false, threshold is
  // per-payment (legacy).
  cumulativeYtd   Boolean   @default(true)
  thresholdAmount Decimal   @default(0) @db.Decimal(18, 4)
  accountId       String // Liability account (usually under Statutory Payable)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  disabled        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account   Account        @relation("TDSCategoryAccount", fields: [accountId], references: [id])
  suppliers Supplier[]     @relation("SupplierTDSCategory")
  payments  PaymentEntry[] @relation("PEWithholdingCategory")
  challans  TdsChallan[]   @relation("ChallanCategory")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tax_withholding_categories")
  @@schema("public")
}

// TCS (Tax Collected at Source) — mirror of TaxWithholdingCategory but on
// the sales side. Section 206C(1H) requires collecting 0.1% on sales to a
// customer once cumulative annual sales cross ₹50L. SI snapshots the rate
// + account at create/submit time so future edits don't rewrite history.
model TaxCollectionCategory {
  id              String    @id @default(cuid())
  tenantId        String
  name            String // e.g. "TCS 206C(1H) Sales"
  sectionCode     String? // e.g. "206C-1H". Grouping key for Form 27EQ.
  rate            Decimal   @db.Decimal(9, 4)
  cumulativeYtd   Boolean   @default(true)
  thresholdAmount Decimal   @default(0) @db.Decimal(18, 4)
  accountId       String // Liability account (TCS Payable under Statutory Payable)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  disabled        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account   Account        @relation("TCSCategoryAccount", fields: [accountId], references: [id])
  customers Customer[]     @relation("CustomerTCSCategory")
  invoices  SalesInvoice[] @relation("SITcsCategory")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("tax_collection_categories")
  @@schema("public")
}

// TdsChallan — records the monthly deposit of deducted TDS to the govt.
// After deducting TDS on Pay-type PEs, the tenant must deposit the total by
// the 7th of the following month (per Section 200 of the Income-tax Act).
// Each challan carries a BSR code + serial no from the bank, which the CA
// uses to reconcile against the 26Q return.
//
// The link back to PEs is many-to-many via section+month/quarter, not a
// hard FK — one challan covers all PEs of a section in a month, so we
// aggregate by matching (tenantId, section, quarter) rather than storing
// individual PE FKs. See tds.ts computeMonthlyDue for the aggregation.
model TdsChallan {
  id              String   @id @default(cuid())
  tenantId        String
  categoryId      String
  // BSR = 7-digit Basic Statistical Return code identifying the bank branch.
  // Combined with challanSerialNo + paidDate, uniquely IDs a govt deposit.
  bsrCode         String // "0510308" etc.
  challanSerialNo String
  paidDate        DateTime @db.Date
  amountPaid      Decimal  @db.Decimal(18, 4)
  // The FY-quarter this challan settles. Set when the challan is filed;
  // helps the 26Q export match challans to deducted-TDS rows.
  fyLabel         String // "2026-27"
  quarter         Int // 1 | 2 | 3 | 4
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category TaxWithholdingCategory @relation("ChallanCategory", fields: [categoryId], references: [id])

  @@unique([tenantId, bsrCode, challanSerialNo, paidDate])
  @@index([tenantId, fyLabel, quarter])
  @@index([tenantId, categoryId])
  @@map("tds_challans")
  @@schema("public")
}

model Item {
  id                               String   @id @default(cuid())
  tenantId                         String
  // ERPNext: item_code, item_name, item_group, stock_uom, standard_rate
  itemCode                         String
  itemName                         String
  itemGroup                        String?
  stockUom                         String   @default("Nos")
  standardRate                     Decimal  @default(0) @db.Decimal(18, 4)
  // GST HSN/SAC code — 4-8 digit product classifier used in GSTR-1 HSN
  // summary + printed on tax invoices. Optional; blank items roll up under
  // the "UNCLASSIFIED" bucket in reports.
  hsnCode                          String?
  description                      String?
  isStockItem                      Boolean  @default(true)
  // Fixed-asset flag (B4). When true + PI-line for this item is submitted,
  // the accounting service auto-creates a draft Asset row using the linked
  // AssetCategory. defaultAssetCategoryId is optional — if null, the PI
  // submit fails with a clear error asking the user to set the category.
  isAsset                          Boolean  @default(false)
  defaultAssetCategoryId           String?
  // C5: when true, each unit of this item is tracked by a distinct serial
  // number. PR/DN routes require `serialNumbers[]` per line whose length
  // matches qty; the SerialNo table records lifecycle.
  hasSerialNo                      Boolean  @default(false)
  // C6: when true, PR/DN require a `batchNo` per line — Batch table tracks
  // per-batch remaining qty. `hasExpiryDate` gates optional expiry-date UI
  // + upcoming-expiry alerts.
  hasBatchNo                       Boolean  @default(false)
  hasExpiryDate                    Boolean  @default(false)
  // C9: Quality Inspection defaults. When set, PR/DN submit refuses the
  // line unless there's an Accepted QualityInspection linked to that line.
  // `qualityInspectionTemplateId` seeds the QI parameter list on create.
  inspectionRequiredBeforeReceipt  Boolean  @default(false)
  inspectionRequiredBeforeDelivery Boolean  @default(false)
  qualityInspectionTemplateId      String?
  // C10: subcontracted item — purchases via a supplier who assembles it from
  // RM we send. Item's default BOM defines the RM list; PO submit for a
  // subcontracted PO auto-transfers those RM to the supplier warehouse.
  isSubContractedItem              Boolean  @default(false)
  // Product Bundle (aka composite item / kit). When true, this Item is a
  // packing wrapper — it appears on Sales Orders + Quotations at a bundle
  // price, but on convert-to-Delivery-Note it EXPLODES into its BundleComponent
  // rows (real stock movement happens on the components, not the bundle
  // itself). Bundles are typically flagged isStockItem=false so they never
  // participate in inventory ledgers.
  isProductBundle                  Boolean  @default(false)
  // Item Variants (color / size matrix). A "template" Item has
  // isVariantTemplate=true and holds the shared meta (name, category,
  // description, WebsiteItem). Each concrete variant is its OWN Item with
  // its own itemCode, stock, and price — linked via variantOfId + its
  // attribute snapshot in variantAttributes (e.g. {"Color":"Red","Size":"S"}).
  // Template Items are typically isStockItem=false (they don't move stock;
  // their variants do). The template's WebsiteItem powers the storefront
  // detail page; the variant picker resolves the customer's selection to a
  // specific variant Item at add-to-cart time.
  isVariantTemplate                Boolean  @default(false)
  variantOfId                      String?
  variantAttributes                Json?
  // B11 item-wise tax: SI/PI/Quote/SO line-item auto-populates from these
  // when the item is picked. Line can override; null → line falls back to
  // invoice-level template.
  defaultSalesTaxTemplateId        String?
  defaultPurchaseTaxTemplateId     String?
  // Dropshipping: when a Sales Order line is flagged `isDropship`, SO submit
  // auto-creates a Purchase Order Draft to this supplier for that quantity.
  // Optional — a dropship line without a default supplier fails the SO
  // submit with a clear error asking the operator to set one first.
  defaultSupplierId                String?
  // D12: Deferred revenue recognition. When true, SI submit for this item
  // credits Tenant.defaultDeferredRevenueAccountId (a liability) instead
  // of the Sales income account, AND materializes a
  // DeferredRevenueSchedule of `deferredRevenueMonths` monthly rows. A
  // scheduler tick (process-deferred-revenue) walks due rows and posts
  // JE to move each installment out of deferred into recognized revenue.
  // Typical use: annual SaaS contracts, service retainers, prepaid
  // multi-month subscriptions.
  enableDeferredRevenue            Boolean  @default(false)
  deferredRevenueMonths            Int      @default(12)
  customData                       Json?
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  tenant                     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultSupplier            Supplier?                   @relation("ItemDefaultSupplier", fields: [defaultSupplierId], references: [id])
  siItems                    SalesInvoiceItem[]
  recurringItems             RecurringInvoiceItem[]      @relation("ItemRecurring")
  piItems                    PurchaseInvoiceItem[]
  bins                       Bin[]
  stockLedgerEntries         StockLedgerEntry[]
  stockEntryItems            StockEntryItem[]
  dnItems                    DeliveryNoteItem[]
  prItems                    PurchaseReceiptItem[]
  bomsAsFinishedGood         BOM[]                       @relation("BOMFinishedGood")
  bomsAsRawMaterial          BOMItem[]                   @relation("BOMRawMaterial")
  workOrders                 WorkOrder[]                 @relation("WOFinishedGood")
  quotationItems             QuotationItem[]             @relation("QuotationItemItem")
  salesOrderItems            SalesOrderItem[]            @relation("SalesOrderItemItem")
  purchaseOrderItems         PurchaseOrderItem[]         @relation("POItemItem")
  materialRequestItems       MaterialRequestItem[]       @relation("MRItemItem")
  stockReconciliationItems   StockReconciliationItem[]   @relation("SRItemItem")
  prices                     ItemPrice[]                 @relation("ItemPriceItem")
  serialNumbers              SerialNo[]                  @relation("SerialNoItem")
  batches                    Batch[]                     @relation("BatchItem")
  uomConversions             ItemUOMConversion[]         @relation("UOMConvItem")
  qualityInspectionTemplate  QualityInspectionTemplate?  @relation("ItemDefaultQIT", fields: [qualityInspectionTemplateId], references: [id])
  qualityInspections         QualityInspection[]         @relation("QIItem")
  repostItemValuations       RepostItemValuation[]       @relation("RepostItemValuationItem")
  productionPlanItems        ProductionPlanItem[]        @relation("PPItemItem")
  productionPlanRawMaterials ProductionPlanRawMaterial[] @relation("PPRawMatItem")
  reorderRules               ItemReorderRule[]           @relation("ReorderItem")
  subscriptionItems          SubscriptionItem[]          @relation("SubscriptionItemItem")
  defaultAssetCategory       AssetCategory?              @relation("ItemDefaultAssetCategory", fields: [defaultAssetCategoryId], references: [id])
  defaultSalesTaxTemplate    TaxTemplate?                @relation("ItemDefaultSalesTax", fields: [defaultSalesTaxTemplateId], references: [id])
  defaultPurchaseTaxTemplate TaxTemplate?                @relation("ItemDefaultPurchaseTax", fields: [defaultPurchaseTaxTemplateId], references: [id])
  websiteItem                WebsiteItem?                @relation("WebsiteItemItem")
  bundleComponents           BundleComponent[]           @relation("BundleParent")
  usedInBundles              BundleComponent[]           @relation("BundleComponentItem")
  variantOf                  Item?                       @relation("ItemVariants", fields: [variantOfId], references: [id])
  variants                   Item[]                      @relation("ItemVariants")
  warranties                 Warranty[]                  @relation("WarrantyItem")
  purchaseWarranties         PurchaseWarranty[]          @relation("PurchaseWarrantyItem")
  materialIssueItems         MaterialIssueItem[]         @relation("MaterialIssueItemItem")
  materialTransferItems      MaterialTransferItem[]      @relation("MaterialTransferItemItem")
  materialReturnItems        MaterialReturnItem[]        @relation("MaterialReturnItemItem")
  weighments                 Weighment[]                 @relation("WeighmentItem")
  salesEnquiryItems          SalesEnquiryItem[]          @relation("SalesEnquiryItemItem")
  mrpSuggestions             MrpSuggestion[]             @relation("MrpSuggestionItem")
  itemSitePlannings          ItemSitePlanning[]          @relation("ItemSitePlanningItem")
  routings                   RoutingMaster[]             @relation("RoutingItem")
  rfqItems                   RFQItem[]                   @relation("RFQItemItem")
  supplierQuotationItems     SupplierQuotationItem[]     @relation("SQItemItem")
  pickListItems              PickListItem[]              @relation("PickListItemItem")
  alternatesAsPrimary        ItemAlternate[]             @relation("ItemAlternatePrimary")
  alternatesAsAlt            ItemAlternate[]             @relation("ItemAlternateAlt")
  blanketOrderItems          BlanketOrderItem[]          @relation("BlanketOrderItemItem")
  nonConformances            NonConformance[]            @relation("NCRItem")

  @@unique([tenantId, itemCode])
  @@index([tenantId])
  @@map("items")
  @@schema("public")
}

// ---------- Accounting: Sales Invoice ----------
// Mirrors ERPNext Sales Invoice + Sales Invoice Item child table.

model SalesInvoice {
  id             String    @id @default(cuid())
  tenantId       String
  // ERPNext-like naming series; simple auto-increment per tenant for now
  name           String // e.g. SINV-0001
  customerId     String
  postingDate    DateTime  @default(now())
  dueDate        DateTime?
  currency       String    @default("INR")
  conversionRate Decimal   @default(1) @db.Decimal(18, 6)

  netTotal           Decimal @default(0) @db.Decimal(18, 4)
  totalTaxes         Decimal @default(0) @db.Decimal(18, 4)
  grandTotal         Decimal @default(0) @db.Decimal(18, 4)
  // B12: `roundedTotal` = grandTotal rounded to whole units;
  // `roundingAdjustment` = roundedTotal - grandTotal (signed). Posted as an
  // extra GL line to Tenant.defaultRoundOffAccountId on submit. Both stay 0
  // when rounding is disabled (tenant has no round-off account).
  roundedTotal       Decimal @default(0) @db.Decimal(18, 4)
  roundingAdjustment Decimal @default(0) @db.Decimal(18, 4)
  outstandingAmt     Decimal @default(0) @db.Decimal(18, 4)

  status     String  @default("Draft") // Draft | Submitted | Paid | Cancelled
  remarks    String?
  customData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxTemplateId String?

  // B15: credit-note flag. `isReturn = true` inverts the GL post at submit
  // (Debtors credited, Sales debited); usually paired with `returnAgainstId`
  // pointing at the original SI so the return reduces the original's
  // outstanding. Return invoices carry negative qty/amount values.
  isReturn          Boolean @default(false)
  returnAgainstId   String?
  // Project attribution for profitability reporting. Nullable — most SIs
  // aren't project-scoped. When set, the SI's netTotal (minus taxes)
  // rolls into that project's revenue line.
  projectId         String?
  // D7: sales person attribution + snapshot commission %. Commission amount
  // = grandTotal × commissionPercent / 100 (informational; not GL-posted).
  salesPersonId     String?
  commissionPercent Decimal @default(0) @db.Decimal(5, 2)

  // O-einvoice: GST India IRP fields. `irn` is the 64-char Invoice Reference
  // Number returned by the IRP; `irnQrPayload` is the signed QR payload the
  // print template embeds. `irnStatus` gates cancel/regenerate flows.
  irn          String?
  irnQrPayload String?
  irnAckNo     String?
  irnAckDate   DateTime?
  irnStatus    String    @default("NotGenerated") // NotGenerated | Generated | Cancelled | Failed
  irnLastError String?

  // India TCS (Tax Collected at Source, Section 206C(1H)) — snapshot at
  // create time. Symmetric to PaymentEntry.withholding* fields. TCS is
  // collected FROM the customer (increases what they owe); the snapshot is
  // stable across future category-edits so Form 27EQ replays deterministically.
  //
  // Wiring on SI submit + inclusion in outstandingAmt / GL is deferred until
  // a design partner needs it — for MVP scope the fields are populated at
  // create and reportable via /reports/tcs-27eq, but the money-flow rewrite
  // waits until first customer with >₹50L annual sales.
  tcsCategoryId String?
  tcsSection    String?
  tcsRate       Decimal @default(0) @db.Decimal(9, 4)
  tcsAmount     Decimal @default(0) @db.Decimal(18, 4)
  tcsAccountId  String?

  // POS: when a SalesInvoice is created from the cashier UI, isPos flips true
  // and posOpeningId points at the active POSOpeningEntry. Cashier checkout
  // creates SI + PE in a single tx and submits both — see pos-invoices route.
  // POSClosingEntry aggregates by posOpeningId at session close.
  isPos        Boolean @default(false)
  posProfileId String?
  posOpeningId String?

  // Recurring invoices: when the scheduler (or /generate-now) mints an SI
  // from a RecurringInvoice template, this FK carries the template id so
  // the recurring detail page can list its history. Null for staff-created
  // and POS invoices.
  sourceRecurringId String?

  // D10: staggered payment schedule. When set at create, SI submit
  // materializes InvoicePaymentSchedule rows from the template's terms
  // (with dueDate = postingDate + term.dueDays) and overwrites `dueDate`
  // to the latest installment. Null = "single lump payment", schedule is
  // not materialized and the classic dueDate flow applies.
  paymentTermsTemplateId String?

  // D4: coupon code applied to this invoice. Denormalized as a string —
  // the CouponCode row is the source of truth for validity, but storing
  // the code inline means (a) the audit trail survives a coupon-row
  // rename/delete, (b) reports can filter by code without a join. On
  // submit, if this is non-null we re-validate + increment
  // CouponCode.usedCount atomically.
  couponCode String?

  // Multi-company Phase 2: scopes the invoice + its GL postings to a
  // Company within the tenant. Nullable for backwards compat — legacy
  // rows resolve to the tenant's default Company at post time. Create
  // route auto-fills from Tenant.defaultCompany when caller omits it.
  companyId String?

  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer             Customer                 @relation(fields: [customerId], references: [id])
  taxTemplate          TaxTemplate?             @relation("SITaxTemplate", fields: [taxTemplateId], references: [id])
  items                SalesInvoiceItem[]
  taxes                SalesInvoiceTax[]
  returnAgainst        SalesInvoice?            @relation("SIReturnAgainst", fields: [returnAgainstId], references: [id])
  returns              SalesInvoice[]           @relation("SIReturnAgainst")
  salesPerson          SalesPerson?             @relation("SISalesPerson", fields: [salesPersonId], references: [id])
  project              Project?                 @relation("SIProject", fields: [projectId], references: [id])
  tcsCategory          TaxCollectionCategory?   @relation("SITcsCategory", fields: [tcsCategoryId], references: [id])
  tcsAccount           Account?                 @relation("SITcsAccount", fields: [tcsAccountId], references: [id])
  posProfile           POSProfile?              @relation("SIPosProfile", fields: [posProfileId], references: [id])
  posOpening           POSOpeningEntry?         @relation("SIPosOpening", fields: [posOpeningId], references: [id])
  sourceRecurring      RecurringInvoice?        @relation("RecurringGeneratedSI", fields: [sourceRecurringId], references: [id])
  paymentReminders     PaymentReminder[]        @relation("SIPaymentReminder")
  paymentTermsTemplate PaymentTermsTemplate?    @relation("SIPaymentTerms", fields: [paymentTermsTemplateId], references: [id])
  paymentSchedule      InvoicePaymentSchedule[] @relation("SIPaymentSchedule")
  ewayBills            EWayBill[]               @relation("SIEWayBill")
  company              Company?                 @relation("SICompany", fields: [companyId], references: [id])
  salesTeam            SalesInvoiceSalesPersonAllocation[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, irn])
  @@index([tenantId, posOpeningId])
  @@index([tenantId, sourceRecurringId])
  @@map("sales_invoices")
  @@schema("public")
}

// Multi-salesperson attribution ("deal splits") on a SalesInvoice.
//
// When present, this table is the source of truth for commission
// calculation — every included salesperson gets `allocationPct` of the
// SI's net revenue at their `commissionRate` (defaulted to the
// salesperson's `defaultCommissionPercent` at row-creation time so
// historic commissions don't drift when the master rate changes).
//
// Invariant: sum(allocationPct) === 100 across all rows for a given
// invoice. Enforced by the route on PUT; the DB is dumb here on purpose
// so bulk imports can stage rows one at a time.
//
// When empty and SalesInvoice.salesPersonId is set, callers should
// treat it as an implicit 100% allocation to that salesperson — the
// existing single-person model. New SIs default to no rows (empty
// implies "use salesPersonId if set").
model SalesInvoiceSalesPersonAllocation {
  id             String   @id @default(cuid())
  tenantId       String
  salesInvoiceId String
  salesPersonId  String
  allocationPct  Decimal  @db.Decimal(6, 3)  // 0.000 .. 100.000
  commissionRate Decimal  @default(0) @db.Decimal(5, 2)
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  salesPerson  SalesPerson  @relation(fields: [salesPersonId], references: [id])

  @@unique([salesInvoiceId, salesPersonId])
  @@index([tenantId, salesPersonId])
  @@map("sales_invoice_sales_person_allocations")
  @@schema("public")
}

// Recurring invoice — a template that the scheduler materialises into a real
// SalesInvoice on `nextRunDate`. Frequency + interval form the cadence
// (e.g. Monthly × 1 = every month; Monthly × 3 = quarterly). `endDate` +
// `status` bound the schedule. Every generated child stamps this row's id
// on its `sourceRecurringId` for traceability.
model RecurringInvoice {
  id         String @id @default(cuid())
  tenantId   String
  name       String // e.g. RECINV-0001
  title      String // Human label — "Monthly SaaS - Acme"
  customerId String

  currency      String  @default("INR")
  taxTemplateId String?
  remarks       String?

  // Schedule
  frequency     String // Daily | Weekly | Monthly | Quarterly | Yearly
  intervalCount Int       @default(1) // Every N periods
  startDate     DateTime  @db.Date
  endDate       DateTime? @db.Date
  daysUntilDue  Int       @default(30) // dueDate = generation date + N

  // Runtime state
  status          String    @default("Active") // Active | Paused | Ended
  nextRunDate     DateTime  @db.Date
  lastGeneratedAt DateTime?
  generatedCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer               @relation("CustomerRecurring", fields: [customerId], references: [id])
  items             RecurringInvoiceItem[]
  generatedInvoices SalesInvoice[]         @relation("RecurringGeneratedSI")

  @@unique([tenantId, name])
  @@index([tenantId, status, nextRunDate])
  @@map("recurring_invoices")
  @@schema("public")
}

// ---------- Payment Reminders ----------
// One row per reminder email sent for a Submitted invoice with outstanding
// balance. The scheduler ticks hourly, walks overdue SIs, and picks the
// next-due reminder kind based on Tenant.reminderThresholds. Rows here are
// the audit trail — the actual email lives in EmailMessage (linkedDoctype
// = "PaymentReminder", linkedId = this row's id).
//
// Dedup rule: never send the same `kind` twice in <24h for the same SI
// (protects against scheduler double-firing on restart / clock drift).

model PaymentReminder {
  id                String   @id @default(cuid())
  tenantId          String
  salesInvoiceId    String
  // D10: when the invoice has an InvoicePaymentSchedule, reminders fire
  // per-installment. `paymentScheduleId` targets the specific row; the
  // pickReminderKind dedup key becomes (row × kind) instead of (invoice ×
  // kind). Null for legacy / single-payment invoice reminders.
  paymentScheduleId String?
  // "First" | "Second" | "Final" — matches the keys in Tenant.reminderThresholds.
  // Sending a "Final" implicitly means all lower tiers already fired (or
  // were skipped because the invoice sailed past their threshold in one
  // tick — think a 90-day-old invoice on first import).
  kind              String
  daysOverdue       Int
  outstandingAmt    Decimal  @db.Decimal(18, 4)
  toEmail           String
  // "Auto" = scheduled tick fired it. "Manual" = staff clicked
  // "Send reminder" from the SI detail page.
  trigger           String   @default("Auto")
  createdAt         DateTime @default(now())

  tenant          Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoice    SalesInvoice            @relation("SIPaymentReminder", fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  paymentSchedule InvoicePaymentSchedule? @relation("SchedulePaymentReminder", fields: [paymentScheduleId], references: [id], onDelete: SetNull)

  @@index([tenantId, salesInvoiceId, createdAt])
  @@index([tenantId, paymentScheduleId, createdAt])
  @@index([tenantId, createdAt])
  @@map("payment_reminders")
  @@schema("public")
}

model RecurringInvoiceItem {
  id                 String  @id @default(cuid())
  recurringInvoiceId String
  itemId             String
  qty                Decimal @db.Decimal(18, 4)
  rate               Decimal @db.Decimal(18, 4)
  amount             Decimal @db.Decimal(18, 4) // qty * rate
  description        String?

  recurringInvoice RecurringInvoice @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  item             Item             @relation("ItemRecurring", fields: [itemId], references: [id])

  @@index([recurringInvoiceId])
  @@map("recurring_invoice_items")
  @@schema("public")
}

model SalesInvoiceItem {
  id                 String  @id @default(cuid())
  salesInvoiceId     String
  itemId             String
  qty                Decimal @db.Decimal(18, 4)
  rate               Decimal @db.Decimal(18, 4)
  amount             Decimal @db.Decimal(18, 4) // qty * rate
  description        String?
  // Optional back-links when this line was created via SO→SI or DN→SI convert.
  // Used to compute SO.billedQty and to render source-doc links on the detail
  // page.
  salesOrderItemId   String?
  deliveryNoteItemId String?
  // B11 item-wise tax override. If set, this line's tax uses THIS template
  // instead of the invoice-level one. Auto-populated from item's default
  // at line-add time in the UI. Null = falls back to invoice.taxTemplateId.
  taxTemplateId      String?

  salesInvoice            SalesInvoice              @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  item                    Item                      @relation(fields: [itemId], references: [id])
  salesOrderItem          SalesOrderItem?           @relation("SOItemToSILine", fields: [salesOrderItemId], references: [id])
  deliveryNoteItem        DeliveryNoteItem?         @relation("DNItemToSILine", fields: [deliveryNoteItemId], references: [id])
  timesheetLines          TimesheetLine[]           @relation("TSLineToSILine")
  taxTemplate             TaxTemplate?              @relation("SIItemLineTax", fields: [taxTemplateId], references: [id])
  deferredRevenueSchedule DeferredRevenueSchedule[] @relation("SIItemDeferredRev")

  @@index([salesInvoiceId])
  @@index([salesOrderItemId])
  @@index([deliveryNoteItemId])
  @@map("sales_invoice_items")
  @@schema("public")
}

// ---------- Buying: Purchase Invoice ----------
// Mirrors SalesInvoice from the buying side.

model PurchaseInvoice {
  id                String    @id @default(cuid())
  tenantId          String
  name              String // e.g. PINV-0001
  supplierId        String
  // ERPNext calls this "bill_no" — the supplier's invoice number.
  supplierInvoiceNo String?
  postingDate       DateTime  @default(now())
  dueDate           DateTime?
  currency          String    @default("INR")
  conversionRate    Decimal   @default(1) @db.Decimal(18, 6)

  netTotal           Decimal @default(0) @db.Decimal(18, 4)
  totalTaxes         Decimal @default(0) @db.Decimal(18, 4)
  grandTotal         Decimal @default(0) @db.Decimal(18, 4)
  // B12: see SalesInvoice for semantics.
  roundedTotal       Decimal @default(0) @db.Decimal(18, 4)
  roundingAdjustment Decimal @default(0) @db.Decimal(18, 4)
  outstandingAmt     Decimal @default(0) @db.Decimal(18, 4)

  status     String  @default("Draft") // Draft | Submitted | Paid | Cancelled
  remarks    String?
  customData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxTemplateId String?

  // B15: debit-note flag. See SalesInvoice.isReturn for semantics.
  isReturn        Boolean @default(false)
  returnAgainstId String?

  // D10: staggered payment schedule. Same semantics as SalesInvoice.
  paymentTermsTemplateId String?

  // Multi-company Phase 2: see SalesInvoice.companyId.
  companyId String?

  tenant               Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier             Supplier                 @relation(fields: [supplierId], references: [id])
  taxTemplate          TaxTemplate?             @relation("PITaxTemplate", fields: [taxTemplateId], references: [id])
  items                PurchaseInvoiceItem[]
  taxes                PurchaseInvoiceTax[]
  returnAgainst        PurchaseInvoice?         @relation("PIReturnAgainst", fields: [returnAgainstId], references: [id])
  returns              PurchaseInvoice[]        @relation("PIReturnAgainst")
  paymentTermsTemplate PaymentTermsTemplate?    @relation("PIPaymentTerms", fields: [paymentTermsTemplateId], references: [id])
  paymentSchedule      InvoicePaymentSchedule[] @relation("PIPaymentSchedule")
  company              Company?                 @relation("PICompany", fields: [companyId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_invoices")
  @@schema("public")
}

model PurchaseInvoiceItem {
  id                    String  @id @default(cuid())
  purchaseInvoiceId     String
  itemId                String
  qty                   Decimal @db.Decimal(18, 4)
  rate                  Decimal @db.Decimal(18, 4)
  amount                Decimal @db.Decimal(18, 4)
  description           String?
  // Optional back-link when this line was created via PR→PI convert. When
  // present, PI submit posts the SRBNB→Creditors flip instead of the usual
  // Purchases→Creditors post (see gl-posting logic in purchase-invoices.ts).
  purchaseReceiptItemId String?
  // B11 item-wise tax override (see SalesInvoiceItem for details).
  taxTemplateId         String?

  purchaseInvoice     PurchaseInvoice      @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  item                Item                 @relation(fields: [itemId], references: [id])
  purchaseReceiptItem PurchaseReceiptItem? @relation("PRItemToPILine", fields: [purchaseReceiptItemId], references: [id])
  createdAsset        Asset[]              @relation("PIItemToAsset")
  taxTemplate         TaxTemplate?         @relation("PIItemLineTax", fields: [taxTemplateId], references: [id])

  @@index([purchaseInvoiceId])
  @@index([purchaseReceiptItemId])
  @@map("purchase_invoice_items")
  @@schema("public")
}

// ---------- Accounting: Payment Entry ----------
// Mirrors ERPNext Payment Entry (Receive/Pay against parties, allocated to references).

model PaymentEntry {
  id                    String    @id @default(cuid())
  tenantId              String
  name                  String // e.g. PE-0001
  paymentType           String // Receive | Pay
  postingDate           DateTime  @default(now())
  partyType             String // Customer | Supplier (only Customer supported in slice 1)
  partyId               String // FK is application-enforced (multi-party-type table)
  // paidAmount + allocatedAmount are denominated in `currency`. conversionRate
  // translates that to the tenant's baseCurrency. FX gain/loss is booked at
  // submit time when the invoice was recorded at a different conversionRate
  // (see PE submit logic).
  paidAmount            Decimal   @db.Decimal(18, 4)
  currency              String    @default("INR")
  conversionRate        Decimal   @default(1) @db.Decimal(18, 6)
  modeOfPayment         String    @default("Cash") // Cash | Bank | UPI | Card
  // Cheque details (only relevant for modeOfPayment = "Bank" when paid via
  // cheque). chequeNumber is the physical cheque book serial; chequeDate
  // is the date printed on the cheque (usually postingDate but staff can
  // predate for post-dated cheques). Both null when not a cheque payment.
  chequeNumber          String?
  chequeDate            DateTime? @db.Date
  // Set to true after /print-cheque is called successfully. Prevents
  // accidentally re-printing (which would waste a physical cheque).
  // Staff can force reprint with ?force=true.
  chequePrinted         Boolean   @default(false)
  remarks               String?
  status                String    @default("Draft") // Draft | Submitted | Cancelled
  // B13: TDS on Pay-type PEs. Snapshot of the category's rate + account at PE
  // create time so category edits don't rewrite history.
  //   withholdingAmount = paidAmount × withholdingRate/100 (computed on
  //     create, editable). Actual Cash/Bank outflow = paidAmount − withholdingAmount.
  //   Payable clears at paidAmount (supplier considered settled for the full
  //     invoice allocation; TDS is a separate obligation to the government).
  withholdingCategoryId String?
  withholdingRate       Decimal   @default(0) @db.Decimal(9, 4)
  withholdingAmount     Decimal   @default(0) @db.Decimal(18, 4)
  withholdingAccountId  String?
  // Snapshot of the category's IT section code at PE create time. Lets 26Q
  // aggregation group by section without joining across categories that
  // may have been edited or deleted since the payment was made.
  withholdingSection    String?
  customData            Json?
  // Multi-company Phase 2: see SalesInvoice.companyId.
  companyId             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant              Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  references          PaymentEntryReference[]
  withholdingCategory TaxWithholdingCategory? @relation("PEWithholdingCategory", fields: [withholdingCategoryId], references: [id])
  withholdingAccount  Account?                @relation("PEWithholdingAccount", fields: [withholdingAccountId], references: [id])
  company             Company?                @relation("PECompany", fields: [companyId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, partyType, partyId])
  @@map("payment_entries")
  @@schema("public")
}

model PaymentEntryReference {
  id               String  @id @default(cuid())
  paymentEntryId   String
  referenceDoctype String // e.g. "SalesInvoice"
  referenceId      String // FK is application-enforced (points to different tables per doctype)
  allocatedAmount  Decimal @db.Decimal(18, 4)

  paymentEntry PaymentEntry @relation(fields: [paymentEntryId], references: [id], onDelete: Cascade)

  @@index([paymentEntryId])
  @@index([referenceDoctype, referenceId])
  @@map("payment_entry_references")
  @@schema("public")
}

// ---------- Accounting: Chart of Accounts ----------
// Hierarchical account tree. Mirrors ERPNext Account DocType.
// - rootType: Asset | Liability | Equity | Income | Expense
// - accountType: Receivable | Payable | Cash | Bank | Tax | Income | Expense | ... (finer than rootType)
// - isGroup: parent nodes (cannot be posted to); leaves receive postings

model Account {
  id             String   @id @default(cuid())
  tenantId       String
  accountName    String
  rootType       String // Asset | Liability | Equity | Income | Expense
  accountType    String? // Receivable | Payable | Cash | Bank | Tax | Income | Expense | ...
  parentId       String?
  isGroup        Boolean  @default(false)
  disabled       Boolean  @default(false)
  // Multi-company Phase 1: null = shared across all companies in the
  // tenant (matches historical single-company behavior). Non-null scopes
  // the account to that company. Reports can filter by companyId; when
  // null the report aggregates.
  companyId      String?
  // Multi-company Phase 4: intercompany elimination flag. When true, this
  // account is treated as an intercompany receivable/payable and its
  // balance is auto-eliminated by the /consolidation report. Typical
  // usage: create paired "IC Receivable — Company B" and "IC Payable —
  // Company B" accounts, flag both, and every consolidation cleans them
  // up without user intervention.
  isIntercompany Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Account?  @relation("AccountTree", fields: [parentId], references: [id])
  children Account[] @relation("AccountTree")
  company  Company?  @relation("AccountCompany", fields: [companyId], references: [id])

  journalEntryLines         JournalEntryAccount[]
  glEntries                 GLEntry[]
  taxTemplates              TaxTemplate[]            @relation("TaxTemplateAccount")
  taxTemplateRows           TaxTemplateRow[]         @relation("TaxTemplateRowAccount")
  siTaxLines                SalesInvoiceTax[]        @relation("SITaxAccount")
  piTaxLines                PurchaseInvoiceTax[]     @relation("PITaxAccount")
  bankStatements            BankStatement[]          @relation("BankStatementAccount")
  landedCostVoucherTaxes    LandedCostVoucherTax[]   @relation("LCVTaxAccount")
  quotationTaxes            QuotationTax[]           @relation("QuotationTaxAccount")
  salesOrderTaxes           SalesOrderTax[]          @relation("SalesOrderTaxAccount")
  budgets                   Budget[]                 @relation("BudgetAccount")
  expenseClaimTypes         ExpenseClaimType[]       @relation("ExpenseClaimTypeAccount")
  expenseClaimItems         ExpenseClaimItem[]       @relation("ExpenseClaimItemAccount")
  assetCategoriesAsset      AssetCategory[]          @relation("AssetCategoryAssetAccount")
  assetCategoriesAccumDep   AssetCategory[]          @relation("AssetCategoryAccumDepAccount")
  assetCategoriesDepExpense AssetCategory[]          @relation("AssetCategoryDepExpenseAccount")
  tdsCategories             TaxWithholdingCategory[] @relation("TDSCategoryAccount")
  peWithholding             PaymentEntry[]           @relation("PEWithholdingAccount")
  tcsCategories             TaxCollectionCategory[]  @relation("TCSCategoryAccount")
  siTcsSnapshot             SalesInvoice[]           @relation("SITcsAccount")
  poTaxLines                PurchaseOrderTax[]       @relation("POTaxAccount")
  employeeAdvances          EmployeeAdvance[]        @relation("EmployeeAdvanceAccount")
  posProfileIncome          POSProfile[]             @relation("POSProfileIncomeAccount")

  @@unique([tenantId, accountName])
  @@index([tenantId, parentId])
  @@index([tenantId, rootType])
  @@map("accounts")
  @@schema("public")
}

// ---------- Accounting: Journal Entry ----------
// A journal entry is a balanced set of debit/credit lines against accounts.
// On submit, each line becomes a GLEntry.

model JournalEntry {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String // JV-0001
  postingDate         DateTime  @default(now())
  currency            String    @default("INR")
  remarks             String?
  status              String    @default("Draft") // Draft | Submitted | Cancelled
  // Multi-company Phase 2: see SalesInvoice.companyId.
  companyId           String?
  // Auto-reversing JE (M57 deferred fix): when true, the scheduler
  // auto-posts a mirror JE with DR/CR swapped on `reverseOnDate` so
  // accrual-style entries (FX reval, period-end accruals) automatically
  // flip in the next period without double-counting the underlying
  // settlement. `reverseOnDate` defaults to the first day of the next
  // month at commit time. Once reversed, `reversedByJournalId` points
  // at the flip; `reversedAt` records when the tick ran. Cancelled JEs
  // are skipped by the tick.
  isReversing         Boolean   @default(false)
  reverseOnDate       DateTime? @db.Date
  reversedByJournalId String?   @unique
  reversedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts   JournalEntryAccount[]
  company    Company?                  @relation("JECompany", fields: [companyId], references: [id])
  // Multi-company Phase 4: back-references from IntercompanyJournalEntry.
  // At most one of these is set per JE (a JE can only be one side of an IC
  // pair). Both null = ordinary single-company JE.
  icAsFrom   IntercompanyJournalEntry? @relation("ICFromJournal")
  icAsTo     IntercompanyJournalEntry? @relation("ICToJournal")
  fxRevalRun FxRevaluationRun?         @relation("FxRevalJE")
  reversedBy JournalEntry?             @relation("JEReversalChain", fields: [reversedByJournalId], references: [id])
  reverses   JournalEntry?             @relation("JEReversalChain")

  @@unique([tenantId, name])
  @@index([tenantId, status])
  // Fast lookup for the scheduler tick: JEs due to reverse today.
  @@index([tenantId, isReversing, reverseOnDate])
  @@map("journal_entries")
  @@schema("public")
}

model JournalEntryAccount {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(18, 4)
  credit         Decimal @default(0) @db.Decimal(18, 4)
  partyType      String? // Customer | Supplier (optional; for party-linked JEs)
  partyId        String?
  remarks        String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_accounts")
  @@schema("public")
}

// ---------- Accounting: General Ledger ----------
// The immutable posting ledger. Every document that "posts" creates rows here.
// On cancel, we don't delete — we mark isCancelled=true (mirrors ERPNext).
// Reports must filter by isCancelled=false.

// ---------- Stock: Warehouse ----------
// Hierarchical location tree. Every stock movement is between warehouses
// (or to/from external for receipts/issues). Bin holds the running per-item
// balance at each leaf warehouse.

model Warehouse {
  id            String   @id @default(cuid())
  tenantId      String
  warehouseName String
  parentId      String?
  isGroup       Boolean  @default(false)
  disabled      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Warehouse?  @relation("WarehouseTree", fields: [parentId], references: [id])
  children Warehouse[] @relation("WarehouseTree")

  bins                    Bin[]
  stockLedgerEntries      StockLedgerEntry[]
  seItemsSource           StockEntryItem[]          @relation("SEItemSourceWH")
  seItemsTarget           StockEntryItem[]          @relation("SEItemTargetWH")
  seInTransit             StockEntry[]              @relation("StockEntryInTransit")
  dnItems                 DeliveryNoteItem[]        @relation("DNItemWarehouse")
  prItems                 PurchaseReceiptItem[]     @relation("PRItemWarehouse")
  woSource                WorkOrder[]               @relation("WOSourceWH")
  woTarget                WorkOrder[]               @relation("WOTargetWH")
  poItems                 PurchaseOrderItem[]       @relation("POItemWarehouse")
  posAsSupplierWH         PurchaseOrder[]           @relation("POSupplierWH")
  posAsSourceWH           PurchaseOrder[]           @relation("POSourceWH")
  mrItems                 MaterialRequestItem[]     @relation("MRItemWarehouse")
  srItems                 StockReconciliationItem[] @relation("SRItemWarehouse")
  serialNumbers           SerialNo[]                @relation("SerialNoWarehouse")
  reorderRules            ItemReorderRule[]         @relation("ReorderWarehouse")
  materialIssueSource     MaterialIssue[]           @relation("MaterialIssueSource")
  materialTransferSource  MaterialTransfer[]        @relation("MaterialTransferSource")
  materialTransferTarget  MaterialTransfer[]        @relation("MaterialTransferTarget")
  materialReturnWarehouse MaterialReturn[]          @relation("MaterialReturnWarehouse")
  itemSitePlannings       ItemSitePlanning[]        @relation("ItemSitePlanningWarehouse")
  posProfiles             POSProfile[]              @relation("POSProfileWarehouse")
  repostItemValuations    RepostItemValuation[]     @relation("RepostItemValuationWarehouse")
  pickListItems           PickListItem[]            @relation("PickListItemWarehouse")

  @@unique([tenantId, warehouseName])
  @@index([tenantId, parentId])
  @@map("warehouses")
  @@schema("public")
}

// Bin is the CURRENT balance for (item, warehouse). Updated on every SLE
// (moving-average valuation). It's a cache — the source of truth is
// the StockLedgerEntry table, and Bin can be rebuilt from active SLEs.

model Bin {
  id            String   @id @default(cuid())
  tenantId      String
  itemId        String
  warehouseId   String
  actualQty     Decimal  @default(0) @db.Decimal(18, 4)
  valuationRate Decimal  @default(0) @db.Decimal(18, 4) // moving avg
  stockValue    Decimal  @default(0) @db.Decimal(18, 4) // qty * rate
  updatedAt     DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, itemId, warehouseId])
  @@index([tenantId, warehouseId])
  @@map("bins")
  @@schema("public")
}

// The immutable stock ledger. Every submitted stock movement writes rows here.
// actualQty is signed: + for inflow, - for outflow.
// qtyAfterTransaction is the running balance at that time.
// Cancels flip isCancelled=true; Bin is rebuilt from active rows.

model StockLedgerEntry {
  id                  String   @id @default(cuid())
  tenantId            String
  postingDate         DateTime
  itemId              String
  warehouseId         String
  actualQty           Decimal  @db.Decimal(18, 4)
  qtyAfterTransaction Decimal  @db.Decimal(18, 4)
  incomingRate        Decimal  @default(0) @db.Decimal(18, 4) // rate for inflows
  valuationRate       Decimal  @db.Decimal(18, 4) // moving-avg after this txn
  stockValue          Decimal  @db.Decimal(18, 4) // running stock value
  voucherType         String // StockEntry | PurchaseReceipt | DeliveryNote
  voucherId           String
  voucherName         String?
  isCancelled         Boolean  @default(false)
  createdAt           DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, itemId, warehouseId, isCancelled])
  @@index([tenantId, voucherType, voucherId])
  @@index([tenantId, postingDate])
  @@map("stock_ledger_entries")
  @@schema("public")
}

// ---------- Stock: Stock Entry ----------
// Types (ERPNext-style):
//   Material Receipt   -> incoming to targetWarehouse (no source)
//   Material Issue     -> outgoing from sourceWarehouse (no target)
//   Material Transfer  -> sourceWarehouse -> targetWarehouse (both)

model StockEntry {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // STE-0001
  entryType   String // Material Receipt | Material Issue | Material Transfer
  postingDate DateTime @default(now())
  remarks     String?
  status      String   @default("Draft") // Draft | Submitted | In Transit | Cancelled
  // Multi-warehouse in-transit stage (for Material Transfer only).
  // When set at submit time, the transfer posts source-out + in-transit-in
  // and enters status "In Transit". The /receive endpoint then posts
  // in-transit-out + target-in and flips the row to "Submitted".
  // Null on receipts / issues / non-in-transit transfers (legacy direct
  // source→target flow — kept for backwards compat).
  inTransitWarehouseId String?
  receivedAt           DateTime?
  receivedByUserId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inTransitWarehouse Warehouse? @relation("StockEntryInTransit", fields: [inTransitWarehouseId], references: [id])
  items              StockEntryItem[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, inTransitWarehouseId, status])
  @@map("stock_entries")
  @@schema("public")
}

model StockEntryItem {
  id                String  @id @default(cuid())
  stockEntryId      String
  itemId            String
  qty               Decimal @db.Decimal(18, 4)
  basicRate         Decimal @default(0) @db.Decimal(18, 4) // per-unit rate for receipts (valuation input)
  sourceWarehouseId String?
  targetWarehouseId String?

  stockEntry      StockEntry @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  item            Item       @relation(fields: [itemId], references: [id])
  sourceWarehouse Warehouse? @relation("SEItemSourceWH", fields: [sourceWarehouseId], references: [id])
  targetWarehouse Warehouse? @relation("SEItemTargetWH", fields: [targetWarehouseId], references: [id])

  @@index([stockEntryId])
  @@map("stock_entry_items")
  @@schema("public")
}

model GLEntry {
  id          String   @id @default(cuid())
  tenantId    String
  postingDate DateTime
  accountId   String
  debit       Decimal  @default(0) @db.Decimal(18, 4)
  credit      Decimal  @default(0) @db.Decimal(18, 4)
  // Voucher = the source document that posted this line.
  voucherType String // SalesInvoice | PurchaseInvoice | PaymentEntry | JournalEntry
  voucherId   String
  voucherName String? // e.g. SINV-0001, for display
  partyType   String? // Customer | Supplier
  partyId     String?
  remarks     String?
  isCancelled Boolean  @default(false)
  // Multi-company Phase 1: stamped at post time from either the account's
  // companyId or the tenant's defaultCompanyId. Null on legacy rows —
  // reports fall back to tenant default when filtering.
  companyId   String?
  createdAt   DateTime @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account          Account           @relation(fields: [accountId], references: [id])
  company          Company?          @relation("GLEntryCompany", fields: [companyId], references: [id])
  bankTransactions BankTransaction[] @relation("BankTxnMatch")

  @@index([tenantId, accountId, isCancelled])
  @@index([tenantId, voucherType, voucherId])
  @@index([tenantId, postingDate])
  @@index([tenantId, companyId, postingDate])
  @@map("gl_entries")
  @@schema("public")
}

// ---------- Bank reconciliation ----------
//
// Users import their bank's statement CSV, we auto-match each line against
// GL entries posted to that bank account, and let them manually resolve
// anything the algorithm couldn't. End-goal: every BankTransaction is either
// matched to a GLEntry or explicitly marked Ignored (bank fees the user
// hasn't booked yet, etc.).
//
// Import path: statement CSV → BankStatement + rows of BankTransaction.
// Match path: auto-match on (accountId, amount, date ±3 days). Manual
// override lets user pick from candidate GLEntries.

model BankStatement {
  id             String   @id @default(cuid())
  tenantId       String
  accountId      String // must be a leaf Account of rootType=Asset with "Bank" in name (soft-check)
  fileName       String
  fromDate       DateTime @db.Date
  toDate         DateTime @db.Date
  openingBalance Decimal  @db.Decimal(18, 4)
  closingBalance Decimal  @db.Decimal(18, 4)
  importedAt     DateTime @default(now())
  importedBy     String // userId

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account      Account           @relation("BankStatementAccount", fields: [accountId], references: [id])
  transactions BankTransaction[]

  @@index([tenantId, accountId, fromDate])
  @@map("bank_statements")
  @@schema("public")
}

model BankTransaction {
  id               String    @id @default(cuid())
  tenantId         String
  statementId      String
  transactionDate  DateTime  @db.Date
  description      String
  referenceNumber  String? // check #, wire reference, etc.
  // Signed amount from the bank's perspective: positive = money INTO the bank
  // account (deposit / credit), negative = money OUT (withdrawal / debit).
  amount           Decimal   @db.Decimal(18, 4)
  runningBalance   Decimal?  @db.Decimal(18, 4) // optional; some CSVs include it
  matchedGlEntryId String?
  // Unmatched | AutoSuggested (algo picked one, user hasn't confirmed) |
  // Matched (user confirmed or manual) | Ignored (user explicitly marked as
  // "not our problem" — e.g. bank fee they haven't booked).
  matchStatus      String    @default("Unmatched")
  reconciledAt     DateTime?
  reconciledBy     String?
  notes            String?
  createdAt        DateTime  @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  statement      BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  matchedGlEntry GLEntry?      @relation("BankTxnMatch", fields: [matchedGlEntryId], references: [id])

  @@index([tenantId, statementId])
  @@index([tenantId, matchStatus])
  @@index([matchedGlEntryId])
  @@map("bank_transactions")
  @@schema("public")
}

// ---------- Landed Cost Voucher ----------
//
// User paid freight/customs/duty/insurance separately (usually via a
// PurchaseInvoice or JournalEntry that debited an expense account). LCV
// retroactively CAPITALIZES those costs into the specific items received on
// one or more Purchase Receipts, bumping their bin valuation and moving the
// cost from expense to inventory.
//
// Submit posts GL: DR Stock-in-Hand (total allocated) / CR each source
// expense account (its share). Also writes valuation-only SLE rows
// (actualQty = 0, new valuationRate/stockValue reflecting the bump) and
// updates Bin.stockValue + Bin.valuationRate. Cancel reverses both.

model LandedCostVoucher {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // LCV-0001
  postingDate DateTime @default(now())
  status      String   @default("Draft") // Draft | Submitted | Cancelled
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseReceipts LandedCostVoucherReceipt[]
  taxes            LandedCostVoucherTax[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("landed_cost_vouchers")
  @@schema("public")
}

model LandedCostVoucherReceipt {
  id                  String @id @default(cuid())
  landedCostVoucherId String
  purchaseReceiptId   String

  voucher         LandedCostVoucher @relation(fields: [landedCostVoucherId], references: [id], onDelete: Cascade)
  purchaseReceipt PurchaseReceipt   @relation(fields: [purchaseReceiptId], references: [id])

  @@unique([landedCostVoucherId, purchaseReceiptId])
  @@index([landedCostVoucherId])
  @@map("landed_cost_voucher_receipts")
  @@schema("public")
}

model LandedCostVoucherTax {
  id                  String  @id @default(cuid())
  landedCostVoucherId String
  description         String // "Freight", "Customs Duty", "Insurance"
  // Where the cost was originally booked (usually an expense account) —
  // submitting the LCV credits this account and debits Stock-in-Hand.
  expenseAccountId    String
  amount              Decimal @db.Decimal(18, 4)

  voucher        LandedCostVoucher @relation(fields: [landedCostVoucherId], references: [id], onDelete: Cascade)
  expenseAccount Account           @relation("LCVTaxAccount", fields: [expenseAccountId], references: [id])

  @@index([landedCostVoucherId])
  @@map("landed_cost_voucher_taxes")
  @@schema("public")
}

// ---------- Stock: Delivery Note ----------
// Outbound stock document. Standalone for now (later: reference SalesInvoice).
// Submit: creates SLE (-qty at source warehouse) + posts GL
//   Debit  COGS           (qty * currentAvgRate)
//   Credit Stock-in-Hand  (same)

model DeliveryNote {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // DN-0001
  customerId  String
  postingDate DateTime @default(now())
  remarks     String?
  status      String   @default("Draft") // Draft | Submitted | Cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer           @relation(fields: [customerId], references: [id])
  items     DeliveryNoteItem[]
  tripStops DeliveryTripStop[] @relation("DNToTripStop")

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("delivery_notes")
  @@schema("public")
}

model DeliveryNoteItem {
  id                 String   @id @default(cuid())
  deliveryNoteId     String
  itemId             String
  warehouseId        String // source warehouse (stock leaves from here)
  qty                Decimal  @db.Decimal(18, 4)
  rate               Decimal  @default(0) @db.Decimal(18, 4) // billing rate (informational)
  // Back-link to the SO line this DN row fulfills, when convert-to-DN was used.
  salesOrderItemId   String?
  // C5: serial numbers being shipped. On DN submit each is validated
  // (Active + at this warehouse) and flipped to Delivered.
  serialNumbersInput String[] @default([])
  // C6: batch being shipped. Submit validates + decrements Batch.batchQty.
  batchNo            String?
  // C7: see PurchaseReceiptItem for semantics.
  uom                String?
  conversionFactor   Decimal? @db.Decimal(18, 6)
  stockQty           Decimal? @db.Decimal(18, 4)

  deliveryNote       DeliveryNote        @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  item               Item                @relation(fields: [itemId], references: [id])
  warehouse          Warehouse           @relation("DNItemWarehouse", fields: [warehouseId], references: [id])
  salesOrderItem     SalesOrderItem?     @relation("SOItemToDNLine", fields: [salesOrderItemId], references: [id])
  siLines            SalesInvoiceItem[]  @relation("DNItemToSILine")
  pickListItems      PickListItem[]      @relation("DNItemToPickListItem")
  serialNumbers      SerialNo[]          @relation("SerialNoDNItem")
  qualityInspections QualityInspection[] @relation("QIForDNItem")

  @@index([deliveryNoteId])
  @@index([salesOrderItemId])
  @@map("delivery_note_items")
  @@schema("public")
}

// ---------- Selling/Buying: Blanket Order (Module 50) ----------
//
// A Blanket Order is a long-term supply or sales agreement:
// customer/supplier commits to a total quantity over a validity
// window at agreed rates. Individual SOs (selling variant) or POs
// (buying variant) are then filed against the blanket, drawing
// down its running balance. The blanket header + line items are
// symmetric across buying/selling (differentiated by `blanketType`
// and either supplierId or customerId).
//
// Semantics:
//   * blanketType = "Selling" → customer-side agreement, drawn down
//     by Sales Orders.
//   * blanketType = "Buying"  → supplier-side agreement, drawn down
//     by Purchase Orders.
//   * item.orderedQty tracks the sum of qty drawn across all linked
//     SO/PO lines. When orderedQty >= qty on every line, blanket
//     auto-completes.
//   * validFrom / validTill bound the drawdown window.

model BlanketOrder {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // BO-0001
  blanketType String // "Selling" | "Buying"
  customerId  String? // set when blanketType=Selling
  supplierId  String? // set when blanketType=Buying
  validFrom   DateTime @db.Date
  validTill   DateTime @db.Date
  currency    String   @default("INR")
  status      String   @default("Draft") // Draft | Active | Completed | Cancelled | Expired
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer?          @relation("BlanketOrderCustomer", fields: [customerId], references: [id])
  supplier Supplier?          @relation("BlanketOrderSupplier", fields: [supplierId], references: [id])
  items    BlanketOrderItem[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("blanket_orders")
  @@schema("public")
}

model BlanketOrderItem {
  id             String  @id @default(cuid())
  blanketOrderId String
  itemId         String
  qty            Decimal @db.Decimal(18, 4) // total committed
  rate           Decimal @db.Decimal(18, 4) // agreed rate
  // Cumulative qty drawn by linked SO/PO lines. Updated at SO/PO
  // submit; decremented at cancel. When orderedQty >= qty on every
  // row, the parent blanket auto-flips to Completed.
  orderedQty     Decimal @default(0) @db.Decimal(18, 4)
  description    String?

  blanketOrder BlanketOrder @relation(fields: [blanketOrderId], references: [id], onDelete: Cascade)
  item         Item         @relation("BlanketOrderItemItem", fields: [itemId], references: [id])

  @@index([blanketOrderId])
  @@map("blanket_order_items")
  @@schema("public")
}

// ---------- Stock: Pick List (Module 47) ----------
//
// A PickList aggregates the item lines of N Draft/Submitted DNs into a
// single warehouse-walk sheet. The pick worker follows the sheet through
// the warehouse, ticks off each row as they collect the qty, and returns
// to the pack station. Rows are per (item, warehouse) — sorted by
// warehouse code so the walk is efficient across shelves.
//
// Lifecycle: Draft (aggregation preview) → Submitted (frozen; DNs
// locked to this list) → Completed (all rows picked) → Cancelled.
//
// Design notes:
//   * Pick lists don't move stock — DN submit still does that. PickList
//     is purely operational (which SKU/qty/shelf to visit).
//   * Multiple DNs can be on one PickList (typical batch flow).
//   * A DN can only be on one non-cancelled PickList at a time —
//     enforced via a partial index + application check.

model PickList {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // PICK-0001
  purpose     String   @default("Delivery") // Delivery | Material Transfer | Manufacture
  postingDate DateTime @default(now())
  // Person walking the warehouse. Free-text for v1 (no Employee FK yet
  // — many pick jobs go to contractors / temp staff who aren't in the
  // Employee master).
  pickedBy    String?
  status      String   @default("Draft") // Draft | Submitted | Completed | Cancelled
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  PickListItem[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("pick_lists")
  @@schema("public")
}

model PickListItem {
  id                 String   @id @default(cuid())
  pickListId         String
  // Backlink to the source DN line. Every PickListItem originates from
  // exactly one DN line — no aggregation across DNs into a single row,
  // so the pick worker sees each customer's order distinctly.
  deliveryNoteItemId String
  itemId             String
  warehouseId        String
  qty                Decimal  @db.Decimal(18, 4)
  // Ticks off as picked. Defaults to qty on submit for the "already
  // picked at time of submit" case; scanner UI decrements as workers
  // scan barcodes.
  pickedQty          Decimal  @default(0) @db.Decimal(18, 4)
  // Optional per-row batch/serial hint — pulled from DN's batchNo /
  // serialNumbersInput at aggregate time so the pick worker knows
  // exactly which batch/serials to grab.
  batchNo            String?
  serialNos          String[] @default([])

  pickList         PickList         @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  deliveryNoteItem DeliveryNoteItem @relation("DNItemToPickListItem", fields: [deliveryNoteItemId], references: [id])
  item             Item             @relation("PickListItemItem", fields: [itemId], references: [id])
  warehouse        Warehouse        @relation("PickListItemWarehouse", fields: [warehouseId], references: [id])

  @@index([pickListId])
  @@index([deliveryNoteItemId])
  @@map("pick_list_items")
  @@schema("public")
}

// ---------- Stock: Delivery Trip (Module 47) ----------
//
// A DeliveryTrip groups outgoing DNs into a driver's route. Each stop
// is one DN's delivery address; the trip is ordered by the operator
// (drag-drop in UI) or by a simple distance heuristic (future). Trip
// status tracks the driver's day: Scheduled → InProgress → Completed.
// Per-stop status tracks each dropoff.

model DeliveryTrip {
  id             String    @id @default(cuid())
  tenantId       String
  name           String // TRIP-0001
  driverName     String?
  vehicleNo      String?
  // Trip window — operator schedules a departure time; each stop
  // stamps its own arrival time when completed.
  scheduledStart DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  status         String    @default("Scheduled") // Scheduled | InProgress | Completed | Cancelled
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stops  DeliveryTripStop[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("delivery_trips")
  @@schema("public")
}

model DeliveryTripStop {
  id               String    @id @default(cuid())
  deliveryTripId   String
  // DN being delivered at this stop.
  deliveryNoteId   String
  // Route order (1-indexed). Rendered as the stop number on the driver
  // sheet. Uniqueness within a trip enforced.
  sequence         Int
  // Snapshot of the customer + address at stop-creation time so a
  // later customer edit doesn't confuse the driver's printed sheet.
  customerName     String
  addressLine      String?
  // Per-stop lifecycle.
  status           String    @default("Pending") // Pending | Arrived | Delivered | Failed
  arrivedAt        DateTime?
  completedAt      DateTime?
  // Recipient signature / OTP capture (base64 image or hash — v1 leaves
  // this as a free-text field for the driver app to fill).
  signatureCapture String?
  notes            String?

  deliveryTrip DeliveryTrip @relation(fields: [deliveryTripId], references: [id], onDelete: Cascade)
  deliveryNote DeliveryNote @relation("DNToTripStop", fields: [deliveryNoteId], references: [id])

  @@unique([deliveryTripId, sequence])
  @@unique([deliveryTripId, deliveryNoteId])
  @@index([deliveryTripId])
  @@map("delivery_trip_stops")
  @@schema("public")
}

// ---------- Stock: Purchase Receipt ----------
// Inbound stock document. Standalone for now (later: reference PurchaseInvoice).
// Submit: creates SLE (+qty at target warehouse, incoming rate = line.rate)
//   + posts GL:
//     Debit  Stock-in-Hand                     (qty * rate)
//     Credit Stock Received But Not Billed     (same) — becomes Creditors once
//                                                       the matching invoice is booked.

// ---------- Stock: Material Request (C2) ----------
// An internal request for materials — can convert to a Purchase Order
// (Purchase type) or a Stock Entry (Transfer/Issue) or a Work Order
// (Manufacture). No stock/GL impact until the downstream doc is created.
// Lifecycle: Draft → Submitted → Ordered → Received | Cancelled.
//   Ordered  = at least one line converted to PO/SE (partially or fully).
//   Received = orderedQty ≥ qty across all lines (auto-flip on PR/SE submit).

model MaterialRequest {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String // MR-0001
  materialRequestType String    @default("Purchase") // Purchase | Material Transfer | Material Issue | Manufacture
  transactionDate     DateTime  @default(now())
  requiredDate        DateTime?
  status              String    @default("Draft") // Draft | Submitted | Ordered | Received | Cancelled
  remarks             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  MaterialRequestItem[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("material_requests")
  @@schema("public")
}

model MaterialRequestItem {
  id                String    @id @default(cuid())
  materialRequestId String
  itemId            String
  qty               Decimal   @db.Decimal(18, 4)
  warehouseId       String? // target warehouse
  requiredDate      DateTime?
  // Cumulative qty already sourced via linked POs (for Purchase MRs) or
  // Stock Entries (for Transfer/Issue MRs). Updated on downstream submit +
  // decremented on cancel. When orderedQty ≥ qty across all lines, MR flips
  // to Received.
  orderedQty        Decimal   @default(0) @db.Decimal(18, 4)
  description       String?

  materialRequest MaterialRequest     @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  item            Item                @relation("MRItemItem", fields: [itemId], references: [id])
  warehouse       Warehouse?          @relation("MRItemWarehouse", fields: [warehouseId], references: [id])
  poLines         PurchaseOrderItem[] @relation("MRItemToPOLine")
  rfqLines        RFQItem[]           @relation("MRItemToRFQLine")

  @@index([materialRequestId])
  @@map("material_request_items")
  @@schema("public")
}

// ---------- Stock: Stock Reconciliation (C3) ----------
// Physical stock-count adjustment. User counts warehouse stock, records
// (currentQty, currentRate, countedQty, countedRate) per (item, warehouse),
// submit generates SLEs for the delta + a valuation-delta GL post to
// Stock in Hand / Stock Adjustment.

model StockReconciliation {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // SR-0001
  postingDate DateTime @default(now())
  purpose     String   @default("Stock Reconciliation") // Stock Reconciliation | Opening Stock
  remarks     String?
  status      String   @default("Draft") // Draft | Submitted | Cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  StockReconciliationItem[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("stock_reconciliations")
  @@schema("public")
}

model StockReconciliationItem {
  id                    String   @id @default(cuid())
  stockReconciliationId String
  itemId                String
  warehouseId           String
  // Snapshot of bin state at line-add time (informational; not used at post).
  currentQty            Decimal  @default(0) @db.Decimal(18, 4)
  currentValuationRate  Decimal  @default(0) @db.Decimal(18, 4)
  // What the user counted / valuation to apply. countedRate is optional —
  // when null we keep the existing valuation rate.
  countedQty            Decimal  @db.Decimal(18, 4)
  countedValuationRate  Decimal? @db.Decimal(18, 4)

  stockReconciliation StockReconciliation @relation(fields: [stockReconciliationId], references: [id], onDelete: Cascade)
  item                Item                @relation("SRItemItem", fields: [itemId], references: [id])
  warehouse           Warehouse           @relation("SRItemWarehouse", fields: [warehouseId], references: [id])

  @@index([stockReconciliationId])
  @@map("stock_reconciliation_items")
  @@schema("public")
}

// ---------- Buying: Request for Quotation (Module 45) ----------
//
// RFQ is the pre-PO negotiation phase: buyer specifies what they need
// + optional MaterialRequest source lines, invites N suppliers, each
// supplier responds with a SupplierQuotation, buyer compares + awards.
// Award auto-creates a PurchaseOrder against the winning quote.
//
// Lifecycle:
//   Draft → Submitted (invitations "sent" — email hook is a future
//   pass; today the buyer flags Submitted and shares the RFQ number
//   with suppliers manually or via portal-web).
//   Submitted → Awarded (buyer clicks Award on a supplier quote,
//   which stamps `awardedSupplierQuotationId` + creates the PO).
//   Any → Cancelled at any time.
//
// Multi-tenant + audited via the standard middleware.

model RequestForQuotation {
  id                         String    @id @default(cuid())
  tenantId                   String
  name                       String // RFQ-0001
  transactionDate            DateTime  @default(now())
  // Deadline for supplier responses. UI + list views flag past-due RFQs.
  responseDueDate            DateTime?
  // Free-form buyer's message shown on the shared/printed RFQ.
  message                    String?
  status                     String    @default("Draft") // Draft | Submitted | Awarded | Cancelled
  // When Awarded, points at the winning SupplierQuotation and the PO
  // that was auto-generated.
  awardedSupplierQuotationId String?   @unique
  awardedPurchaseOrderId     String?   @unique
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  tenant                   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items                    RFQItem[]
  suppliers                RFQSupplier[]
  quotations               SupplierQuotation[]
  awardedSupplierQuotation SupplierQuotation?  @relation("RFQAwardedSQ", fields: [awardedSupplierQuotationId], references: [id])
  awardedPurchaseOrder     PurchaseOrder?      @relation("RFQAwardedPO", fields: [awardedPurchaseOrderId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("request_for_quotations")
  @@schema("public")
}

// One line per item the buyer wants quoted. Suppliers respond with a
// SupplierQuotationItem per RFQ line (same itemId + qty; the supplier
// sets rate + optional lead time).
model RFQItem {
  id                    String  @id @default(cuid())
  rfqId                 String
  itemId                String
  qty                   Decimal @db.Decimal(18, 4)
  // Optional link back to the MR line that spawned this row. Lets the
  // buyer trace "which RFQs sourced this material request" and lets
  // MRItem.orderedQty stay accurate once the awarded PO submits.
  materialRequestItemId String?
  description           String?

  rfq                 RequestForQuotation     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  item                Item                    @relation("RFQItemItem", fields: [itemId], references: [id])
  materialRequestItem MaterialRequestItem?    @relation("MRItemToRFQLine", fields: [materialRequestItemId], references: [id])
  quotationItems      SupplierQuotationItem[]

  @@index([rfqId])
  @@map("rfq_items")
  @@schema("public")
}

// One row per supplier invited. The RFQ can invite N suppliers; each
// responds with a SupplierQuotation (or doesn't). Status tracks response.
model RFQSupplier {
  id             String    @id @default(cuid())
  rfqId          String
  supplierId     String
  // Snapshot at invite time so a later supplier rename doesn't confuse
  // the RFQ audit trail.
  supplierName   String
  // "Invited" until the supplier files a SQ; "Quoted" once one exists;
  // "Declined" if the supplier explicitly rejected (future flow).
  responseStatus String    @default("Invited") // Invited | Quoted | Declined
  respondedAt    DateTime?
  createdAt      DateTime  @default(now())

  rfq      RequestForQuotation @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation("RFQSupplierSupplier", fields: [supplierId], references: [id])

  @@unique([rfqId, supplierId])
  @@index([rfqId])
  @@map("rfq_suppliers")
  @@schema("public")
}

// ---------- Buying: Supplier Quotation (Module 45) ----------
//
// A supplier's response to an RFQ. Contains one line per RFQ item with
// the quoted rate, optional lead time, and optional per-line notes.
// Multiple SupplierQuotations can exist for the same RFQ (one per
// invited supplier). Only one is Awarded; the others are Rejected
// (soft — kept for audit).
model SupplierQuotation {
  id              String    @id @default(cuid())
  tenantId        String
  name            String // SQ-0001
  rfqId           String
  supplierId      String
  transactionDate DateTime  @default(now())
  validTill       DateTime?
  currency        String    @default("INR")
  conversionRate  Decimal   @default(1) @db.Decimal(18, 6)
  netTotal        Decimal   @default(0) @db.Decimal(18, 4)
  remarks         String?
  status          String    @default("Draft") // Draft | Submitted | Awarded | Rejected | Cancelled
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfq           RequestForQuotation     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier      Supplier                @relation("SQSupplier", fields: [supplierId], references: [id])
  items         SupplierQuotationItem[]
  awardedForRfq RequestForQuotation?    @relation("RFQAwardedSQ")

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([rfqId, supplierId])
  @@map("supplier_quotations")
  @@schema("public")
}

model SupplierQuotationItem {
  id                  String  @id @default(cuid())
  supplierQuotationId String
  // Backlink to the RFQ line this quote is for. Enables the compare-
  // quotes UI to align supplier bids side-by-side per RFQ item.
  rfqItemId           String
  itemId              String
  qty                 Decimal @db.Decimal(18, 4)
  rate                Decimal @db.Decimal(18, 4)
  amount              Decimal @db.Decimal(18, 4)
  // Supplier's promised delivery-lead time in days. Optional; used in
  // the compare UI to surface trade-offs (cheaper vs faster).
  leadTimeDays        Int?
  notes               String?

  supplierQuotation SupplierQuotation @relation(fields: [supplierQuotationId], references: [id], onDelete: Cascade)
  rfqItem           RFQItem           @relation(fields: [rfqItemId], references: [id])
  item              Item              @relation("SQItemItem", fields: [itemId], references: [id])

  @@index([supplierQuotationId])
  @@index([rfqItemId])
  @@map("supplier_quotation_items")
  @@schema("public")
}

// ---------- Buying: Supplier Scorecard (Module 46) ----------
//
// One scorecard per supplier per tenant, holding a weighted mix of
// scoring criteria and a rolling history of computed periods. Latest
// numbers cached on the scorecard row itself so the RFQ compare UI +
// supplier list can render without joining the periods table.
//
// Scoring criteria (v1 — extensible by adding more `formula` cases in
// packages/db/src/supplier-scorecard.ts):
//   * OnTimeDelivery — % of PRs received on-or-before their PO's
//     deliveryDate, within the period window.
//   * Fulfillment    — Σ received qty / Σ ordered qty across all POs
//     with lines that received in the period.
//   * ResponseRate   — % of RFQs the supplier was invited to during
//     the period that they actually filed a quote for.
//
// Standing derives from score (0-100):
//   90+ Very Good · 75+ Good · 50+ Average · 25+ Poor · else Very Poor
//
// Recomputation: scheduler tick walks isActive scorecards weekly (see
// services/scheduler/src/jobs/supplier-scorecard.ts). Manual recompute
// available via POST /supplier-scorecards/:id/recompute.

model SupplierScorecard {
  id               String    @id @default(cuid())
  tenantId         String
  supplierId       String
  name             String
  // Period length used for auto-recompute. "Monthly" or "Quarterly".
  period           String    @default("Monthly")
  isActive         Boolean   @default(true)
  // Cached: latest scored period. Denormalized so the RFQ compare +
  // supplier list don't need to join periods. Refreshed by recompute.
  latestScore      Decimal?  @db.Decimal(6, 2)
  latestStanding   String?
  latestScoredAsOf DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier                     @relation("SupplierScorecardSupplier", fields: [supplierId], references: [id])
  criteria SupplierScorecardCriterion[]
  periods  SupplierScorecardPeriod[]

  @@unique([tenantId, supplierId])
  @@index([tenantId, isActive])
  @@map("supplier_scorecards")
  @@schema("public")
}

model SupplierScorecardCriterion {
  id          String  @id @default(cuid())
  scorecardId String
  formula     String // "OnTimeDelivery" | "Fulfillment" | "ResponseRate"
  // Weight in percentage points. Sum of weights across all criteria on
  // a scorecard should be 100; the compute helper renormalizes if not
  // to keep the total score bounded at [0, 100].
  weight      Decimal @db.Decimal(6, 2)

  scorecard SupplierScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, formula])
  @@map("supplier_scorecard_criteria")
  @@schema("public")
}

model SupplierScorecardPeriod {
  id          String   @id @default(cuid())
  scorecardId String
  fromDate    DateTime
  toDate      DateTime
  computedAt  DateTime @default(now())
  score       Decimal  @db.Decimal(6, 2)
  standing    String
  // JSON: { OnTimeDelivery: 92.5, Fulfillment: 88.0, ... }. Handy for
  // the detail UI to render per-criterion bars without recomputing.
  breakdown   Json

  scorecard SupplierScorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)

  @@unique([scorecardId, fromDate, toDate])
  @@index([scorecardId, computedAt])
  @@map("supplier_scorecard_periods")
  @@schema("public")
}

// ---------- Buying: Purchase Order (C1) ----------
// A PO is an intent to buy — no stock/GL impact until receipt (PR) or bill
// (PI). Lifecycle: Draft → Submitted → To Receive → Completed / Cancelled.
// PR-linked lines auto-tally `receivedQty` on the PO item; the PO auto-flips
// to Completed once every line is fully received.

model PurchaseOrder {
  id                      String    @id @default(cuid())
  tenantId                String
  name                    String // PO-0001
  supplierId              String
  transactionDate         DateTime  @default(now())
  deliveryDate            DateTime?
  currency                String    @default("INR")
  conversionRate          Decimal   @default(1) @db.Decimal(18, 6)
  netTotal                Decimal   @default(0) @db.Decimal(18, 4)
  totalTaxes              Decimal   @default(0) @db.Decimal(18, 4)
  grandTotal              Decimal   @default(0) @db.Decimal(18, 4)
  taxTemplateId           String?
  remarks                 String?
  status                  String    @default("Draft") // Draft | Submitted | To Receive | Completed | Cancelled
  // C10: subcontracted PO — on submit, transfers per-line-item RM (from the
  // FG's default BOM) from `sourceWarehouseId` → `supplierWarehouseId` as a
  // Material Transfer Stock Entry. `subcontractedTransferId` records the SE
  // so cancel can reverse it.
  isSubcontracted         Boolean   @default(false)
  supplierWarehouseId     String?
  sourceWarehouseId       String?
  subcontractedTransferId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier          Supplier             @relation(fields: [supplierId], references: [id])
  taxTemplate       TaxTemplate?         @relation("POTaxTemplate", fields: [taxTemplateId], references: [id])
  items             PurchaseOrderItem[]
  taxes             PurchaseOrderTax[]
  supplierWarehouse Warehouse?           @relation("POSupplierWH", fields: [supplierWarehouseId], references: [id])
  sourceWarehouse   Warehouse?           @relation("POSourceWH", fields: [sourceWarehouseId], references: [id])
  awardedFromRfq    RequestForQuotation? @relation("RFQAwardedPO")

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
  @@schema("public")
}

model PurchaseOrderItem {
  id                     String  @id @default(cuid())
  purchaseOrderId        String
  itemId                 String
  qty                    Decimal @db.Decimal(18, 4)
  rate                   Decimal @db.Decimal(18, 4)
  amount                 Decimal @db.Decimal(18, 4)
  // Per-line target warehouse (auto-used when converting to PR).
  warehouseId            String?
  // Cumulative received qty across all linked PRs. Updated at PR submit;
  // decremented at PR cancel. When receivedQty ≥ qty on every line, PO flips
  // to Completed.
  receivedQty            Decimal @default(0) @db.Decimal(18, 4)
  description            String?
  taxTemplateId          String? // per-line tax override (B11 mirror)
  // C2: backlink to MR line — tally MRItem.orderedQty on PO submit.
  materialRequestItemId  String?
  // Dropshipping: backlink to the SO line that spawned this PO line via
  // auto-create on SO submit. Null for normal (staff-created) POs.
  sourceSalesOrderLineId String?

  purchaseOrder        PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item                 Item                  @relation("POItemItem", fields: [itemId], references: [id])
  warehouse            Warehouse?            @relation("POItemWarehouse", fields: [warehouseId], references: [id])
  taxTemplate          TaxTemplate?          @relation("POItemLineTax", fields: [taxTemplateId], references: [id])
  prLines              PurchaseReceiptItem[] @relation("POItemToPRLine")
  materialRequestItem  MaterialRequestItem?  @relation("MRItemToPOLine", fields: [materialRequestItemId], references: [id])
  sourceSalesOrderLine SalesOrderItem?       @relation("POItemToSourceSOLine", fields: [sourceSalesOrderLineId], references: [id])

  @@index([purchaseOrderId])
  @@index([materialRequestItemId])
  @@index([sourceSalesOrderLineId])
  @@map("purchase_order_items")
  @@schema("public")
}

model PurchaseOrderTax {
  id              String  @id @default(cuid())
  purchaseOrderId String
  description     String
  rate            Decimal @db.Decimal(9, 4)
  taxAmount       Decimal @db.Decimal(18, 4)
  accountId       String
  taxTemplateId   String?
  chargeType      String  @default("On Net Total")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  account       Account       @relation("POTaxAccount", fields: [accountId], references: [id])
  taxTemplate   TaxTemplate?  @relation(fields: [taxTemplateId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_taxes")
  @@schema("public")
}

model PurchaseReceipt {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String // PR-0001
  supplierId         String
  supplierDeliveryNo String?
  postingDate        DateTime @default(now())
  remarks            String?
  status             String   @default("Draft") // Draft | Submitted | Cancelled
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier           Supplier                   @relation(fields: [supplierId], references: [id])
  items              PurchaseReceiptItem[]
  landedCostVouchers LandedCostVoucherReceipt[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_receipts")
  @@schema("public")
}

model PurchaseReceiptItem {
  id                  String    @id @default(cuid())
  purchaseReceiptId   String
  itemId              String
  warehouseId         String // target warehouse
  qty                 Decimal   @db.Decimal(18, 4)
  rate                Decimal   @default(0) @db.Decimal(18, 4) // valuation input
  // C1: backlink to PO line — auto-tallies POItem.receivedQty on PR submit.
  purchaseOrderItemId String?
  // C5: intent-snapshot of serial numbers entered on the Draft PR. On submit,
  // one SerialNo row per entry is created + linked back to this PRItem. Empty
  // array for non-serialized items.
  serialNumbersInput  String[]  @default([])
  // C6: batch info entered on the Draft PR. Submit upserts the Batch row for
  // (tenantId, itemId, batchNo) and adds this line's qty to batchQty.
  batchNo             String?
  manufactureDate     DateTime?
  expiryDate          DateTime?
  // C7: transaction UOM (may differ from item.stockUom). `stockQty` =
  // qty × conversionFactor and is what SLE/Bin math uses. Both null =
  // qty is already in stock UOM (conversion factor = 1).
  uom                 String?
  conversionFactor    Decimal?  @db.Decimal(18, 6)
  stockQty            Decimal?  @db.Decimal(18, 4)

  purchaseReceipt    PurchaseReceipt       @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  item               Item                  @relation(fields: [itemId], references: [id])
  warehouse          Warehouse             @relation("PRItemWarehouse", fields: [warehouseId], references: [id])
  piLines            PurchaseInvoiceItem[] @relation("PRItemToPILine")
  purchaseOrderItem  PurchaseOrderItem?    @relation("POItemToPRLine", fields: [purchaseOrderItemId], references: [id])
  serialNumbers      SerialNo[]            @relation("SerialNoPRItem")
  qualityInspections QualityInspection[]   @relation("QIForPRItem")

  @@index([purchaseReceiptId])
  @@index([purchaseOrderItemId])
  @@map("purchase_receipt_items")
  @@schema("public")
}

// ---------- Manufacturing: BOM ----------
// A recipe: producing `qty` of `productionItem` requires the child BOMItems.
// One item may have many BOMs (versions); one is default.

model BOM {
  id               String    @id @default(cuid())
  tenantId         String
  name             String // BOM-Widget-01-001
  productionItemId String
  qty              Decimal   @default(1) @db.Decimal(18, 4) // FG units this BOM yields
  uom              String    @default("Nos")
  isActive         Boolean   @default(true)
  isDefault        Boolean   @default(true)
  // C13: cached total cost of the BOM = Σ(BOMItem.amount) + Σ(BOMOperation
  // labour cost). Refreshed by the BOM Update tool; not used at manufacture
  // time (manufacture consumes RM at live bin rate).
  totalCost        Decimal   @default(0) @db.Decimal(18, 4)
  costUpdatedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productionItem Item           @relation("BOMFinishedGood", fields: [productionItemId], references: [id])
  items          BOMItem[]
  operations     BOMOperation[]
  workOrders     WorkOrder[]

  @@unique([tenantId, name])
  @@index([tenantId, productionItemId, isActive])
  @@map("boms")
  @@schema("public")
}

model BOMItem {
  id     String  @id @default(cuid())
  bomId  String
  itemId String
  qty    Decimal @db.Decimal(18, 4)
  uom    String  @default("Nos")
  // C13: snapshot cost per stock unit (refreshed by BOM Update tool). Bin
  // valuation rate at update-time. `amount = qty × rate`.
  rate   Decimal @default(0) @db.Decimal(18, 4)
  amount Decimal @default(0) @db.Decimal(18, 4)

  bom  BOM  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item Item @relation("BOMRawMaterial", fields: [itemId], references: [id])

  @@index([bomId])
  @@map("bom_items")
  @@schema("public")
}

// ---------- Manufacturing: Work Order ----------
// Produces `qty` of `productionItem` using `bom`. Manufacture action consumes
// raw materials from `sourceWarehouse` and produces FG into `targetWarehouse`,
// in whole or in partial batches. producedQty tracks cumulative production;
// status flips to Completed when it reaches qty.

model WorkOrder {
  id                String   @id @default(cuid())
  tenantId          String
  name              String // WO-0001
  bomId             String
  productionItemId  String
  qty               Decimal  @db.Decimal(18, 4)
  producedQty       Decimal  @default(0) @db.Decimal(18, 4)
  sourceWarehouseId String
  targetWarehouseId String
  status            String   @default("Not Started") // Not Started | In Process | Completed | Cancelled
  remarks           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bom             BOM                  @relation(fields: [bomId], references: [id])
  productionItem  Item                 @relation("WOFinishedGood", fields: [productionItemId], references: [id])
  sourceWarehouse Warehouse            @relation("WOSourceWH", fields: [sourceWarehouseId], references: [id])
  targetWarehouse Warehouse            @relation("WOTargetWH", fields: [targetWarehouseId], references: [id])
  operations      WorkOrderOperation[]
  jobCards        JobCard[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("work_orders")
  @@schema("public")
}

// ---------- CRM: Lead ----------
// A prospect who might become a customer. Convert action creates a Customer.

model Lead {
  id                  String   @id @default(cuid())
  tenantId            String
  name                String // LEAD-0001
  leadName            String
  companyName         String?
  email               String?
  mobile              String?
  status              String   @default("Open") // Open | Contacted | Interested | Converted | Lost
  source              String?
  remarks             String?
  convertedCustomerId String?
  // Score updated by /leads/:id/score (manual) or by the recompute-all
  // route after a LeadScoreRule change. Higher = hotter.
  score               Int      @default(0)
  scoredAt            DateTime?
  // D8: campaign attribution.
  campaignId          String?
  // I5: extensibility bag validated by CustomField meta on write.
  customData          Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  convertedCustomer Customer?      @relation("LeadConvertedCustomer", fields: [convertedCustomerId], references: [id])
  opportunities     Opportunity[]  @relation("OpportunityLead")
  quotations        Quotation[]    @relation("QuotationLead")
  campaign          Campaign?      @relation("LeadCampaign", fields: [campaignId], references: [id])
  salesEnquiries    SalesEnquiry[] @relation("SalesEnquiryLead")

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, score])
  @@map("leads")
  @@schema("public")
}

// ---------- CRM: Lead Scoring rules ----------
//
// Simple rule-based scorer. Each rule matches a field (dot-path into
// Lead + customData), compares with an operator, and awards `points`
// when true. `applyMode` controls whether a rule's points ADD on match
// or SUBTRACT (useful for negative scoring: e.g. gmail email → -5).
//
// Aggregation: final Lead.score = sum(matching rule points). Recompute
// runs on-demand (POST /leads/:id/score) or after a rule mutation
// (POST /lead-score-rules/recompute-all).
model LeadScoreRule {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  fieldPath String // "email" | "source" | "customData.industry" | ...
  operator  String // eq | neq | contains | present | absent | gt | lt
  value     String? // compared as string; operators coerce as needed
  points    Int      @default(0)
  applyMode String   @default("Add") // Add | Subtract
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, enabled])
  @@map("lead_score_rules")
  @@schema("public")
}

// ---------- CRM: Activity (unified timeline entry) ----------
//
// One row per Task / Call / Meeting / Note / Email attached to any CRM
// record. Polymorphic via (parentType, parentId) so we can attach the same
// row shape to Leads, Opportunities, Customers, Deals, SalesOrders — and
// still render one merged timeline per record.
//
// Type-specific columns are all nullable — a Task uses `priority + status +
// dueDate`, a Call uses `callDirection + callDuration + phoneNumber`, a
// Meeting uses `startAt + endAt + location + meetingUrl`, a Note uses just
// `subject + description`, an Email uses `emailFrom + emailTo + emailCc`.
// Keeps every activity queryable in one shot for timeline views; sub-tables
// would force a UNION.
model CrmActivity {
  id          String  @id @default(cuid())
  tenantId    String
  type        String // Task | Call | Meeting | Note | Email
  subject     String
  description String?

  // Polymorphic parent — the CRM record this activity is attached to.
  parentType String // Lead | Opportunity | Customer | Deal | SalesOrder | Quotation
  parentId   String

  // Task-specific
  priority    String? // Low | Medium | High
  status      String    @default("Open") // Open | Completed | Cancelled | Overdue
  dueDate     DateTime?
  completedAt DateTime?

  // Call-specific
  callDirection String? // Inbound | Outbound
  callDuration  Int? // seconds
  callOutcome   String? // Answered | NoAnswer | Busy | Voicemail | WrongNumber
  phoneNumber   String?

  // Meeting-specific
  startAt    DateTime?
  endAt      DateTime?
  location   String?
  meetingUrl String? // Zoom / Meet / Teams link

  // Email-specific (usually auto-populated on Send)
  emailFrom String?
  emailTo   String?
  emailCc   String?

  // Ownership
  ownerUserId    String // who logged it
  assigneeUserId String? // who owns the follow-up (may differ)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, parentType, parentId, dueDate])
  @@index([tenantId, ownerUserId, status])
  @@index([tenantId, type, dueDate])
  @@map("crm_activities")
  @@schema("public")
}

// ---------- CRM: Opportunity ----------

model Opportunity {
  id                String    @id @default(cuid())
  tenantId          String
  name              String // OPP-0001
  partyType         String // Lead | Customer
  leadId            String?
  customerId        String?
  expectedAmount    Decimal   @default(0) @db.Decimal(18, 4)
  expectedCloseDate DateTime?
  status            String    @default("Open") // Open | Quotation | Converted | Lost
  source            String?
  remarks           String?
  campaignId        String?
  customData        Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead       Lead?       @relation("OpportunityLead", fields: [leadId], references: [id])
  customer   Customer?   @relation("OpportunityCustomer", fields: [customerId], references: [id])
  campaign   Campaign?   @relation("OpportunityCampaign", fields: [campaignId], references: [id])
  quotations Quotation[] @relation("OpportunityQuotation")

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("opportunities")
  @@schema("public")
}

// ---------- CRM: Pipeline Blueprints ----------
//
// Guardrails on status transitions for a doctype. Each blueprint is a
// per-tenant, per-doctype directed graph of statuses; each stage
// declares mandatory fields that must be non-null before a record can
// LEAVE that stage. Applied by the routes on status update — reject
// with a list of missing fields.
//
// Only one active blueprint per (tenantId, doctype). Draft blueprints
// can coexist. Disabling active = no enforcement (soft off-ramp).
//
// v1 scope: only checks record-field presence (nested via dot path
// against the record + its customData). Later versions can add:
//   • per-stage assigned-user requirements
//   • time-in-stage limits with SLA escalation
//   • per-transition role checks
model PipelineBlueprint {
  id          String   @id @default(cuid())
  tenantId    String
  doctype     String // "Opportunity" | "Lead" | ...
  name        String
  description String?
  active      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineBlueprintStage[]

  @@unique([tenantId, doctype, name])
  @@index([tenantId, doctype, active])
  @@map("pipeline_blueprints")
  @@schema("public")
}

// A single stage in a blueprint. `requiredFields` is a JSON array of
// dot-path strings evaluated against the record (missing/null/""
// counts as unset). `allowedNext` is a JSON array of stage `key`s the
// record may transition TO from here (empty = terminal).
model PipelineBlueprintStage {
  id             String   @id @default(cuid())
  blueprintId    String
  stageKey       String // matches the record.status value
  label          String
  sortOrder      Int      @default(0)
  requiredFields Json     @default("[]") // dot-paths on the record
  allowedNext    Json     @default("[]") // stage keys reachable from here
  createdAt      DateTime @default(now())

  blueprint PipelineBlueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, stageKey])
  @@map("pipeline_blueprint_stages")
  @@schema("public")
}

// ---------- CRM: Quotation ----------

model Quotation {
  id               String    @id @default(cuid())
  tenantId         String
  name             String // QTN-0001
  partyType        String // Lead | Customer
  leadId           String?
  customerId       String?
  quotationDate    DateTime  @default(now())
  validTill        DateTime?
  currency         String    @default("INR")
  netTotal         Decimal   @default(0) @db.Decimal(18, 4)
  // B9: tax on Quote. Same pattern as SI — snapshot template rows onto
  // child QuotationTax rows at create/PUT time so future template edits
  // don't rewrite history.
  taxTemplateId    String?
  totalTaxes       Decimal   @default(0) @db.Decimal(18, 4)
  grandTotal       Decimal   @default(0) @db.Decimal(18, 4)
  status           String    @default("Draft") // Draft | Submitted | Ordered | Lost | Expired | Cancelled
  remarks          String?
  customData       Json?
  // D9: follow-up + lost-reason tracking.
  nextFollowUpDate DateTime?
  lostReason       String?
  // Back-reference to the source Opportunity (set by /opportunities/:id/
  // convert-to-quotation). Null for Lead-direct quotes and manually-created
  // quotes. Enables the opportunity detail to list quotes it spawned
  // (distinct from other quotes for the same party).
  opportunityId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead        Lead?           @relation("QuotationLead", fields: [leadId], references: [id])
  customer    Customer?       @relation("QuotationCustomer", fields: [customerId], references: [id])
  items       QuotationItem[]
  taxTemplate TaxTemplate?    @relation("QuotationTaxTemplate", fields: [taxTemplateId], references: [id])
  taxes       QuotationTax[]
  salesOrders SalesOrder[]
  opportunity Opportunity?    @relation("OpportunityQuotation", fields: [opportunityId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, nextFollowUpDate])
  @@index([tenantId, opportunityId])
  @@map("quotations")
  @@schema("public")
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  itemId      String
  qty         Decimal @db.Decimal(18, 4)
  rate        Decimal @db.Decimal(18, 4)
  amount      Decimal @db.Decimal(18, 4)
  description String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  item      Item      @relation("QuotationItemItem", fields: [itemId], references: [id])

  @@index([quotationId])
  @@map("quotation_items")
  @@schema("public")
}

// ---------- CRM: Sales Order ----------
// Convert-to-invoice writes a Draft SalesInvoice into the shared DB (owned by
// accounting-service). User then submits it from accounting-web. This is a
// pragmatic shortcut given the shared DB — in a proper microservices setup
// this would be an HTTP call or an event.

model SalesOrder {
  id             String    @id @default(cuid())
  tenantId       String
  name           String // SO-0001
  customerId     String
  quotationId    String?
  orderDate      DateTime  @default(now())
  deliveryDate   DateTime?
  currency       String    @default("INR")
  netTotal       Decimal   @default(0) @db.Decimal(18, 4)
  taxTemplateId  String?
  totalTaxes     Decimal   @default(0) @db.Decimal(18, 4)
  grandTotal     Decimal   @default(0) @db.Decimal(18, 4)
  invoicedAmount Decimal   @default(0) @db.Decimal(18, 4)
  status         String    @default("Draft") // Draft | Submitted | To Deliver | To Bill | Completed | Cancelled
  remarks        String?
  customData     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer         @relation("SalesOrderCustomer", fields: [customerId], references: [id])
  quotation   Quotation?       @relation(fields: [quotationId], references: [id])
  items       SalesOrderItem[]
  taxTemplate TaxTemplate?     @relation("SalesOrderTaxTemplate", fields: [taxTemplateId], references: [id])
  taxes       SalesOrderTax[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("sales_orders")
  @@schema("public")
}

model SalesOrderItem {
  id           String  @id @default(cuid())
  salesOrderId String
  itemId       String
  qty          Decimal @db.Decimal(18, 4)
  rate         Decimal @db.Decimal(18, 4)
  amount       Decimal @db.Decimal(18, 4)
  description  String?
  // Cumulative counters updated as DNs and SIs are convert-created from this
  // line. Enables partial-invoicing: convert-to-invoice can be called multiple
  // times, each invoicing at most (qty − billedQty) units. When billedQty ==
  // qty for every line, the parent SO flips to "Fully Billed".
  billedQty    Decimal @default(0) @db.Decimal(18, 4)
  deliveredQty Decimal @default(0) @db.Decimal(18, 4)
  // Dropshipping: when true, SO submit creates a Purchase Order Draft to the
  // item's default supplier for this qty, tagged with sourceSalesOrderLineId
  // so staff can trace back. The DN + SI are still generated the normal way
  // once the supplier ships direct — this only automates the PO leg.
  isDropship   Boolean @default(false)

  salesOrder      SalesOrder           @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item            Item                 @relation("SalesOrderItemItem", fields: [itemId], references: [id])
  siLines         SalesInvoiceItem[]   @relation("SOItemToSILine")
  dnLines         DeliveryNoteItem[]   @relation("SOItemToDNLine")
  ppLines         ProductionPlanItem[] @relation("SOItemToPPLine")
  dropshipPoLines PurchaseOrderItem[]  @relation("POItemToSourceSOLine")

  @@index([salesOrderId])
  @@map("sales_order_items")
  @@schema("public")
}

// ---------- HR: Employee ----------
// baseSalary is monthly gross; used as the default "Basic" earning when
// generating a Salary Slip.

model Employee {
  id                 String    @id @default(cuid())
  tenantId           String
  employeeCode       String // EMP-0001
  employeeName       String
  email              String?
  mobile             String?
  designation        String?
  department         String?
  dateOfJoining      DateTime?
  baseSalary         Decimal   @default(0) @db.Decimal(18, 4)
  bankAccountNo      String?
  // Beneficiary details for payroll bank advice (NEFT / RTGS). ifscCode
  // is validated with a light regex on the API layer; bankName is
  // informational (some bank-advice formats want it inline).
  ifscCode           String?
  bankName           String?
  // Face-recognition attendance: stored embedding vector (base64 of a
  // JSON float array, provider-specific length). Populated by the
  // enrollment endpoint; matched against by check-in uploads.
  faceEmbedding      String?
  faceEnrolledAt     DateTime?
  // Optional link to a SalaryStructure. When set, bulk-generate and
  // /salary-slips/from-structure use its components as the slip's earnings +
  // deductions instead of the ad-hoc `Basic = baseSalary`.
  salaryStructureId  String?
  // Default shift for this employee — used to pre-fill Attendance.shiftId.
  defaultShiftId     String?
  // E1: per-employee holiday list. Falls back to Tenant.defaultHolidayListId.
  holidayListId      String?
  // E8: optional leave policy assigned to the employee.
  leavePolicyId      String?
  // E12: HR taxonomy — reference masters.
  gradeId            String?
  employmentTypeId   String?
  branchId           String?
  // Leave module additions — the categorization keys the 11 Leave dashboards
  // pivot on. Nullable so existing employees keep working; forms nudge them
  // to fill these in.
  workGroupId        String?
  employeeCategoryId String?
  // Optional self-reference for the org chart. Nullable at the top of
  // the tree (CEO/founder). Enforced against same-tenant only via a
  // route-level check; database is dumb here on purpose so mid-org
  // restructures don't need cross-record validation.
  managerId          String?
  customData         Json?
  status             String    @default("Active") // Active | Left | On Leave
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager                   Employee?                  @relation("EmployeeManager", fields: [managerId], references: [id])
  reports                   Employee[]                 @relation("EmployeeManager")
  attendances               Attendance[]
  salarySlips               SalarySlip[]
  salaryStructure           SalaryStructure?           @relation(fields: [salaryStructureId], references: [id])
  defaultShift              ShiftType?                 @relation("EmployeeDefaultShift", fields: [defaultShiftId], references: [id])
  holidayList               HolidayList?               @relation("EmployeeHolidayList", fields: [holidayListId], references: [id])
  leavePolicy               LeavePolicy?               @relation(fields: [leavePolicyId], references: [id])
  grade                     EmployeeGrade?             @relation(fields: [gradeId], references: [id])
  employmentType            EmploymentType?            @relation(fields: [employmentTypeId], references: [id])
  branch                    Branch?                    @relation(fields: [branchId], references: [id])
  workGroup                 WorkGroup?                 @relation(fields: [workGroupId], references: [id])
  employeeCategory          EmployeeCategory?          @relation(fields: [employeeCategoryId], references: [id])
  approverLinks             ApproverHierarchy[]        @relation("HierarchyEmployee")
  approversOf               ApproverHierarchy[]        @relation("HierarchyApprover")
  leaveLedgerEntries        LeaveLedgerEntry[]
  form12bbs                 Form12BB[]
  savingsRecords            Saving[]
  form16s                   Form16[]
  etdsDetails               ETDSDetail[]
  pfDetails                 PFDetail[]
  superAnnuationFunds       SuperAnnuationFund[]
  adhocPaymentRecoveries    AdhocPaymentRecovery[]
  houseRentDetails          HouseRentDetail[]
  companyAccommodations     CompanyAccommodation[]
  previousEmployerDetails   PreviousEmployerDetail[]
  finalSettlements          FinalSettlement[]
  bonuses                   Bonus[]
  esicDetails               ESICDetail[]
  professionalTaxDetails    ProfessionalTaxDetail[]
  employeeCTCs              EmployeeCTC[]
  payableDaysRecords        PayableDays[]
  lwfDetails                LWFDetail[]
  leaveAllocations          LeaveAllocation[]
  leaveApplications         LeaveApplication[]
  expenseClaims             ExpenseClaim[]
  loans                     Loan[]
  managedProjects           Project[]                  @relation("ProjectManager")
  assignedTasks             Task[]                     @relation("TaskAssignee")
  timesheets                Timesheet[]
  runningTimers             RunningTimer[]
  assignedIssues            Issue[]                    @relation("IssueAssignee")
  coursesTaught             Course[]                   @relation("CourseInstructor")
  practitionerAppointments  PatientAppointment[]       @relation("AppointmentPractitioner")
  practitionerEncounters    PatientEncounter[]         @relation("EncounterPractitioner")
  jobCards                  JobCard[]                  @relation("JobCardEmployee")
  salesPersons              SalesPerson[]              @relation("SalesPersonEmployee")
  payrollEntries            PayrollEntryEmployee[]
  checklists                EmployeeChecklist[]
  advances                  EmployeeAdvance[]
  appraisals                Appraisal[]
  checkins                  EmployeeCheckin[]
  overtimeRequests          OvertimeRequest[]
  attendanceRegularizations AttendanceRegularization[]
  hiredFromApplicants       JobApplicant[]             @relation("ApplicantHired")
  trainingAttendees         TrainingAttendee[]
  skills                    EmployeeSkill[]
  certifications            EmployeeCertification[]
  leaveEncashments          LeaveEncashment[]
  onboardings               EmployeeOnboarding[]
  separations               EmployeeSeparation[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId, status])
  @@index([tenantId, managerId])
  @@map("employees")
  @@schema("public")
}

// ---------- HR: Employee Onboarding + Separation (Module 51) ----------
//
// Onboarding: a checklist of tasks for a new hire (setup laptop, sign
// NDA, assign mentor, etc). Progress rolls up as tasks complete;
// Onboarding auto-flips to Completed when every task is done.
//
// Separation: the exit workflow — exit interview, asset return, PF
// settlement, final salary. Same task-based structure as Onboarding
// but with different default templates. On completion, the Employee
// row can be marked Inactive by the handler (optional).
//
// Both models share the same task-item schema so a shared UI can
// render them; kept as separate doctypes because the semantics differ
// (audit trails, defaults, downstream effects on payroll).

model EmployeeOnboarding {
  id           String   @id @default(cuid())
  tenantId     String
  employeeId   String
  boardingDate DateTime @db.Date // target/joining date
  status       String   @default("Draft") // Draft | InProgress | Completed | Cancelled
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tasks    EmployeeOnboardingTask[]

  @@unique([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("employee_onboardings")
  @@schema("public")
}

model EmployeeOnboardingTask {
  id           String    @id @default(cuid())
  onboardingId String
  sequence     Int
  taskName     String
  assignedTo   String? // free-text (email / employee name)
  dueDate      DateTime? @db.Date
  status       String    @default("Pending") // Pending | InProgress | Completed | Skipped
  completedAt  DateTime?
  notes        String?

  onboarding EmployeeOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@unique([onboardingId, sequence])
  @@index([onboardingId])
  @@map("employee_onboarding_tasks")
  @@schema("public")
}

model EmployeeSeparation {
  id             String   @id @default(cuid())
  tenantId       String
  employeeId     String
  separationDate DateTime @db.Date // last working day
  reason         String? // Resignation | Termination | Retirement | ...
  status         String   @default("Draft") // Draft | InProgress | Completed | Cancelled
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tasks    EmployeeSeparationTask[]

  @@unique([tenantId, employeeId])
  @@index([tenantId, status])
  @@map("employee_separations")
  @@schema("public")
}

model EmployeeSeparationTask {
  id           String    @id @default(cuid())
  separationId String
  sequence     Int
  taskName     String
  assignedTo   String?
  dueDate      DateTime? @db.Date
  status       String    @default("Pending") // Pending | InProgress | Completed | Skipped
  completedAt  DateTime?
  notes        String?

  separation EmployeeSeparation @relation(fields: [separationId], references: [id], onDelete: Cascade)

  @@unique([separationId, sequence])
  @@index([separationId])
  @@map("employee_separation_tasks")
  @@schema("public")
}

// ---------- HR: Attendance ----------

model Attendance {
  id           String    @id @default(cuid())
  tenantId     String
  employeeId   String
  date         DateTime  @db.Date
  status       String // Present | Absent | Half Day | On Leave | Work From Home
  // Optional shift for this day — informational (working hours + start/end).
  shiftId      String?
  remarks      String?
  // E6: derived from EmployeeCheckin punches (first IN + last OUT of the day)
  // when Attendance is built via /employee-checkins/build-attendance.
  checkIn      DateTime?
  checkOut     DateTime?
  workingHours Decimal?  @db.Decimal(6, 2)
  createdAt    DateTime  @default(now())

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift    ShiftType? @relation(fields: [shiftId], references: [id])

  @@unique([tenantId, employeeId, date])
  @@index([tenantId, date])
  @@map("attendances")
  @@schema("public")
}

// ---------- HR: Leave Encashment (E14) ----------
//
// Convert unused encashable-leave balance to cash. On approve+pay: posts
// DR Salary Expense / CR Bank|Cash and creates a compensating (negative)
// LeaveAllocation so the balance drops.

model LeaveEncashment {
  id                    String   @id @default(cuid())
  tenantId              String
  name                  String // LEC-0001
  employeeId            String
  leaveTypeId           String
  encashmentDate        DateTime @db.Date
  days                  Decimal  @db.Decimal(9, 2)
  dailyRate             Decimal  @db.Decimal(18, 4)
  amount                Decimal  @db.Decimal(18, 4)
  status                String   @default("Draft") // Draft | Approved | Paid | Cancelled
  modeOfPayment         String   @default("Bank")
  paymentJournalEntryId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, employeeId])
  @@map("leave_encashments")
  @@schema("public")
}

// ---------- HR: Employee Skills + Certifications (E13) ----------

model EmployeeSkill {
  id                String   @id @default(cuid())
  tenantId          String
  employeeId        String
  skillName         String
  proficiency       String // Beginner | Intermediate | Advanced | Expert
  yearsOfExperience Decimal? @db.Decimal(6, 2)
  createdAt         DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, skillName])
  @@index([tenantId, skillName])
  @@map("employee_skills")
  @@schema("public")
}

model EmployeeCertification {
  id                String    @id @default(cuid())
  tenantId          String
  employeeId        String
  certificationName String
  issuer            String?
  issueDate         DateTime? @db.Date
  expiryDate        DateTime? @db.Date
  credentialId      String?
  credentialUrl     String?
  createdAt         DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@index([tenantId, expiryDate])
  @@map("employee_certifications")
  @@schema("public")
}

// ---------- HR: Employee Grade / Employment Type / Branch (E12) ----------

model EmployeeGrade {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  description       String?
  defaultBaseSalary Decimal? @db.Decimal(18, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, name])
  @@map("employee_grades")
  @@schema("public")
}

model EmploymentType {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // Full-time | Contract | Intern | Consultant | ...
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, name])
  @@map("employment_types")
  @@schema("public")
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  city      String?
  state     String?
  country   String?
  // Geo-fence for attendance check-in enforcement. When all three are
  // set, an EmployeeCheckin coming from the "mobile" source must land
  // within `fenceRadiusMeters` of (fenceLatitude, fenceLongitude) or
  // the route rejects it. Null on any one field = no fence check for
  // employees assigned to this branch.
  fenceLatitude     Decimal? @db.Decimal(10, 7)
  fenceLongitude    Decimal? @db.Decimal(10, 7)
  fenceRadiusMeters Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, name])
  @@map("branches")
  @@schema("public")
}

// ---------- HR: Training Event + Attendee (E11) ----------

model TrainingEvent {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // TRN-0001
  subject     String
  description String?
  startAt     DateTime
  endAt       DateTime
  location    String?
  trainerName String?
  status      String   @default("Scheduled") // Scheduled | InProgress | Completed | Cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attendees TrainingAttendee[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, startAt])
  @@map("training_events")
  @@schema("public")
}

model TrainingAttendee {
  id              String   @id @default(cuid())
  trainingEventId String
  employeeId      String
  attended        Boolean  @default(false)
  rating          Int? // 1..5
  feedback        String?
  createdAt       DateTime @default(now())

  trainingEvent TrainingEvent @relation(fields: [trainingEventId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id])

  @@unique([trainingEventId, employeeId])
  @@map("training_attendees")
  @@schema("public")
}

// ---------- HR: Recruitment / Job Opening + Applicant (E10) ----------

model JobOpening {
  id             String    @id @default(cuid())
  tenantId       String
  name           String // JOB-0001
  title          String
  department     String?
  designation    String?
  description    String?
  location       String?
  employmentType String? // Full-time | Part-time | Contract | Intern
  publishedAt    DateTime?
  closedAt       DateTime?
  status         String    @default("Open") // Open | Closed | On Hold
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  applicants JobApplicant[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("job_openings")
  @@schema("public")
}

model JobApplicant {
  id              String   @id @default(cuid())
  tenantId        String
  name            String // JAPP-0001
  applicantName   String
  email           String?
  mobile          String?
  coverLetter     String?
  resumeUrl       String?
  source          String? // Referral | LinkedIn | Website | ...
  jobOpeningId    String?
  status          String   @default("New") // New | Shortlisted | Interviewing | Offer | Hired | Rejected | Withdrawn
  hiredEmployeeId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobOpening    JobOpening? @relation(fields: [jobOpeningId], references: [id])
  hiredEmployee Employee?   @relation("ApplicantHired", fields: [hiredEmployeeId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, jobOpeningId])
  @@map("job_applicants")
  @@schema("public")
}

// ---------- HR: Statutory Component (E9) ----------
//
// Defines auto-computed payroll deductions: PF, ESI, PT, TDS.
// When a Salary Slip is generated by PayrollEntry, every enabled component
// whose applicableFrom is on-or-before slip.endDate contributes:
//   deduction line = round(min(gross, monthlyGrossCeiling ?? gross) × employeeSharePercent% / 100)
// Employer share is tracked for reporting but posted to the same
// Statutory Payable account by default (single-account MVP).

model StatutoryComponent {
  id                   String    @id @default(cuid())
  tenantId             String
  name                 String // PF | ESI | PT | TDS | Custom
  slipComponentName    String // rendered on the Salary Slip as this deduction row
  employeeSharePercent Decimal   @db.Decimal(6, 3) // 0..100
  employerSharePercent Decimal   @default(0) @db.Decimal(6, 3)
  monthlyGrossCeiling  Decimal?  @db.Decimal(18, 4) // if set, cap the base
  flatAmount           Decimal?  @db.Decimal(18, 4) // if set, overrides %-of-gross
  applicableFrom       DateTime  @db.Date
  applicableTo         DateTime? @db.Date
  enabled              Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, enabled])
  @@map("statutory_components")
  @@schema("public")
}

// ---------- HR: Leave Policy (E8) ----------
//
// Reusable annual allocation template (leaveType → annual days). Applying a
// policy creates one LeaveAllocation per detail row for each targeted employee.

model LeavePolicy {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  details   LeavePolicyDetail[]
  employees Employee[]

  @@unique([tenantId, name])
  @@map("leave_policies")
  @@schema("public")
}

model LeavePolicyDetail {
  id               String  @id @default(cuid())
  leavePolicyId    String
  leaveTypeId      String
  annualAllocation Decimal @db.Decimal(9, 2)

  leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)
  leaveType   LeaveType   @relation(fields: [leaveTypeId], references: [id])

  @@unique([leavePolicyId, leaveTypeId])
  @@map("leave_policy_details")
  @@schema("public")
}

// ---------- HR: Overtime Request (E7) ----------
//
// Overtime hours for a specific date, approved before feeding payroll. When
// approved, `amount = hours × hourlyRate` is computed and the request can be
// consumed by a Salary Slip generator.

model OvertimeRequest {
  id         String    @id @default(cuid())
  tenantId   String
  name       String // OT-0001
  employeeId String
  otDate     DateTime  @db.Date
  hours      Decimal   @db.Decimal(6, 2)
  hourlyRate Decimal   @db.Decimal(18, 4)
  amount     Decimal   @default(0) @db.Decimal(18, 4)
  reason     String?
  status     String    @default("Draft") // Draft | Approved | Rejected | Cancelled
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, employeeId, otDate])
  @@map("overtime_requests")
  @@schema("public")
}

// ---------- HR: Attendance Regularization (E7) ----------
//
// Employee requests a change to an Attendance row (missed punch, wrong status,
// forgot to check out, etc.). On approve, the target Attendance row is updated
// in place — a comment is stamped in `remarks` for audit.

model AttendanceRegularization {
  id                String    @id @default(cuid())
  tenantId          String
  name              String // AR-0001
  employeeId        String
  attendanceDate    DateTime  @db.Date
  requestedStatus   String // Present | Absent | Half Day | Work From Home
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason            String
  status            String    @default("Draft") // Draft | Approved | Rejected | Cancelled
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, employeeId, attendanceDate])
  @@map("attendance_regularizations")
  @@schema("public")
}

// ---------- HR: Employee Checkin (E6) ----------
//
// Raw punch record — one per IN/OUT event. Aggregated into Attendance rows
// by /employee-checkins/build-attendance for a given date.

model EmployeeCheckin {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  ts         DateTime
  logType    String // IN | OUT
  source     String? // biometric | mobile | web | api | face
  deviceId   String? // e.g. biometric device identifier
  remarks    String?
  // Geo capture from mobile check-in. Validated against Branch.fence*
  // when the check-in source is "mobile".
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  // Face recognition confidence (0..1) when source is "face". The face
  // adapter (see packages/db/src/face-recognition.ts) matches an
  // uploaded photo against Employee.faceEmbedding — this stores its
  // confidence for the auditor.
  faceMatchConfidence Decimal? @db.Decimal(5, 4)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, ts])
  @@index([tenantId, ts])
  @@map("employee_checkins")
  @@schema("public")
}

// ---------- HR: Salary Slip ----------
// Submit posts GL:
//   Debit  Salary Expense    (grossPay)
//   Credit Employee Payable  (netPay)
//   Credit Statutory Payable (totalDeduction)
// Invariant: grossPay = totalDeduction + netPay (enforced at submit).

model SalarySlip {
  id             String   @id @default(cuid())
  tenantId       String
  name           String // SS-0001
  employeeId     String
  startDate      DateTime @db.Date
  endDate        DateTime @db.Date
  grossPay       Decimal  @default(0) @db.Decimal(18, 4)
  totalDeduction Decimal  @default(0) @db.Decimal(18, 4)
  netPay         Decimal  @default(0) @db.Decimal(18, 4)
  status         String   @default("Draft") // Draft | Submitted | Cancelled | Paid
  remarks        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee              Employee               @relation(fields: [employeeId], references: [id])
  components            SalarySlipComponent[]
  payrollEntryEmployees PayrollEntryEmployee[]

  @@unique([tenantId, name])
  @@unique([tenantId, employeeId, startDate, endDate])
  @@index([tenantId, status])
  @@map("salary_slips")
  @@schema("public")
}

model SalarySlipComponent {
  id            String  @id @default(cuid())
  salarySlipId  String
  componentName String // "Basic", "HRA", "Tax", "PF", ...
  type          String // Earning | Deduction
  amount        Decimal @db.Decimal(18, 4)

  salarySlip SalarySlip @relation(fields: [salarySlipId], references: [id], onDelete: Cascade)

  @@index([salarySlipId])
  @@map("salary_slip_components")
  @@schema("public")
}

// ---------- Multi-currency: Currency master ----------
// Per-tenant list of allowed currencies. Tenant.baseCurrency is the code used
// for GL. Invoices use `currency` + `conversionRate`; amounts are multiplied
// by conversionRate when posting to GL so the ledger stays base-currency.

model Currency {
  id        String   @id @default(cuid())
  tenantId  String
  code      String // ISO 4217 (INR, USD, EUR)
  name      String
  symbol    String
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("currencies")
  @@schema("public")
}

// FX rate master. One row per (from, to, effectiveDate) — SI/PI/PE new-forms
// call `/exchange-rates/latest?from=X&to=Y&asOf=YYYY-MM-DD` on currency
// change to prefill conversionRate. `to` is almost always the tenant's
// baseCurrency, but we support arbitrary pairs so historical/analytics
// queries work.
model ExchangeRate {
  id            String   @id @default(cuid())
  tenantId      String
  fromCurrency  String // ISO code, e.g. "USD"
  toCurrency    String // ISO code, e.g. "INR"
  effectiveDate DateTime @db.Date
  rate          Decimal  @db.Decimal(18, 6)
  source        String? // "Manual" | "ECB" | etc. — informational
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fromCurrency, toCurrency, effectiveDate])
  @@index([tenantId, fromCurrency, toCurrency, effectiveDate])
  @@map("exchange_rates")
  @@schema("public")
}

// ---------- Manufacturing: Production Plan (C11) ----------
// Aggregates production intent (SO demand + on-hand + open POs) into a
// list of items to produce, plus the raw materials required to make them.
// From a submitted plan, operators generate Work Orders and (later)
// Material Requests for missing RM.

model ProductionPlan {
  id          String   @id @default(cuid())
  tenantId    String
  name        String // PP-0001
  postingDate DateTime @default(now())
  status      String   @default("Draft") // Draft | Submitted | Cancelled
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items        ProductionPlanItem[]
  rawMaterials ProductionPlanRawMaterial[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("production_plans")
  @@schema("public")
}

model ProductionPlanItem {
  id               String  @id @default(cuid())
  productionPlanId String
  itemId           String
  plannedQty       Decimal @db.Decimal(18, 4)
  producedQty      Decimal @default(0) @db.Decimal(18, 4)
  salesOrderItemId String? // when this line was auto-added from SO demand

  productionPlan ProductionPlan  @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  item           Item            @relation("PPItemItem", fields: [itemId], references: [id])
  salesOrderItem SalesOrderItem? @relation("SOItemToPPLine", fields: [salesOrderItemId], references: [id])

  @@index([productionPlanId])
  @@map("production_plan_items")
  @@schema("public")
}

model ProductionPlanRawMaterial {
  id               String  @id @default(cuid())
  productionPlanId String
  itemId           String
  requiredQty      Decimal @db.Decimal(18, 4) // rolled up from item BOMs
  availableQty     Decimal @default(0) @db.Decimal(18, 4) // snapshot of stock at aggregate-time
  shortfallQty     Decimal @default(0) @db.Decimal(18, 4) // required - available (min 0)

  productionPlan ProductionPlan @relation(fields: [productionPlanId], references: [id], onDelete: Cascade)
  item           Item           @relation("PPRawMatItem", fields: [itemId], references: [id])

  @@index([productionPlanId])
  @@map("production_plan_raw_materials")
  @@schema("public")
}

// ---------- Stock: Item Reorder Rules (C15) ----------
// Per (item, warehouse) minimum stock level. Bin.actualQty < reorderLevel
// makes the rule "actionable" — the /generate-material-requests endpoint
// creates a Draft MR that covers the shortfall (target = reorderQty by
// default, or exact shortfall if that's larger).

model ItemReorderRule {
  id                  String   @id @default(cuid())
  tenantId            String
  itemId              String
  warehouseId         String
  reorderLevel        Decimal  @db.Decimal(18, 4)
  reorderQty          Decimal  @db.Decimal(18, 4)
  materialRequestType String   @default("Purchase") // Purchase | Material Transfer | Manufacture
  enabled             Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      Item      @relation("ReorderItem", fields: [itemId], references: [id])
  warehouse Warehouse @relation("ReorderWarehouse", fields: [warehouseId], references: [id])

  @@unique([tenantId, itemId, warehouseId])
  @@index([tenantId, enabled])
  @@map("item_reorder_rules")
  @@schema("public")
}

// ---------- Stock: Serial Numbers (C5) ----------
// One SerialNo per unit of a serialized item. Lifecycle:
//   Active     — in stock at `warehouseId`.
//   Delivered  — shipped out; `warehouseId` cleared.
//   Cancelled  — the receipt that created it was cancelled.
// Also usable for warranty/servicing: the SerialNo persists after Delivered
// so future queries can find the item's history (deferred UI).

model SerialNo {
  id                    String   @id @default(cuid())
  tenantId              String
  serialNo              String
  itemId                String
  warehouseId           String?
  status                String   @default("Active") // Active | Delivered | Cancelled
  purchaseReceiptItemId String?
  deliveryNoteItemId    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item                Item                 @relation("SerialNoItem", fields: [itemId], references: [id])
  warehouse           Warehouse?           @relation("SerialNoWarehouse", fields: [warehouseId], references: [id])
  purchaseReceiptItem PurchaseReceiptItem? @relation("SerialNoPRItem", fields: [purchaseReceiptItemId], references: [id])
  deliveryNoteItem    DeliveryNoteItem?    @relation("SerialNoDNItem", fields: [deliveryNoteItemId], references: [id])

  @@unique([tenantId, serialNo])
  @@index([tenantId, itemId])
  @@index([tenantId, warehouseId, status])
  @@map("serial_numbers")
  @@schema("public")
}

// ---------- Stock: Batches + expiry (C6) ----------
// A Batch is a shared serial-number-lite identifier for a set of units of one
// item (e.g. lot code, manufacturing batch, food-lot). Optionally tracks
// manufacture + expiry dates. PR submits create/upsert Batch and add to
// batchQty; DN submits validate + decrement. Batch is not per-warehouse
// (matches ERPNext) — a Batch can live across warehouses; if you need
// per-warehouse batch balance, use StockLedgerEntry filtered by batchNo.

model Batch {
  id                String    @id @default(cuid())
  tenantId          String
  batchNo           String
  itemId            String
  manufactureDate   DateTime?
  expiryDate        DateTime?
  batchQty          Decimal   @default(0) @db.Decimal(18, 4)
  disabled          Boolean   @default(false)
  // Scheduler dedup — set when the batch-expiry tick emits a Notification
  // for this batch. Prevents re-alerting every tick after the tenant
  // misses a cleanup window.
  lastExpiryAlertAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   Item   @relation("BatchItem", fields: [itemId], references: [id])

  @@unique([tenantId, itemId, batchNo])
  @@index([tenantId, itemId])
  @@index([tenantId, expiryDate])
  @@map("batches")
  @@schema("public")
}

// ---------- Stock: UOM conversion (C7) ----------
// Per-item conversion factors from an alternate UOM into the item's stock
// UOM. `conversionFactor` = "1 UOM equals this many stockUOM units".
// e.g. stockUom="Nos", uom="Dozen", conversionFactor=12.
// PR/DN lines can carry (uom, conversionFactor) and the route converts to
// stock units for SLE/Bin math. When absent, qty is assumed to already be
// in stock UOM.

model ItemUOMConversion {
  id               String   @id @default(cuid())
  tenantId         String
  itemId           String
  uom              String
  conversionFactor Decimal  @db.Decimal(18, 6)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   Item   @relation("UOMConvItem", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, itemId, uom])
  @@index([tenantId, itemId])
  @@map("item_uom_conversions")
  @@schema("public")
}

// ---------- Inventory: Item Alternate (Module 49) ----------
//
// A tenant-scoped many-to-many between Items expressing "SKU X is a
// valid substitute for SKU Y." Used by PO/SO create-flow suggestions
// ("Item Y is out of stock — substitute with Item X at rate Z") and by
// the buying compare views. Direction matters (X → Y is not always
// symmetric; e.g., a premium item substitutes a basic one but not
// vice versa in some catalogs) so we don't auto-mirror.

model ItemAlternate {
  id              String   @id @default(cuid())
  tenantId        String
  itemId          String // the "primary" (out-of-stock) item
  alternateItemId String // the substitute
  // Whether this pairing is a two-way substitute. When true, callers
  // should also look up the reverse pair. Kept as a flag rather than
  // auto-creating two rows so the master list stays clean.
  twoWay          Boolean  @default(false)
  // Optional priority for ranking multiple alternates for the same
  // primary. Lower = higher preference; ties broken by id.
  priority        Int      @default(100)
  notes           String?
  createdAt       DateTime @default(now())

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item          Item   @relation("ItemAlternatePrimary", fields: [itemId], references: [id], onDelete: Cascade)
  alternateItem Item   @relation("ItemAlternateAlt", fields: [alternateItemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, itemId, alternateItemId])
  @@index([tenantId, itemId])
  @@map("item_alternates")
  @@schema("public")
}

// ---------- QA: Quality Inspection (C9) ----------
// A QualityInspectionTemplate is a reusable list of parameters (e.g.
// "moisture %", "colour", "weight g") with acceptance rules. When a PR/DN
// line is for an item with `inspectionRequiredBefore(Receipt|Delivery) =
// true`, submit refuses unless an Accepted QualityInspection is linked.

model QualityInspectionTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parameters  QualityInspectionTemplateItem[]
  itemsUsing  Item[]                          @relation("ItemDefaultQIT")
  inspections QualityInspection[]             @relation("QIFromTemplate")

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("quality_inspection_templates")
  @@schema("public")
}

model QualityInspectionTemplateItem {
  id                 String  @id @default(cuid())
  templateId         String
  parameter          String
  // Free-form acceptance criteria e.g. "≥ 95%", "matches Pantone 186 C",
  // "between 480 and 520 g". The reading UI captures the actual value; the
  // inspector chooses accepted/rejected per row.
  acceptanceCriteria String?
  sortOrder          Int     @default(0)

  template QualityInspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("quality_inspection_template_items")
  @@schema("public")
}

model QualityInspection {
  id                    String   @id @default(cuid())
  tenantId              String
  name                  String // QI-0001
  inspectionType        String   @default("Incoming") // Incoming | Outgoing | In-Process
  reportDate            DateTime @default(now())
  itemId                String
  templateId            String?
  purchaseReceiptItemId String?
  deliveryNoteItemId    String?
  overallStatus         String   @default("Accepted") // Accepted | Rejected
  inspectedBy           String? // free-form name for now (later: userId FK)
  remarks               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant              Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item                Item                       @relation("QIItem", fields: [itemId], references: [id])
  template            QualityInspectionTemplate? @relation("QIFromTemplate", fields: [templateId], references: [id])
  purchaseReceiptItem PurchaseReceiptItem?       @relation("QIForPRItem", fields: [purchaseReceiptItemId], references: [id])
  deliveryNoteItem    DeliveryNoteItem?          @relation("QIForDNItem", fields: [deliveryNoteItemId], references: [id])
  readings            QualityInspectionReading[]
  nonConformances     NonConformance[]           @relation("NCRQualityInspection")

  @@unique([tenantId, name])
  @@index([tenantId, itemId])
  @@index([tenantId, purchaseReceiptItemId])
  @@index([tenantId, deliveryNoteItemId])
  @@map("quality_inspections")
  @@schema("public")
}

model QualityInspectionReading {
  id                 String  @id @default(cuid())
  inspectionId       String
  parameter          String
  acceptanceCriteria String?
  reading            String? // captured value (free-form; may be number or text)
  status             String  @default("Accepted") // Accepted | Rejected

  inspection QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
  @@map("quality_inspection_readings")
  @@schema("public")
}

// ---------- Quality: Non-Conformance (Module 62) ----------
//
// Records a quality failure — usually spawned from a rejected
// QualityInspection but can also be filed standalone by an operator.
// Tracks disposition + root cause + corrective action through a small
// lifecycle: Open → Investigating → Resolved | Closed.
//
// Regulated industries (medical, aerospace, food) require this doctype
// for ISO 9001 / FDA / GMP compliance audits.

model NonConformance {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String // NCR-0001
  reportedOn          DateTime  @default(now())
  // Optional QI backlink — when the QI's Rejected result is what
  // triggered this NCR. Null = standalone (e.g., customer complaint,
  // internal audit finding).
  qualityInspectionId String?
  itemId              String?
  batchNo             String?
  serialNo            String?
  severity            String    @default("Minor") // Minor | Major | Critical
  category            String? // "Material" | "Process" | "Documentation" | "Other"
  description         String // what went wrong
  rootCause           String? // filled during Investigating
  disposition         String? // "Rework" | "Scrap" | "Return to Supplier" | "Use As Is"
  correctiveAction    String? // action taken
  preventiveAction    String? // long-term prevention
  status              String    @default("Open") // Open | Investigating | Resolved | Closed
  assignedTo          String? // free text (email / employee name)
  resolvedAt          DateTime?
  resolvedBy          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  qualityInspection QualityInspection? @relation("NCRQualityInspection", fields: [qualityInspectionId], references: [id])
  item              Item?              @relation("NCRItem", fields: [itemId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@map("non_conformances")
  @@schema("public")
}

// ---------- Pricing: Price Lists (C4) ----------
// A named catalog of item prices. Each Item can have many ItemPrice rows
// (one per PriceList + optional validity window). SI/PI/PO/Quotation forms
// pick a PriceList and auto-fill rate on item selection.

model PriceList {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  currency        String   @default("INR")
  buyingOrSelling String   @default("Selling") // Buying | Selling
  isDefault       Boolean  @default(false) // convenience flag (Tenant.defaultSellingPriceListId is authoritative)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prices      ItemPrice[]
  posProfiles POSProfile[] @relation("POSProfilePriceList")

  @@unique([tenantId, name])
  @@index([tenantId, buyingOrSelling, enabled])
  @@map("price_lists")
  @@schema("public")
}

model ItemPrice {
  id            String    @id @default(cuid())
  tenantId      String
  itemId        String
  priceListId   String
  priceListRate Decimal   @db.Decimal(18, 4)
  validFrom     DateTime?
  validUpto     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      Item      @relation("ItemPriceItem", fields: [itemId], references: [id])
  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([tenantId, itemId, priceListId])
  @@index([tenantId, priceListId])
  @@map("item_prices")
  @@schema("public")
}

// ---------- Tax: Tax Template ----------
// Single-rate template for now (e.g. "GST 18%" → accountId=Tax Payable).
// Multi-rate compound templates (CGST+SGST etc.) are a future extension —
// per-invoice tax lines are already stored, so upgrading is mechanical.

model TaxTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  templateType String // Sales | Purchase
  // Legacy single-rate fields kept nullable for backward compat with pre-turn-45
  // templates. New multi-row templates leave these null and use `rows` instead.
  // SI/PI application logic prefers rows when present; falls back to these otherwise.
  rate         Decimal? @db.Decimal(9, 4)
  accountId    String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account                Account?              @relation("TaxTemplateAccount", fields: [accountId], references: [id])
  rows                   TaxTemplateRow[]
  salesInvoices          SalesInvoice[]        @relation("SITaxTemplate")
  purchaseInvoices       PurchaseInvoice[]     @relation("PITaxTemplate")
  siTaxLines             SalesInvoiceTax[]
  piTaxLines             PurchaseInvoiceTax[]
  quotations             Quotation[]           @relation("QuotationTaxTemplate")
  salesOrders            SalesOrder[]          @relation("SalesOrderTaxTemplate")
  quotationTaxLines      QuotationTax[]
  salesOrderTaxLines     SalesOrderTax[]
  siItemLines            SalesInvoiceItem[]    @relation("SIItemLineTax")
  piItemLines            PurchaseInvoiceItem[] @relation("PIItemLineTax")
  itemsAsDefaultSales    Item[]                @relation("ItemDefaultSalesTax")
  itemsAsDefaultPurchase Item[]                @relation("ItemDefaultPurchaseTax")
  purchaseOrders         PurchaseOrder[]       @relation("POTaxTemplate")
  poItemLines            PurchaseOrderItem[]   @relation("POItemLineTax")
  poTaxLines             PurchaseOrderTax[]

  @@unique([tenantId, name])
  @@index([tenantId, templateType])
  @@map("tax_templates")
  @@schema("public")
}

// Multi-row child. e.g. an Indian intra-state Sales tax template has two rows:
// CGST @ 9% → CGST Payable account, SGST @ 9% → SGST Payable account.
// Snapshot fields on SalesInvoiceTax / PurchaseInvoiceTax mean template edits
// don't rewrite history — SI/PI copies the resolved rows at create time.
// ---------- OAuth 2 server ----------
//
// Standard OAuth 2 + PKCE. Supports three grant types:
//   authorization_code — 3rd-party apps acting on behalf of a user
//   refresh_token       — long-lived renewal of access tokens
//   client_credentials  — machine-to-machine (no user context)
//
// Access tokens are opaque (not JWT) — 32-byte random, sha256-stored. This
// lets us revoke instantly without waiting for a signature to expire. Tradeoff:
// every auth check hits the DB. For very high-QPS APIs a JWKS/JWT variant is
// deferred.

// ─── SSO (inbound OIDC) ────────────────────────────────────────────────────
//
// Per-tenant OIDC configuration. The app is the RELYING PARTY here (unlike
// OAuthClient above, where the app is the AUTHORIZATION SERVER for third
// parties). One row per (tenant, provider) — a tenant can enable multiple
// providers (Google + Microsoft) if they support mixed-domain workforces.
//
// clientSecret is stored via secretsCrypto (AES-256-GCM) — never returned
// from the admin API in the clear. allowedEmailDomains restricts which
// user emails can auto-provision through this provider (e.g. "acme.com,
// acme.co.uk" — an attacker with a Google account @gmail.com cannot use
// the tenant's Google SSO without their email domain matching).

model SsoProvider {
  id                  String   @id @default(cuid())
  tenantId            String
  provider            String // "google" | "microsoft" | "oidc-generic"
  issuer              String // e.g. "https://accounts.google.com"
  clientId            String
  clientSecretEnc     Json // AES-256-GCM envelope, see secrets-crypto.ts
  allowedEmailDomains String[] // e.g. ["acme.com"] — empty = any
  autoProvision       Boolean  @default(true) // create user on first SSO login
  defaultRole         String   @default("user") // role assigned on auto-provision
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ssoStates  SsoState[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("sso_providers")
  @@schema("public")
}

// Short-lived state cookie for the OIDC authorize → callback round-trip.
// Holds the PKCE verifier + the original `state` + `nonce` values so the
// callback can validate them. TTL is 10 min; older rows are swept.

model SsoState {
  id            String   @id @default(cuid())
  ssoProviderId String
  state         String   @unique // random 32-byte
  nonce         String // in id_token, checked in callback
  codeVerifier  String // PKCE
  redirectTo    String? // optional post-login destination
  createdAt     DateTime @default(now())
  expiresAt     DateTime // now + 10min

  ssoProvider SsoProvider @relation(fields: [ssoProviderId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sso_states")
  @@schema("public")
}

model OAuthClient {
  id               String   @id @default(cuid())
  tenantId         String
  clientId         String   @unique // public identifier
  clientSecretHash String? // null for public clients (SPA/mobile w/ PKCE)
  name             String // display name shown on consent screen
  redirectUris     String[] // exact-match on authorize
  grantTypes       String[] // subset of {authorization_code, refresh_token, client_credentials}
  scopes           String[] // allowed scope strings for this client
  isPublic         Boolean  @default(false) // no client_secret → must use PKCE
  isTrusted        Boolean  @default(false) // skip consent screen (first-party apps)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authCodes    OAuthAuthCode[]
  accessTokens OAuthAccessToken[]
  consents     OAuthConsent[]

  @@index([tenantId])
  @@map("oauth_clients")
  @@schema("public")
}

model OAuthAuthCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique // sha256 of raw code
  clientId            String
  userId              String
  redirectUri         String
  scopes              String[]
  codeChallenge       String? // PKCE
  codeChallengeMethod String? // "S256" | "plain"
  expiresAt           DateTime // 10 min TTL
  usedAt              DateTime? // set on first exchange — one-shot
  createdAt           DateTime  @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("oauth_auth_codes")
  @@schema("public")
}

model OAuthAccessToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  clientId  String
  userId    String? // null for client_credentials grant
  scopes    String[]
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  client        OAuthClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens OAuthRefreshToken[]

  @@index([tokenHash])
  @@index([userId])
  @@map("oauth_access_tokens")
  @@schema("public")
}

model OAuthRefreshToken {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  accessTokenId String
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  accessToken OAuthAccessToken @relation(fields: [accessTokenId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("oauth_refresh_tokens")
  @@schema("public")
}

// Remembered user consent — subsequent authorize calls skip the UI prompt
// when scopes match a prior grant.
model OAuthConsent {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  scopes    String[]
  createdAt DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@map("oauth_consents")
  @@schema("public")
}

// Machine-to-machine credential. Scoped to a specific user (inherits that
// user's roles + tenantId at request time). Raw token shown once at issue;
// only the SHA-256 hash is stored. `prefix` is the first 8 chars of the
// raw token — surfaced in listings so users can identify a token without
// exposing its full value.
model ApiToken {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  name       String // human label e.g. "GitHub Actions", "Zapier"
  prefix     String // first 8 chars of raw token, for display
  tokenHash  String    @unique // sha256 hex of raw token
  expiresAt  DateTime? // null = never expires
  revokedAt  DateTime? // set on manual revoke — soft delete for audit
  lastUsedAt DateTime? // updated best-effort on each auth check
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([tenantId, userId])
  @@map("api_tokens")
  @@schema("public")
}

// SCIM 2.0 provisioning bearer token. Each identity-provider connection
// (Okta, Azure AD, Google Workspace, etc.) gets its own long-lived token
// pasted into the IdP's "SCIM connector" screen. Separate from ApiToken
// because SCIM uses a different auth flow (fixed-length bearer, no user
// scoping) and we want to revoke/audit it independently.
model ScimToken {
  id              String    @id @default(cuid())
  tenantId        String
  name            String // "Okta production", "Azure AD staging"
  prefix          String // first 8 chars of raw token, for identification
  tokenHash       String    @unique // sha256 hex of raw token
  defaultRole     String    @default("admin") // role assigned to SCIM-created users
  createdByUserId String? // null = created by system
  revokedAt       DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([tenantId, revokedAt])
  @@map("scim_tokens")
  @@schema("public")
}

// Immutable audit trail. One row per privileged write action (POST/PUT/DELETE/
// submit/cancel). Captures who + when + what + before/after diff so tenants
// can answer "who changed this invoice's amount" and satisfy SOC2/compliance
// asks. Rows are never updated or deleted (only tenant-cascade). Cheap to
// query on (tenantId, doctype, docId) — the common auditing question.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String? // null for system-initiated actions
  userEmail  String? // snapshotted at write time (user may be renamed/deleted later)
  method     String // POST | PUT | DELETE | POST-submit | POST-cancel | POST-<action>
  path       String // request path — informational
  doctype    String? // inferred from route mount (e.g. "SalesInvoice")
  docId      String? // primary key of the affected doc when resolvable
  ipAddress  String?
  userAgent  String?
  statusCode Int // response status
  // Optional structured diff. For creates: {after: {...}}. For updates:
  // {before: {...}, after: {...}}. For deletes: {before: {...}}. Kept as Json
  // so callers can shape what they need without schema churn.
  payload    Json?
  createdAt  DateTime @default(now())

  // ── Hash chain (SOC 2 Type II immutability) ────────────────────────
  //
  // Every entry hashes its content + the prior entry's hash, per-tenant.
  // Tampering with any row breaks the chain and is detectable by the
  // /audit-logs/verify endpoint.
  //
  //   entryHash = sha256(prevHash || tenantId || userId || method || path ||
  //                      doctype || docId || statusCode || createdAt || payloadJson)
  //
  // Nullable to keep the migration lock-free on write-hot tables; new writes
  // populate both. A background job can backfill historical rows.
  prevHash  String? // 64-hex chars — the previous row's entryHash
  entryHash String? // 64-hex chars — this row's hash
  sequence  Int? // strictly monotonic per tenant; catches insertions

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, doctype, docId])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, sequence])
  @@map("audit_logs")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────
// SuperAdminAuditLog — tracks cross-tenant privileged operations.
//
// Separate from AuditLog because super-admin ops don't belong to a tenant:
// they're PLATFORM-level actions (change a plan, flip a feature flag for
// another tenant, delete a tenant, inspect data across tenants). Writing
// these into AuditLog would either need a nullable tenantId (breaks the
// hash-chain scoping) or a synthetic "platform" tenant row.
//
// Written automatically by the auditSuperAdmin middleware mounted on every
// super-admin router (services/auth-service/src/routes/super-*.ts). Reads
// via GET /super/audit (platform-admin-only).
//
// Hash chain mirrors AuditLog: tamper detection + strictly monotonic
// sequence. SOC 2 pattern.
model SuperAdminAuditLog {
  id             String   @id @default(cuid())
  // Who performed the action (null = system / scheduler / background job).
  actorUserId    String?
  actorEmail     String? // snapshotted — user may be renamed/deleted later
  // Which tenant the action targeted. Null for list-all queries that span
  // every tenant (e.g. `GET /super/tenants`). Non-null when a specific
  // tenant row was created / updated / deleted.
  targetTenantId String?
  // Human-visible op identifier, usually "HTTP_METHOD /route/pattern" or
  // "job:<name>" for scheduler cross-tenant sweeps. 128-char cap.
  operation      String
  method         String // POST | PATCH | DELETE | GET | job
  path           String // request path or job name
  // Optional structured payload (request body for writes, filters for
  // reads). Trimmed to a sensible size before persist.
  payload        Json?
  ipAddress      String?
  userAgent      String?
  statusCode     Int?
  // Optional free-text reason. Super-admin UIs that require a reason
  // (plan downgrade, forced delete) persist it here.
  reason         String?
  // Hash chain — see AuditLog comments. Chain is global (one chain for
  // the whole platform) because super-admin ops are platform-scoped.
  prevHash       String? // 64-hex
  entryHash      String? // 64-hex
  sequence       Int? // strictly monotonic global
  createdAt      DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetTenantId, createdAt])
  @@index([createdAt])
  @@index([sequence])
  @@map("super_admin_audit_logs")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────
// AiInsightInbox — the agentic "did you notice?" stream.
//
// Produced by the scheduler's nightly scan over tenant data. Each row
// is one noteworthy observation (new overdue invoice, inventory below
// reorder, pipeline deal stale 14+ days, cash runway < 60 days…).
// Users see them in the top-right AI Inbox bell + on the dashboard.
//
// Dedup: `signalKey` is a composite of (kind + targetDocType + targetDocId)
// so re-scans don't re-create identical findings. Older entries can be
// acknowledged (user agreed, don't re-surface) or dismissed (user doesn't
// care, don't re-surface for N days — set by the generator).
// ─────────────────────────────────────────────────────────────────────
model AiInsightInbox {
  id               String   @id @default(cuid())
  tenantId         String
  // Deterministic signal identity — the (kind, targetDocType, targetDocId)
  // tuple hashed to a stable key. Guarantees we only insert one row per
  // (tenant, signal) at a time; re-scans update `lastSeenAt` instead.
  signalKey        String
  kind             String   // "revenue_drop" | "ar_overdue" | "pipeline_stale" | ...
  severity         String   @default("info") // "info" | "watch" | "critical"
  category         String   // "Revenue" | "AR" | "Pipeline" | "Cash" | "Inventory" | "HR" | "Operations"
  title            String
  finding          String   // 2-3 sentence explanation
  // Optional link to the related entity (invoice, customer, lead, item).
  targetDoctype    String?
  targetDocId      String?
  actionLabel      String?
  actionHref       String?
  // Numeric payload the generator can carry for the UI (e.g. amounts,
  // counts, percentages) without a schema change.
  dataJson         Json?

  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @default(now())
  acknowledgedAt   DateTime?
  acknowledgedBy   String?
  dismissedAt      DateTime?
  dismissedUntil   DateTime? // generator-controlled cooldown
  dismissedBy      String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, signalKey])
  @@index([tenantId, acknowledgedAt, dismissedAt])
  @@index([tenantId, severity, lastSeenAt])
  @@map("ai_insight_inbox")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────
// AiInboxTenantConfig — one-row-per-tenant config knobs for the inbox.
//
// Right now holds the operator-editable LLM system prompt that drives
// the pattern-match generator. Separate from AiInboxPreference because
// (a) it's tenant-level not per-user, (b) it carries free-form text an
// admin tunes to the tenant's business.
// ─────────────────────────────────────────────────────────────────────
model AiInboxTenantConfig {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  // Custom system prompt for the LLM pattern-match generator. When null,
  // the hard-coded default in ai-inbox-generators.ts is used.
  llmSystemPrompt String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ai_inbox_tenant_config")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────
// AiInboxPreference — per-user inbox + digest subscriptions.
//
// One row per user; stores which categories they want to see in the
// inbox + whether they want the daily email digest. Default (no row) =
// subscribed to everything + no email. Categories match the enum used
// by the generators ("Revenue" | "AR" | "Pipeline" | "Cash" | "Inventory"
// | "HR" | "Operations").
// ─────────────────────────────────────────────────────────────────────
model AiInboxPreference {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String   @unique
  mutedCategories String[] @default([])
  dailyDigest     Boolean  @default(false)
  // Min severity for inclusion in the digest email ("info" | "watch"
  // | "critical"). Default "watch" so admins aren't buried.
  digestMinSeverity String @default("watch")
  // Per-category delivery cadence. Shape: {Category: "daily"|"weekly"|"never"}.
  // Missing category falls back to the top-level `dailyDigest` toggle so
  // existing rows keep behaving the same.
  categoryFrequency Json?
  // Webhook delivery (Slack / MS Teams). `webhookType` is informational —
  // we POST the same block payload to both since Slack + Teams both
  // accept the simplified "text + blocks" shape most webhook consumers
  // expose. Delivered alongside (not instead of) the email digest.
  webhookUrl      String?
  webhookType     String?  // "slack" | "teams" | "generic"
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, dailyDigest])
  @@map("ai_inbox_preferences")
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────
// EntityInsight — AI-generated advisory per (doctype, docId).
//
// Fed by the LLM with the entity's own data plus (for sales-side entities)
// public web lookup. Cached per entity so a page visit doesn't re-burn
// API cost. The `inputFingerprint` is a hash of the entity + context the
// LLM saw — when the entity changes materially, the fingerprint shifts
// and the next GET regenerates automatically.
//
// Shape in `payloadJson`:
//   {
//     oneLiner: string,
//     bulletFindings: string[],
//     riskFlags: Array<{ severity: "low"|"med"|"high", label: string, why: string }>,
//     suggestedActions: Array<{ label: string, href?: string }>,
//     sources?: Array<{ title: string, url: string }>   // when web lookup fired
//   }
// ─────────────────────────────────────────────────────────────────────
model EntityInsight {
  id               String   @id @default(cuid())
  tenantId         String
  doctype          String   // "Lead" | "Customer" | "SalesInvoice" | "Employee" | "Item"
  docId            String
  payloadJson      Json
  model            String?  // the LLM that generated this (for provenance)
  inputFingerprint String   // sha256 of the inputs — regenerate when changes
  generatedAt      DateTime @default(now())
  // 24h TTL — GET returns the row if recent, else regenerates in-line.
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctype, docId])
  @@index([tenantId, generatedAt])
  @@map("entity_insights")
  @@schema("public")
}

// Per-tenant, per-prefix monotonic counter for name generation. Replaces the
// pre-turn-46 pattern of `SELECT max(name)+1` which races under concurrent
// writes (two clients read the same max, both format the same "next", the
// unique index throws for the second). Atomic upsert-and-increment via raw
// SQL in packages/db/src/naming.ts.
model NamingSeriesCounter {
  id       String @id @default(cuid())
  tenantId String
  prefix   String // e.g. "SINV-", "PE-", "EMP-"
  counter  Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, prefix])
  @@index([tenantId])
  @@map("naming_series_counters")
  @@schema("public")
}

model TaxTemplateRow {
  id            String  @id @default(cuid())
  taxTemplateId String
  description   String // e.g. "CGST", "SGST @ 9%", "VAT"
  rate          Decimal @db.Decimal(9, 4)
  accountId     String
  sortOrder     Int     @default(0)
  // B10 compound/cascading tax. Values:
  //   "On Net Total"          — default. amount = netTotal × rate/100.
  //   "On Previous Row Total" — compound. amount = (netTotal + sum of all
  //                             prior rows' taxAmount) × rate/100.
  //   "Actual"                — literal amount (ignore rate; use `amount`).
  chargeType    String  @default("On Net Total")
  amount        Decimal @default(0) @db.Decimal(18, 4) // used only when chargeType = "Actual"

  taxTemplate TaxTemplate @relation(fields: [taxTemplateId], references: [id], onDelete: Cascade)
  account     Account     @relation("TaxTemplateRowAccount", fields: [accountId], references: [id])

  @@index([taxTemplateId])
  @@map("tax_template_rows")
  @@schema("public")
}

// Applied tax lines snapshotted onto each invoice — decoupled from the
// TaxTemplate so template edits don't rewrite history. `taxAmount` is in the
// invoice's currency; multiplied by invoice.conversionRate for GL.

model SalesInvoiceTax {
  id             String  @id @default(cuid())
  salesInvoiceId String
  description    String
  rate           Decimal @db.Decimal(9, 4)
  taxAmount      Decimal @db.Decimal(18, 4)
  accountId      String
  taxTemplateId  String?
  chargeType     String  @default("On Net Total") // B10 snapshot of TaxTemplateRow.chargeType

  salesInvoice SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  account      Account      @relation("SITaxAccount", fields: [accountId], references: [id])
  taxTemplate  TaxTemplate? @relation(fields: [taxTemplateId], references: [id])

  @@index([salesInvoiceId])
  @@map("sales_invoice_taxes")
  @@schema("public")
}

model PurchaseInvoiceTax {
  id                String  @id @default(cuid())
  purchaseInvoiceId String
  description       String
  rate              Decimal @db.Decimal(9, 4)
  taxAmount         Decimal @db.Decimal(18, 4)
  accountId         String
  taxTemplateId     String?
  chargeType        String  @default("On Net Total") // B10

  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  account         Account         @relation("PITaxAccount", fields: [accountId], references: [id])
  taxTemplate     TaxTemplate?    @relation(fields: [taxTemplateId], references: [id])

  @@index([purchaseInvoiceId])
  @@map("purchase_invoice_taxes")
  @@schema("public")
}

// Snapshot of tax rows applied to a Quotation (B9). Same shape as SI/PI tax
// but tied to Quote — no GL implications (Quotations don't post).
model QuotationTax {
  id            String  @id @default(cuid())
  quotationId   String
  description   String
  rate          Decimal @db.Decimal(9, 4)
  taxAmount     Decimal @db.Decimal(18, 4)
  accountId     String
  taxTemplateId String?
  chargeType    String  @default("On Net Total") // B10

  quotation   Quotation    @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  account     Account      @relation("QuotationTaxAccount", fields: [accountId], references: [id])
  taxTemplate TaxTemplate? @relation(fields: [taxTemplateId], references: [id])

  @@index([quotationId])
  @@map("quotation_taxes")
  @@schema("public")
}

// Snapshot of tax rows applied to a Sales Order (B9). Propagated onto the
// generated Sales Invoice on convert-to-invoice.
model SalesOrderTax {
  id            String  @id @default(cuid())
  salesOrderId  String
  description   String
  rate          Decimal @db.Decimal(9, 4)
  taxAmount     Decimal @db.Decimal(18, 4)
  accountId     String
  taxTemplateId String?
  chargeType    String  @default("On Net Total") // B10

  salesOrder  SalesOrder   @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  account     Account      @relation("SalesOrderTaxAccount", fields: [accountId], references: [id])
  taxTemplate TaxTemplate? @relation(fields: [taxTemplateId], references: [id])

  @@index([salesOrderId])
  @@map("sales_order_taxes")
  @@schema("public")
}

// ---------- Fiscal Year + Period Close ----------
//
// Tenant-scoped named year (e.g. "FY 2025-26") bounded by startDate..endDate.
// `closedTill` locks GL posting: any postingDate <= closedTill is rejected
// by postGLEntries. Set at year-end close (typically closedTill = endDate) or
// mid-year to freeze prior months while the current month stays open.
//
// Only one FiscalYear per tenant may be flagged `isCurrent` at a time — used
// as the default for reports and budget scoping.

model FiscalYear {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  startDate  DateTime  @db.Date
  endDate    DateTime  @db.Date
  isCurrent  Boolean   @default(false)
  closedTill DateTime? @db.Date // GL entries with postingDate <= closedTill are blocked
  closedAt   DateTime?
  closedBy   String? // userId who closed
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budgets Budget[]

  @@unique([tenantId, name])
  @@index([tenantId, startDate, endDate])
  @@map("fiscal_years")
  @@schema("public")
}

// ---------- Budgets ----------
//
// One Budget row = one line item: a target amount for a specific Account within
// a FiscalYear. Multiple lines per fiscal year are typical (one per expense
// account). Actuals are computed on demand by summing GL entries against the
// same account within the fiscal year date range.

model Budget {
  id           String   @id @default(cuid())
  tenantId     String
  fiscalYearId String
  accountId    String
  annualAmount Decimal  @db.Decimal(18, 4)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  account    Account    @relation("BudgetAccount", fields: [accountId], references: [id])

  @@unique([fiscalYearId, accountId])
  @@index([tenantId, fiscalYearId])
  @@map("budgets")
  @@schema("public")
}

// ---------- HR: Leave ----------
//
// LeaveType is the master (Casual / Sick / Earned / etc.). LeaveAllocation
// grants an employee N days of a specific type within a date range (usually a
// fiscal or calendar year). LeaveApplication is an employee's request against
// a type — approved applications consume balance. Balance for a type at date T
// = sum(allocations covering T) − sum(approved applications overlapping [T, T]).

model LeaveType {
  id             String   @id @default(cuid())
  tenantId       String
  leaveTypeName  String
  isEncashable   Boolean  @default(false)
  maxDaysPerYear Int      @default(0) // informational; 0 = unlimited
  color          String? // Tailwind badge classes for calendars/lists
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations   LeaveAllocation[]
  applications  LeaveApplication[]
  policyDetails LeavePolicyDetail[]
  encashments   LeaveEncashment[]
  ledgerEntries LeaveLedgerEntry[]

  @@unique([tenantId, leaveTypeName])
  @@map("leave_types")
  @@schema("public")
}

model LeaveAllocation {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  leaveTypeId String
  fromDate    DateTime @db.Date
  toDate      DateTime @db.Date
  totalLeaves Decimal  @db.Decimal(9, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, leaveTypeId])
  @@index([tenantId, fromDate, toDate])
  @@map("leave_allocations")
  @@schema("public")
}

model LeaveApplication {
  id             String    @id @default(cuid())
  tenantId       String
  employeeId     String
  leaveTypeId    String
  fromDate       DateTime  @db.Date
  toDate         DateTime  @db.Date
  halfDay        Boolean   @default(false) // if true, totalLeaveDays = 0.5 regardless of range
  totalLeaveDays Decimal   @db.Decimal(9, 2) // computed at submit
  reason         String?
  status         String    @default("Draft") // Draft | Approved | Rejected | Cancelled
  approvedBy     String? // userId
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, status])
  @@index([tenantId, fromDate, toDate])
  @@map("leave_applications")
  @@schema("public")
}

// ---------- HR: Leave Ledger + supporting masters ----------
//
// LeaveLedgerEntry is the immutable append-only ledger of every event that
// changes an employee's leave balance for a given leave type: initial
// allocation, consumption on an approved application, adjustment
// (correction / carry-forward / gift), encashment, expiry. The 18-field
// Leave Ledger for Employee report reads directly off this table — no
// derivation from LeaveAllocation/LeaveApplication at query time.
//
// Backfill from existing allocations + approved applications is idempotent
// and lives in hr-service (see routes/leave-ledger.ts).

model LeaveLedgerEntry {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  leaveTypeId String
  postingDate DateTime @db.Date

  // The 18 fields the spec asks for on this ledger:
  entryType    String // Allocation | Consumption | Adjustment | Encashment | Expiry | CarryForward | Opening
  leaves       Decimal   @db.Decimal(9, 2) // signed: + credits balance, − debits it
  balanceAfter Decimal   @db.Decimal(9, 2) // running balance for this employee+type after this entry
  fromDate     DateTime? @db.Date // allocation/application window start
  toDate       DateTime? @db.Date // allocation/application window end

  workGroupId        String? // denormalized from Employee.workGroupId at write time
  employeeCategoryId String? // denormalized from Employee.employeeCategoryId at write time
  isCarryForward     Boolean @default(false)
  isExpired          Boolean @default(false)
  isEncashment       Boolean @default(false)

  sourceDoctype String? // "LeaveAllocation" | "LeaveApplication" | "LeaveEncashment" | "Adjustment"
  sourceDocId   String?
  reason        String?
  createdBy     String? // userId that produced the entry
  createdAt     DateTime @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType        LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  workGroup        WorkGroup?        @relation(fields: [workGroupId], references: [id])
  employeeCategory EmployeeCategory? @relation(fields: [employeeCategoryId], references: [id])

  @@index([tenantId, employeeId, leaveTypeId, postingDate])
  @@index([tenantId, postingDate])
  @@index([tenantId, entryType])
  @@index([tenantId, workGroupId])
  @@index([tenantId, employeeCategoryId])
  @@map("leave_ledger_entries")
  @@schema("public")
}

// WorkGroup — org unit smaller than Department, larger than a single team.
// Used by "Leave Entitlement by Work Group" and "WorkGroup Leave Allocation"
// dashboards + the ledger's workGroupId dimension.

model WorkGroup {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  code        String? // optional short code
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees     Employee[]
  ledgerEntries LeaveLedgerEntry[]

  @@unique([tenantId, name])
  @@map("work_groups")
  @@schema("public")
}

// EmployeeCategory — Permanent / Contract / Intern / Consultant / etc.
// Used by "Leave Distribution by Employee Category" and joins on the ledger.

model EmployeeCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees     Employee[]
  ledgerEntries LeaveLedgerEntry[]

  @@unique([tenantId, name])
  @@map("employee_categories")
  @@schema("public")
}

// ApproverHierarchy — explicit (employee, approver, level) triples so the
// "Leave Approval Hierarchy" dashboard can render as a graph/tree/flow.
// Complementary to (not a replacement for) Employee.managerEmployeeId /
// the workflow engine's role-based gates.

model ApproverHierarchy {
  id                 String   @id @default(cuid())
  tenantId           String
  employeeId         String
  approverEmployeeId String
  level              Int      @default(1) // 1 = direct manager, 2 = skip-level, ...
  scope              String   @default("Leave") // Leave | Expense | Timesheet | *
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation("HierarchyEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  approver Employee @relation("HierarchyApprover", fields: [approverEmployeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, approverEmployeeId, scope])
  @@index([tenantId, employeeId, scope, isActive])
  @@map("approver_hierarchies")
  @@schema("public")
}

// ---------- HR: Appraisal (E5) ----------
//
// AppraisalTemplate defines weighted KRAs (Key Result Areas). Each Appraisal
// instance is scored per-KRA on a 0-5 scale; finalScore is the weight-averaged
// composite. Appraiser + employee both stamped.

model AppraisalTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  goals      AppraisalTemplateGoal[]
  appraisals Appraisal[]

  @@unique([tenantId, name])
  @@map("appraisal_templates")
  @@schema("public")
}

model AppraisalTemplateGoal {
  id            String  @id @default(cuid())
  templateId    String
  kra           String // Key Result Area name
  description   String?
  weightPercent Decimal @db.Decimal(6, 2) // 0..100
  sortOrder     Int     @default(0)

  template AppraisalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("appraisal_template_goals")
  @@schema("public")
}

model Appraisal {
  id               String    @id @default(cuid())
  tenantId         String
  name             String // APP-0001
  employeeId       String
  templateId       String?
  periodStart      DateTime  @db.Date
  periodEnd        DateTime  @db.Date
  status           String    @default("Draft") // Draft | Completed | Cancelled
  finalScore       Decimal   @default(0) @db.Decimal(6, 3) // weighted average, 0..5
  appraiserId      String? // userId
  employeeRemarks  String?
  appraiserRemarks String?
  submittedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee                   @relation(fields: [employeeId], references: [id])
  template       AppraisalTemplate?         @relation(fields: [templateId], references: [id])
  goals          AppraisalGoal[]
  feedbackRounds AppraisalFeedbackRound[]

  @@unique([tenantId, name])
  @@unique([tenantId, employeeId, periodStart, periodEnd])
  @@index([tenantId, status])
  @@map("appraisals")
  @@schema("public")
}

// 360° feedback — invite peers, reports, manager, self to score the
// employee. One round per audience (Self / Manager / Peer / Report / Client).
// Responses accumulate on submit and are surfaced as an aggregated
// section on the Appraisal detail (avg per KRA + free-text bag).
model AppraisalFeedbackRound {
  id          String   @id @default(cuid())
  appraisalId String
  audience    String   // Self | Manager | Peer | Report | Client
  dueDate     DateTime? @db.Date
  status      String   @default("Open") // Open | Closed
  createdAt   DateTime @default(now())

  appraisal Appraisal                    @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  responses AppraisalFeedbackResponse[]

  @@index([appraisalId, audience])
  @@map("appraisal_feedback_rounds")
  @@schema("public")
}

model AppraisalFeedbackResponse {
  id           String   @id @default(cuid())
  roundId      String
  respondentEmail String  // may or may not resolve to an internal User
  respondentName  String?
  // Per-KRA scores as a JSON bag { kra: score }, 0..5.
  scoresJson   Json     @default("{}")
  comments     String?
  submittedAt  DateTime @default(now())
  // Anonymity flag — when true, UI hides respondentEmail from the
  // appraisee. Manager can still see it.
  isAnonymous  Boolean  @default(false)

  round AppraisalFeedbackRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, submittedAt])
  @@map("appraisal_feedback_responses")
  @@schema("public")
}

model AppraisalGoal {
  id            String  @id @default(cuid())
  appraisalId   String
  kra           String
  description   String?
  weightPercent Decimal @db.Decimal(6, 2)
  score         Decimal @default(0) @db.Decimal(6, 2) // 0..5
  weightedScore Decimal @default(0) @db.Decimal(8, 4) // score * weight%
  sortOrder     Int     @default(0)

  appraisal Appraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@index([appraisalId])
  @@map("appraisal_goals")
  @@schema("public")
}

// ---------- HR: Employee Advance (E4) ----------
//
// Salary advance / travel advance / expense float. Approve+Pay posts
//   DR Employee Advance (Asset/Receivable, party = Employee)
//   CR Bank | Cash
// Balance is drawn down by adjustments (payment-entry-referenced or
// expense-claim-linked). MVP just tracks advance ↔ paidAmount; adjustments
// deferred to E11-ish.

model EmployeeAdvance {
  id               String    @id @default(cuid())
  tenantId         String
  name             String // EA-0001
  employeeId       String
  postingDate      DateTime  @default(now()) @db.Date
  purpose          String
  advanceAmount    Decimal   @db.Decimal(18, 4)
  paidAmount       Decimal   @default(0) @db.Decimal(18, 4)
  returnAmount     Decimal   @default(0) @db.Decimal(18, 4)
  status           String    @default("Draft") // Draft | Approved | Paid | Cancelled
  modeOfPayment    String    @default("Bank")
  advanceAccountId String? // optional override; falls back to Employee Payable
  remarks          String?
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee @relation(fields: [employeeId], references: [id])
  advanceAccount Account? @relation("EmployeeAdvanceAccount", fields: [advanceAccountId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("employee_advances")
  @@schema("public")
}

// ---------- HR: Employee Checklist / Onboarding + Separation (E3) ----------
//
// One shared model for both flows (type = Onboarding | Separation) with a
// reusable Template. Completing all activities auto-flips the employee's
// status (Active on onboarding, Left on separation).

model EmployeeChecklistTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  type        String // Onboarding | Separation
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items      EmployeeChecklistTemplateItem[]
  checklists EmployeeChecklist[]

  @@unique([tenantId, name])
  @@index([tenantId, type])
  @@map("employee_checklist_templates")
  @@schema("public")
}

model EmployeeChecklistTemplateItem {
  id          String  @id @default(cuid())
  templateId  String
  activity    String
  description String?
  role        String? // suggested role that owns this step
  sortOrder   Int     @default(0)

  template EmployeeChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("employee_checklist_template_items")
  @@schema("public")
}

model EmployeeChecklist {
  id         String    @id @default(cuid())
  tenantId   String
  name       String // ONB-0001 or SEP-0001
  type       String // Onboarding | Separation
  employeeId String
  templateId String?
  startDate  DateTime  @default(now()) @db.Date
  targetDate DateTime? @db.Date
  status     String    @default("InProgress") // InProgress | Completed | Cancelled
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee                    @relation(fields: [employeeId], references: [id])
  template   EmployeeChecklistTemplate?  @relation(fields: [templateId], references: [id])
  activities EmployeeChecklistActivity[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, type, employeeId])
  @@map("employee_checklists")
  @@schema("public")
}

model EmployeeChecklistActivity {
  id          String    @id @default(cuid())
  checklistId String
  activity    String
  description String?
  role        String?
  sortOrder   Int       @default(0)
  isComplete  Boolean   @default(false)
  completedBy String?
  completedAt DateTime?

  checklist EmployeeChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@map("employee_checklist_activities")
  @@schema("public")
}

// ---------- HR: Payroll Entry (E2) ----------
//
// Header doc that batch-generates + submits Salary Slips for a period, then
// posts a single consolidated bank-payout JE (DR Employee Payable / CR Bank)
// to close out all Employee Payable balances in one shot.

model PayrollEntry {
  id                   String   @id @default(cuid())
  tenantId             String
  name                 String // PYE-0001
  startDate            DateTime @db.Date
  endDate              DateTime @db.Date
  postingDate          DateTime @default(now()) @db.Date
  department           String?
  designation          String?
  status               String   @default("Draft") // Draft | Submitted | Cancelled
  totalGross           Decimal  @default(0) @db.Decimal(18, 4)
  totalDeduction       Decimal  @default(0) @db.Decimal(18, 4)
  totalNet             Decimal  @default(0) @db.Decimal(18, 4)
  slipsCount           Int      @default(0)
  // Payout mode: Bank | Cash. On submit, posts DR Employee Payable / CR (Bank|Cash).
  paymentMode          String   @default("Bank")
  // The JournalEntry that closed the batch payout (populated on submit).
  payoutJournalEntryId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees PayrollEntryEmployee[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("payroll_entries")
  @@schema("public")
}

model PayrollEntryEmployee {
  id             String  @id @default(cuid())
  payrollEntryId String
  employeeId     String
  salarySlipId   String? // populated after generate
  gross          Decimal @default(0) @db.Decimal(18, 4)
  deduction      Decimal @default(0) @db.Decimal(18, 4)
  net            Decimal @default(0) @db.Decimal(18, 4)

  payrollEntry PayrollEntry @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])
  salarySlip   SalarySlip?  @relation(fields: [salarySlipId], references: [id])

  @@unique([payrollEntryId, employeeId])
  @@map("payroll_entry_employees")
  @@schema("public")
}

// ---------- HR: Holiday List (E1) ----------
//
// Named calendar of non-working days. Assigned to Employee (or fallback to
// Tenant.defaultHolidayListId). Payroll + attendance reports consult
// isHoliday(date, employeeId) to skip these dates.

model HolidayList {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  fromDate     DateTime @db.Date
  toDate       DateTime @db.Date
  weeklyOffDay String? // 0..6 (0=Sun) — auto-generated on create if set
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  holidays         Holiday[]
  employees        Employee[] @relation("EmployeeHolidayList")
  defaultForTenant Tenant[]   @relation("TenantDefaultHolidayList")

  @@unique([tenantId, name])
  @@map("holiday_lists")
  @@schema("public")
}

model Holiday {
  id            String   @id @default(cuid())
  holidayListId String
  holidayDate   DateTime @db.Date
  description   String
  isWeeklyOff   Boolean  @default(false)

  holidayList HolidayList @relation(fields: [holidayListId], references: [id], onDelete: Cascade)

  @@index([holidayListId, holidayDate])
  @@map("holidays")
  @@schema("public")
}

// ---------- HR: Salary Structure ----------
//
// A reusable template of earnings + deductions that can be assigned to an
// employee (Employee.salaryStructureId) or applied ad-hoc to generate a
// SalarySlip. Amounts are flat values in the tenant's baseCurrency; formula-
// based components (e.g. "10% of Basic") come later.

model SalaryStructure {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  components SalaryStructureComponent[]
  employees  Employee[]

  @@unique([tenantId, name])
  @@map("salary_structures")
  @@schema("public")
}

model SalaryStructureComponent {
  id                String  @id @default(cuid())
  salaryStructureId String
  componentName     String
  type              String // Earning | Deduction
  amount            Decimal @db.Decimal(18, 4)
  // Optional formula referencing prior components by name in {curlies}, e.g.
  //   "{Basic} * 0.1"  or  "({Basic} + {HRA}) * 0.05"
  // When set, `amount` is ignored — see evalFormula in packages/db/src/salary-formula.ts.
  // Only numeric literals, whitespace, +-*/(), and {ComponentName} tokens allowed.
  formula           String?
  sortOrder         Int     @default(0)

  salaryStructure SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)

  @@index([salaryStructureId])
  @@map("salary_structure_components")
  @@schema("public")
}

// ---------- HR: Shift ----------
//
// Named work-day pattern (e.g. "Morning" 09:00–17:00). Employees can have a
// default shift; individual Attendance rows can override it. Purely informational
// in the MVP — payroll doesn't yet use shift hours to prorate.

model ShiftType {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  startTime    String // "HH:MM"
  endTime      String // "HH:MM"
  workingHours Decimal  @default(8) @db.Decimal(5, 2)
  color        String? // Tailwind badge classes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees   Employee[]   @relation("EmployeeDefaultShift")
  attendances Attendance[]

  @@unique([tenantId, name])
  @@map("shift_types")
  @@schema("public")
}

// ---------- HR: Expense Claim ----------
//
// Employee logs reimbursable expenses grouped by type. On approve (= submit)
// the total posts GL: DR per item to the type's expenseAccount (or tenant
// default) / CR Employee Payable (party = employee via partyId reused). A
// subsequent PaymentEntry against Employee Payable settles the claim (Paid).

model ExpenseClaimType {
  id               String   @id @default(cuid())
  tenantId         String
  typeName         String
  // Which expense account this type debits. If null, falls back to
  // Tenant.defaultExpenseAccountId.
  expenseAccountId String?
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenseAccount Account?           @relation("ExpenseClaimTypeAccount", fields: [expenseAccountId], references: [id])
  items          ExpenseClaimItem[]

  @@unique([tenantId, typeName])
  @@map("expense_claim_types")
  @@schema("public")
}

model ExpenseClaim {
  id          String    @id @default(cuid())
  tenantId    String
  name        String // e.g. EXP-0001
  employeeId  String
  postingDate DateTime  @default(now())
  totalAmount Decimal   @db.Decimal(18, 4)
  status      String    @default("Draft") // Draft | Approved | Rejected | Paid | Cancelled
  approvedBy  String?
  approvedAt  DateTime?
  remarks     String?
  // Project attribution for profitability reporting.
  projectId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items       ExpenseClaimItem[]
  vehicleLogs VehicleLog[]       @relation("VehicleLogExpenseClaim")
  project     Project?           @relation("ExpenseClaimProject", fields: [projectId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("expense_claims")
  @@schema("public")
}

model ExpenseClaimItem {
  id                 String  @id @default(cuid())
  expenseClaimId     String
  expenseClaimTypeId String
  description        String?
  amount             Decimal @db.Decimal(18, 4)
  // Optional per-item override of the type's expense account. If null, uses
  // the type's account (which itself may fall back to tenant default).
  expenseAccountId   String?

  expenseClaim     ExpenseClaim     @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)
  expenseClaimType ExpenseClaimType @relation(fields: [expenseClaimTypeId], references: [id])
  expenseAccount   Account?         @relation("ExpenseClaimItemAccount", fields: [expenseAccountId], references: [id])

  @@index([expenseClaimId])
  @@map("expense_claim_items")
  @@schema("public")
}

// ---------- HR: Loans ----------
//
// LoanType is a reusable template (Personal Loan @ 10%, Salary Advance @ 0%,
// etc.). Loan represents an actual loan issued to an employee. On disburse,
// GL posts DR Loan Receivable / CR Cash|Bank and generates a fixed EMI
// schedule (equal monthly installments split into principal/interest). Each
// repayment posts DR Cash / CR Loan Receivable (principal) + CR Interest
// Income (interest portion). MVP restrictions: no prepayment, no
// restructuring, no late fees.

model LoanType {
  id                String   @id @default(cuid())
  tenantId          String
  loanTypeName      String
  interestRate      Decimal  @default(0) @db.Decimal(9, 4) // annual %
  defaultTermMonths Int      @default(12)
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loans  Loan[]

  @@unique([tenantId, loanTypeName])
  @@map("loan_types")
  @@schema("public")
}

model Loan {
  id               String    @id @default(cuid())
  tenantId         String
  name             String // LOAN-0001
  employeeId       String
  loanTypeId       String
  principal        Decimal   @db.Decimal(18, 4)
  interestRate     Decimal   @db.Decimal(9, 4) // snapshotted from type at create
  termMonths       Int
  emi              Decimal   @db.Decimal(18, 4) // computed at disburse
  disbursementDate DateTime? @db.Date
  status           String    @default("Draft") // Draft | Disbursed | Closed | Cancelled
  outstanding      Decimal   @default(0) @db.Decimal(18, 4) // remaining principal
  remarks          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  loanType LoanType                @relation(fields: [loanTypeId], references: [id])
  schedule LoanRepaymentSchedule[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
  @@map("loans")
  @@schema("public")
}

model LoanRepaymentSchedule {
  id              String    @id @default(cuid())
  loanId          String
  installmentNo   Int
  dueDate         DateTime  @db.Date
  principalAmount Decimal   @db.Decimal(18, 4)
  interestAmount  Decimal   @db.Decimal(18, 4)
  totalAmount     Decimal   @db.Decimal(18, 4)
  balanceAfter    Decimal   @db.Decimal(18, 4) // principal balance after this installment
  isPaid          Boolean   @default(false)
  paidAt          DateTime?
  paidBy          String? // userId
  paidVoucherType String? // "JournalEntry" or future dedicated LoanRepayment doctype
  paidVoucherId   String? // GL entries for this installment carry this reference

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@unique([loanId, installmentNo])
  @@index([loanId, isPaid])
  @@map("loan_repayment_schedules")
  @@schema("public")
}

// ---------- Projects ----------
//
// Project is an umbrella (customer-facing or internal). Task rolls up into
// Project. Timesheet is per-employee per-week with per-day per-project-per-task
// line items; on Timesheet submit, Task.actualHours += sum of matching lines.
// Billing (invoice-from-timesheet) is deferred to a future turn.

model Project {
  id               String    @id @default(cuid())
  tenantId         String
  name             String // PROJ-0001 style auto-numbered
  projectName      String
  customerId       String?
  projectManagerId String? // Employee.id
  startDate        DateTime? @db.Date
  endDate          DateTime? @db.Date
  status           String    @default("Open") // Open | Completed | Cancelled
  // Billing mode governs future timesheet-to-invoice behavior.
  billingType      String    @default("Non-billable") // Fixed | Hourly | Non-billable
  estimatedCost    Decimal   @default(0) @db.Decimal(18, 4)
  actualCost       Decimal   @default(0) @db.Decimal(18, 4) // computed from expenses/tickets later
  notes            String?
  customData       Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Projects-Plus additions — budgets are per-project totals used by the
  // budget-tracking widget on the project detail page; template linkage lets
  // future edits to the template propagate as suggestions rather than
  // silently rewriting live projects.
  budgetAmount       Decimal @default(0) @db.Decimal(18, 4)
  budgetSpent        Decimal @default(0) @db.Decimal(18, 4)
  budgetThresholdPct Int     @default(80) // fire an alert when spent >= this pct of budget
  fromTemplateId     String?

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer?        @relation(fields: [customerId], references: [id])
  projectManager Employee?        @relation("ProjectManager", fields: [projectManagerId], references: [id])
  tasks          Task[]
  timesheetLines TimesheetLine[]
  runningTimers  RunningTimer[]
  milestones     Milestone[]
  fromTemplate   ProjectTemplate? @relation("ProjectFromTemplate", fields: [fromTemplateId], references: [id])
  salesInvoices  SalesInvoice[]   @relation("SIProject")
  expenseClaims  ExpenseClaim[]   @relation("ExpenseClaimProject")
  issues         Issue[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("projects")
  @@schema("public")
}

model Task {
  id                 String    @id @default(cuid())
  tenantId           String
  projectId          String
  subject            String
  description        String?
  status             String    @default("Open") // Open | InProgress | Completed | Cancelled
  priority           String    @default("Medium") // Low | Medium | High | Urgent
  assignedEmployeeId String?
  startDate          DateTime? @db.Date
  endDate            DateTime? @db.Date
  // expectedHours = plan; actualHours = sum of timesheet lines targeting this task.
  expectedHours      Decimal   @default(0) @db.Decimal(9, 2)
  actualHours        Decimal   @default(0) @db.Decimal(9, 2)
  sortOrder          Int       @default(0)
  customData         Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Projects-Plus additions.
  // parentTaskId → subtask hierarchy (one level deep in the UI, but the
  // schema supports arbitrary nesting for future use).
  parentTaskId String?
  // milestoneId → group task under a Milestone for grouped Gantt/reporting.
  milestoneId  String?
  // Progress + weight for rollup-parent computation.
  progressPct  Int     @default(0) // 0..100
  weight       Int     @default(1) // relative weight in parent rollup

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedEmployee Employee?        @relation("TaskAssignee", fields: [assignedEmployeeId], references: [id])
  timesheetLines   TimesheetLine[]
  runningTimers    RunningTimer[]
  parentTask       Task?            @relation("TaskParent", fields: [parentTaskId], references: [id])
  subTasks         Task[]           @relation("TaskParent")
  milestone        Milestone?       @relation(fields: [milestoneId], references: [id])
  dependenciesOut  TaskDependency[] @relation("DependencyFrom")
  dependenciesIn   TaskDependency[] @relation("DependencyTo")

  @@index([tenantId, projectId, status])
  @@index([tenantId, assignedEmployeeId])
  @@index([projectId, parentTaskId])
  @@index([projectId, milestoneId])
  @@map("tasks")
  @@schema("public")
}

// ---------- Projects-Plus: Milestones + Dependencies + Templates ----------
//
// Milestone — grouping bucket inside a Project. Tasks link via milestoneId.
// Zoho's Gantt renders milestones as diamond markers at their dueDate.
model Milestone {
  id          String    @id @default(cuid())
  tenantId    String
  projectId   String
  name        String
  description String?
  dueDate     DateTime? @db.Date
  status      String    @default("Upcoming") // Upcoming | InProgress | Completed | Missed
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([tenantId, projectId, order])
  @@map("milestones")
  @@schema("public")
}

// TaskDependency — directed edge fromTask → toTask.
// type: FS = Finish-to-Start (toTask cannot start until fromTask finishes;
// the default). Extendable to SS/FF/SF later.
model TaskDependency {
  id         String   @id @default(cuid())
  fromTaskId String
  toTaskId   String
  type       String   @default("FS") // FS | SS | FF | SF
  createdAt  DateTime @default(now())

  fromTask Task @relation("DependencyFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask   Task @relation("DependencyTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId])
  @@index([toTaskId])
  @@map("task_dependencies")
  @@schema("public")
}

// ProjectTemplate — canned project blueprint. `structureJson` is the whole
// pre-filled project payload (name, description, budget) plus arrays of
// milestones and tasks to seed. `POST /project-templates/:id/instantiate`
// creates a real Project + Milestones + Tasks from it.
model ProjectTemplate {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  billingType   String   @default("Non-billable")
  defaultBudget Decimal  @default(0) @db.Decimal(18, 4)
  // Shape:
  //   { milestones: [{ name, dueOffsetDays }],
  //     tasks:      [{ subject, description?, expectedHours, weight,
  //                    milestoneRef?, dependsOnRefs? }] }
  structureJson Json
  usageCount    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projects Project[] @relation("ProjectFromTemplate")

  @@unique([tenantId, name])
  @@map("project_templates")
  @@schema("public")
}

// ---------- Zoho Sprints (Agile) ----------
//
// AgileWorkspace is the top-level container (equivalent to a "Project" in
// Zoho Sprints — we call it a workspace to keep it distinct from the
// Projects module's Project). One workspace has many Sprints, Epics,
// WorkItems, Releases, and OKRs. WorkItems are the atom: Story / Task /
// Bug / SubTask, each with points, priority, assignees, and a status that
// moves across the board.
model AgileWorkspace {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  key         String // short key like "LUM" prefixed on work-item names
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprints   Sprint[]
  epics     Epic[]
  workItems WorkItem[]
  releases  Release[]
  okrs      Okr[]

  @@unique([tenantId, key])
  @@index([tenantId, isActive])
  @@map("agile_workspaces")
  @@schema("public")
}

model Sprint {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  goal          String?
  status        String    @default("Planning") // Planning | Active | Completed | Cancelled
  startDate     DateTime? @db.Date
  endDate       DateTime? @db.Date
  actualStartAt DateTime? // when moved to Active
  actualEndAt   DateTime? // when moved to Completed
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace AgileWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItems WorkItem[]
  issues    Issue[]        @relation("IssueSprint")

  @@index([workspaceId, status])
  @@map("sprints")
  @@schema("public")
}

model Epic {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  color       String    @default("violet") // violet | blue | green | amber | rose
  status      String    @default("Open") // Open | InProgress | Completed | Cancelled
  targetDate  DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace AgileWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItems WorkItem[]

  @@index([workspaceId, status])
  @@map("epics")
  @@schema("public")
}

model Release {
  id          String    @id @default(cuid())
  workspaceId String
  name        String // e.g. "v1.4.0"
  description String?
  targetDate  DateTime? @db.Date
  releasedAt  DateTime?
  status      String    @default("Planned") // Planned | InProgress | Released | Cancelled
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace AgileWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workItems WorkItem[]
  issues    Issue[]        @relation("IssueRelease")

  @@index([workspaceId, status])
  @@map("releases")
  @@schema("public")
}

// WorkItem — the flexible unit. `type` selects Story / Task / Bug / SubTask.
// `parentWorkItemId` supports subtask hierarchy. `points` are story points
// used in velocity + burndown. Multiple assignees via `assigneeUserIds`.
model WorkItem {
  id               String    @id @default(cuid())
  workspaceId      String
  tenantId         String
  key              String // e.g. "LUM-42"
  type             String // Story | Task | Bug | SubTask
  title            String
  description      String?
  status           String    @default("Todo") // Todo | InProgress | InReview | Done | Cancelled
  priority         String    @default("Medium") // Low | Medium | High | Urgent
  points           Int? // story points
  assigneeUserIds  String[]
  reporterUserId   String?
  parentWorkItemId String?
  epicId           String?
  sprintId         String? // null = backlog
  releaseId        String?
  sortOrder        Int       @default(0)
  labels           String[]
  dueDate          DateTime? @db.Date
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace  AgileWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sprint     Sprint?        @relation(fields: [sprintId], references: [id])
  epic       Epic?          @relation(fields: [epicId], references: [id])
  release    Release?       @relation(fields: [releaseId], references: [id])
  parentItem WorkItem?      @relation("SubItems", fields: [parentWorkItemId], references: [id])
  subItems   WorkItem[]     @relation("SubItems")

  @@unique([workspaceId, key])
  @@index([tenantId, status])
  @@index([workspaceId, sprintId, status])
  @@index([workspaceId, epicId])
  @@index([workspaceId, parentWorkItemId])
  @@map("work_items")
  @@schema("public")
}

// Okr — objective. Each has a small number of KeyResults with a target
// value + current progress used to compute completion percentage.
model Okr {
  id          String   @id @default(cuid())
  workspaceId String
  objective   String
  description String?
  ownerUserId String?
  period      String // e.g. "Q3 2026"
  status      String   @default("OnTrack") // OnTrack | AtRisk | OffTrack | Completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  AgileWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  keyResults KeyResult[]

  @@index([workspaceId, period, status])
  @@map("okrs")
  @@schema("public")
}

model KeyResult {
  id           String  @id @default(cuid())
  okrId        String
  title        String
  targetValue  Decimal @db.Decimal(18, 4)
  currentValue Decimal @default(0) @db.Decimal(18, 4)
  unit         String? // %, deals, MRR $, users, etc.
  sortOrder    Int     @default(0)

  okr Okr @relation(fields: [okrId], references: [id], onDelete: Cascade)

  @@index([okrId])
  @@map("key_results")
  @@schema("public")
}

model Timesheet {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String // TS-0001
  employeeId         String
  weekStartDate      DateTime @db.Date // Monday of the week (informational — lines can span dates)
  totalHours         Decimal  @default(0) @db.Decimal(9, 2)
  totalBillableHours Decimal  @default(0) @db.Decimal(9, 2)
  totalBillingAmount Decimal  @default(0) @db.Decimal(18, 4)
  status             String   @default("Draft") // Draft | Submitted | Cancelled
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  lines    TimesheetLine[]

  @@unique([tenantId, name])
  @@index([tenantId, employeeId, weekStartDate])
  @@index([tenantId, status])
  @@map("timesheets")
  @@schema("public")
}

// Issue tracker — engineering-style bug/issue records scoped to a
// Project. Distinct from DeskTicket (customer support) — Issues are
// owned by the engineering team and roll up to Sprints / Releases.
model Issue {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String // ISSUE-0001
  projectId          String
  title              String
  description        String? // markdown
  priority           String   @default("Medium") // Low | Medium | High | Critical
  severity           String   @default("Minor") // Minor | Major | Blocker
  status             String   @default("Open") // Open | InProgress | InReview | Resolved | Closed | WontFix
  issueType          String   @default("Bug") // Bug | Enhancement | Task | Question
  reporterUserId     String
  assignedEmployeeId String?
  sprintId           String?
  releaseId          String?
  environment        String? // e.g. "prod eu-west-1", "staging"
  reproSteps         String?
  labels             String[] @default([])
  dueDate            DateTime? @db.Date
  closedAt           DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedEmployee  Employee? @relation("IssueAssignee", fields: [assignedEmployeeId], references: [id])
  sprint            Sprint?   @relation("IssueSprint", fields: [sprintId], references: [id])
  release           Release?  @relation("IssueRelease", fields: [releaseId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, projectId, status])
  @@index([tenantId, assignedEmployeeId, status])
  @@index([tenantId, sprintId])
  @@map("issues")
  @@schema("public")
}

// Start/stop timer. At most one Running row per user; on stop we roll
// elapsed minutes into a new TimesheetLine in the user's Draft
// weekly Timesheet (auto-created if none exists for the current week).
//
// projectId + taskId locked at start so switching tasks means Stop +
// Start (matches how Toggl / Harvest work — prevents ambiguous logs).
model RunningTimer {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String   @unique  // enforce one active timer per user
  employeeId  String   // resolved at start so stop knows which timesheet to append to
  projectId   String
  taskId      String?
  isBillable  Boolean  @default(false)
  billingRate Decimal  @default(0) @db.Decimal(18, 4)
  description String?
  startedAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])
  task     Task?    @relation(fields: [taskId], references: [id])

  @@index([tenantId, employeeId])
  @@map("running_timers")
  @@schema("public")
}

model TimesheetLine {
  id                 String   @id @default(cuid())
  timesheetId        String
  projectId          String
  taskId             String?
  date               DateTime @db.Date
  hours              Decimal  @db.Decimal(9, 2)
  isBillable         Boolean  @default(false)
  billingRate        Decimal  @default(0) @db.Decimal(18, 4)
  billingAmount      Decimal  @default(0) @db.Decimal(18, 4) // hours * billingRate at line-save time
  description        String?
  // Set by projects-service /timesheets/:id/convert-to-invoice when a billable
  // line rolls into a Draft SalesInvoiceItem. Prevents double-billing.
  salesInvoiceItemId String?

  timesheet        Timesheet         @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  project          Project           @relation(fields: [projectId], references: [id])
  task             Task?             @relation(fields: [taskId], references: [id])
  salesInvoiceItem SalesInvoiceItem? @relation("TSLineToSILine", fields: [salesInvoiceItemId], references: [id])

  @@index([timesheetId])
  @@index([projectId])
  @@index([taskId])
  @@index([salesInvoiceItemId])
  @@map("timesheet_lines")
  @@schema("public")
}

// ---------- Assets ----------
//
// AssetCategory bundles the 3 accounts every asset in that category posts to:
//   assetAccount            (Asset)      — debited on acquisition, credited on scrap
//   accumDepreciationAccount(Asset contra)— credited on each depreciation booking
//   depExpenseAccount       (Expense)    — debited on each depreciation booking
// Asset submit optionally posts DR asset / CR acquisition account (Cash/Bank/
// Creditors) — for MVP simplicity. In real flow assets get created via a PI
// where the PI's DR should be re-mapped to the asset account (deferred).

model AssetCategory {
  id                         String   @id @default(cuid())
  tenantId                   String
  categoryName               String
  assetAccountId             String
  accumDepreciationAccountId String
  depExpenseAccountId        String
  defaultUsefulLifeMonths    Int      @default(36)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  tenant                   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assetAccount             Account @relation("AssetCategoryAssetAccount", fields: [assetAccountId], references: [id])
  accumDepreciationAccount Account @relation("AssetCategoryAccumDepAccount", fields: [accumDepreciationAccountId], references: [id])
  depExpenseAccount        Account @relation("AssetCategoryDepExpenseAccount", fields: [depExpenseAccountId], references: [id])
  assets                   Asset[]
  itemsUsingAsDefault      Item[]  @relation("ItemDefaultAssetCategory")

  @@unique([tenantId, categoryName])
  @@map("asset_categories")
  @@schema("public")
}

model Asset {
  id                          String   @id @default(cuid())
  tenantId                    String
  assetCode                   String // AST-0001 auto-numbered
  assetName                   String
  categoryId                  String
  purchaseDate                DateTime @db.Date
  purchasePrice               Decimal  @db.Decimal(18, 4)
  salvageValue                Decimal  @default(0) @db.Decimal(18, 4)
  usefulLifeMonths            Int
  depreciationMethod          String   @default("Straight Line") // Straight Line | WDV
  // Annual % for WDV method (e.g. 15.0 for a computer under Indian Companies
  // Act). Null with method=WDV means "auto-derive so book value hits salvage".
  wdvAnnualRatePct            Decimal? @db.Decimal(9, 4)
  // Auto-created from a PI line when Item.isAsset (B4). Null for manually
  // entered assets. Used to render "Created from PI" on the asset detail.
  sourcePurchaseInvoiceItemId String?
  // currentValue = purchasePrice − accumulated booked depreciation. Kept as a
  // materialized column so reports don't need to sum schedule rows.
  currentValue                Decimal  @db.Decimal(18, 4)
  status                      String   @default("Draft") // Draft | Depreciating | FullyDepreciated | Scrapped | Cancelled
  location                    String?
  notes                       String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  tenant                    Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category                  AssetCategory               @relation(fields: [categoryId], references: [id])
  schedule                  AssetDepreciationSchedule[]
  maintenanceLogs           AssetMaintenanceLog[]
  sourcePurchaseInvoiceItem PurchaseInvoiceItem?        @relation("PIItemToAsset", fields: [sourcePurchaseInvoiceItemId], references: [id])
  vehicles                  Vehicle[]                   @relation("VehicleAsset")

  @@unique([tenantId, assetCode])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@map("assets")
  @@schema("public")
}

model AssetDepreciationSchedule {
  id            String    @id @default(cuid())
  assetId       String
  installmentNo Int
  dueDate       DateTime  @db.Date
  amount        Decimal   @db.Decimal(18, 4)
  balanceAfter  Decimal   @db.Decimal(18, 4) // book value after this installment
  isBooked      Boolean   @default(false)
  bookedAt      DateTime?
  bookedBy      String? // userId

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, installmentNo])
  @@index([assetId, isBooked])
  @@map("asset_depreciation_schedules")
  @@schema("public")
}

model AssetMaintenanceLog {
  id              String   @id @default(cuid())
  assetId         String
  date            DateTime @db.Date
  maintenanceType String // Preventive | Corrective | Calibration | ...
  cost            Decimal  @default(0) @db.Decimal(18, 4)
  performedBy     String? // free text or employee name
  notes           String?
  createdAt       DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, date])
  @@map("asset_maintenance_logs")
  @@schema("public")
}

// ---------- Fleet: Vehicle + Vehicle Log (Module 48) ----------
//
// Vehicle master (license plate, make/model, VIN) + a running log of
// odometer / fuel / expense events. Optional link to an Asset row so
// depreciation + finance-lens still work; when unlinked, treat the
// Vehicle as a lightweight fleet record without an accounting spine.
//
// Vehicle Log entries also link (optionally) to an ExpenseClaim so
// fuel receipts / toll tags roll up into the driver's monthly claim.

model Vehicle {
  id              String    @id @default(cuid())
  tenantId        String
  licensePlate    String // Primary identifier — unique per tenant.
  make            String?
  model           String?
  vin             String?
  fuelType        String? // Petrol | Diesel | Electric | CNG | ...
  color           String?
  yearOfMake      Int?
  assetId         String? // Optional link to the finance Asset row.
  currentOdometer Int       @default(0) // km / miles — kept as-is per tenant.
  lastServiceDate DateTime? @db.Date
  disabled        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset  Asset?       @relation("VehicleAsset", fields: [assetId], references: [id])
  logs   VehicleLog[]

  @@unique([tenantId, licensePlate])
  @@index([tenantId, disabled])
  @@map("vehicles")
  @@schema("public")
}

model VehicleLog {
  id             String   @id @default(cuid())
  tenantId       String
  vehicleId      String
  logDate        DateTime @db.Date
  logType        String // Odometer | Fuel | Expense | Service
  odometer       Int? // reading at time of log
  fuelQty        Decimal? @db.Decimal(10, 3) // litres / gallons
  fuelRate       Decimal? @db.Decimal(10, 3) // per unit
  amount         Decimal? @db.Decimal(18, 4) // total (fuelQty*fuelRate, or expense sum)
  vendor         String?
  driverName     String?
  notes          String?
  // Optional link to an ExpenseClaim so fuel receipts roll into the
  // driver's monthly reimbursement flow. Null = standalone log entry.
  expenseClaimId String?
  createdAt      DateTime @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle      Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  expenseClaim ExpenseClaim? @relation("VehicleLogExpenseClaim", fields: [expenseClaimId], references: [id])

  @@index([tenantId, vehicleId])
  @@index([tenantId, logDate])
  @@map("vehicle_logs")
  @@schema("public")
}

// ---------- Manufacturing: Workstation + Operations + Job Card ----------
//
// Workstation is a resource (machine, cell, bench) with a per-hour cost.
// BOMOperation is one step in a BOM's routing (uses a Workstation, has an
// expected time-in-minutes and hour rate — hour rate is snapshotted from the
// workstation at BOMOperation-create time so BOM cost stays stable if the
// workstation rate changes later).
// On Work Order create, each BOMOperation is copied into a WorkOrderOperation
// (frozen snapshot for that WO). Job Cards log actual work against a specific
// WorkOrderOperation; on completion, the card's minutes + qty roll up into the
// WorkOrderOperation's actualTimeMins + completedQty. No GL posting in MVP —
// labor cost tracking + WIP accounting is deferred.

model Workstation {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String
  hourRate           Decimal  @default(0) @db.Decimal(18, 4)
  workingHoursPerDay Decimal  @default(8) @db.Decimal(5, 2)
  description        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bomOperations        BOMOperation[]
  woOperations         WorkOrderOperation[]
  jobCards             JobCard[]
  routingOperations    RoutingOperation[]    @relation("RoutingOpWorkstation")
  maintenanceRequests  MaintenanceRequest[]  @relation("MaintenanceRequestWorkstation")
  maintenanceSchedules MaintenanceSchedule[] @relation("MaintenanceScheduleWorkstation")
  machineLoggers       MachineLogger[]       @relation("MachineLoggerWorkstation")

  @@unique([tenantId, name])
  @@map("workstations")
  @@schema("public")
}

model BOMOperation {
  id            String  @id @default(cuid())
  bomId         String
  operationName String
  workstationId String
  timeInMins    Decimal @db.Decimal(10, 2) // per BOM run (BOM.qty units)
  hourRate      Decimal @db.Decimal(18, 4) // snapshot from workstation
  sortOrder     Int     @default(0)

  bom         BOM         @relation(fields: [bomId], references: [id], onDelete: Cascade)
  workstation Workstation @relation(fields: [workstationId], references: [id])

  @@index([bomId])
  @@map("bom_operations")
  @@schema("public")
}

model WorkOrderOperation {
  id             String  @id @default(cuid())
  workOrderId    String
  operationName  String
  workstationId  String
  timeInMins     Decimal @db.Decimal(10, 2) // planned (scaled to WO.qty from BOM)
  hourRate       Decimal @db.Decimal(18, 4)
  completedQty   Decimal @default(0) @db.Decimal(18, 4) // units passed through this op
  actualTimeMins Decimal @default(0) @db.Decimal(10, 2) // cumulative from Job Cards
  status         String  @default("Pending") // Pending | InProgress | Completed
  sortOrder      Int     @default(0)

  workOrder   WorkOrder   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  workstation Workstation @relation(fields: [workstationId], references: [id])
  jobCards    JobCard[]

  @@index([workOrderId])
  @@map("work_order_operations")
  @@schema("public")
}

model JobCard {
  id            String    @id @default(cuid())
  tenantId      String
  name          String // JC-0001
  workOrderId   String
  operationId   String // -> WorkOrderOperation.id
  workstationId String
  // C12: optional Employee link (in addition to the free-text name for
  // legacy). Kept both because operators may not be linked users yet.
  employeeId    String?
  employeeName  String? // free text (or Employee link later)
  startedAt     DateTime?
  completedAt   DateTime?
  // C12: `totalTimeMins` is now the sum of all TimeLog session minutes,
  // recomputed on pause / complete. `status = Paused` is a new intermediate
  // state between InProgress and Completed.
  totalTimeMins Decimal   @default(0) @db.Decimal(10, 2)
  quantity      Decimal   @default(0) @db.Decimal(18, 4) // units produced on this card
  status        String    @default("Open") // Open | InProgress | Paused | Completed | Cancelled
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  operation   WorkOrderOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  workstation Workstation        @relation(fields: [workstationId], references: [id])
  employee    Employee?          @relation("JobCardEmployee", fields: [employeeId], references: [id])
  timeLogs    JobCardTimeLog[]

  @@unique([tenantId, name])
  @@index([tenantId, workOrderId, status])
  @@map("job_cards")
  @@schema("public")
}

// C12: one per start/pause pair. `toTime` null = the log is currently open
// (card is InProgress). Complete closes any open log using completedAt.
model JobCardTimeLog {
  id        String    @id @default(cuid())
  jobCardId String
  fromTime  DateTime
  toTime    DateTime?
  minutes   Decimal   @default(0) @db.Decimal(10, 2)

  jobCard JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
  @@map("job_card_time_logs")
  @@schema("public")
}

// ---------- Custom Fields (meta-driven layer) ----------
//
// Tenants can add arbitrary fields to any doctype without a schema migration.
// Meta lives here (CustomField). Values live in the target row's `customData
// Json?` column (JSONB) keyed by `fieldName`. Server-side validation happens
// in each service's upsert schema against the meta for that (tenant, doctype).
//
// Doctypes that currently support customData (in MVP): Customer, Supplier,
// Item, Employee. Others are added by dropping in a `customData Json?` column
// + a passthrough in the route's zod schema — no other service changes needed.

model CustomField {
  id           String   @id @default(cuid())
  tenantId     String
  doctype      String // e.g. "Customer" — must match a supported doctype
  // Machine name for the JSONB key: snake_case, unique per (tenant, doctype).
  fieldName    String
  label        String // Human-facing label
  fieldType    String // Text | LongText | Number | Date | Boolean | Select | Link | Table
  // Type-specific options as JSON:
  //   Select: { choices: string[] }
  //   Number: { min?: number, max?: number, step?: number }
  //   Text/LongText: { maxLength?: number }
  //   Link:   { linkDoctype: "Employee" | "Customer" | ... }  (I1)
  //   Table:  { subFields: [{ fieldName, label, fieldType, options?, isRequired? }] }  (I2)
  options      Json?
  isRequired   Boolean  @default(false)
  sortOrder    Int      @default(0)
  helpText     String?
  // I4: server-enforced validation rules
  regexPattern String?
  isUnique     Boolean  @default(false)
  readOnly     Boolean  @default(false)
  hiddenIf     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctype, fieldName])
  @@index([tenantId, doctype])
  @@map("custom_fields")
  @@schema("public")
}

// ---------- Compliance: Data Subject Request (O2) ----------
//
// GDPR / DPDPA-style request from a party (Customer, Supplier, Employee) or
// a portal user for data export or erasure. Kept as a durable audit trail
// even when the underlying party is later anonymized.

model DataSubjectRequest {
  id             String    @id @default(cuid())
  tenantId       String
  name           String // DSR-0001
  kind           String // Export | Erasure
  subjectType    String // Customer | Supplier | Employee | PortalUser
  subjectId      String
  subjectEmail   String? // frozen at request time
  status         String    @default("Received") // Received | InProgress | Completed | Rejected
  requestedBy    String? // portalUserId or staff userId
  outputPath     String? // export file location on server
  completedAt    DateTime?
  rejectedReason String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, subjectType, subjectId])
  @@map("data_subject_requests")
  @@schema("public")
}

// ---------- Compliance: Data Retention Policy (O4) ----------
//
// Rolling window per doctype — rows older than `retainDays` are candidates
// for the purge runner. `strategy` picks how they're removed:
//   delete      → hard delete
//   anonymize   → keep row but scrub PII fields (email/mobile/etc.)
//   archive     → move to a separate archive table (future)

model DataRetentionPolicy {
  id         String    @id @default(cuid())
  tenantId   String
  doctype    String
  retainDays Int
  strategy   String    @default("anonymize") // delete | anonymize | archive
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctype])
  @@index([tenantId, enabled])
  @@map("data_retention_policies")
  @@schema("public")
}

// Append-only consent log — each portal-user opt-in/opt-out creates a new row.
// Latest row per portalUserId is the current state; older rows preserve the
// audit trail for GDPR/DPDP proof-of-consent.
model ConsentRecord {
  id            String   @id @default(cuid())
  tenantId      String
  portalUserId  String
  essential     Boolean  @default(true)
  analytics     Boolean  @default(false)
  marketing     Boolean  @default(false)
  policyVersion String? // opaque tag, tenants bump when they change their notice
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, portalUserId, createdAt])
  @@map("consent_records")
  @@schema("public")
}

// Encrypted snapshot of a party's PII taken immediately before anonymization.
// Enables restoration under legal hold — the ciphertext blob can be decrypted
// with MASTER_SECRET_KEY (same envelope as TenantIntegration.secrets). We do
// NOT expose a "restore" API — that must be a manual, audited operation.
model AnonymizationArchive {
  id            String   @id @default(cuid())
  tenantId      String
  subjectType   String // Customer | Supplier | Employee
  subjectId     String
  dsrId         String? // optional link to the DSR that triggered erasure
  cipher        Json // { enc, alg, iv, tag, ct } from secrets-crypto
  fieldsChanged String[] // audit — which columns were nulled
  createdAt     DateTime @default(now())
  createdBy     String? // userId or portalUserId

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, createdAt])
  @@map("anonymization_archives")
  @@schema("public")
}

// ---------- Ops: Feature Flags (M4) ----------

model FeatureFlag {
  id             String   @id @default(cuid())
  tenantId       String
  key            String
  label          String
  description    String?
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, enabled])
  @@map("feature_flags")
  @@schema("public")
}

// ---------- Ops: Backup Job (M5) ----------

model BackupJob {
  id           String    @id @default(cuid())
  tenantId     String
  kind         String    @default("full")
  status       String    @default("Pending")
  outputPath   String?
  sizeBytes    BigInt?
  startedAt    DateTime?
  finishedAt   DateTime?
  error        String?
  // S3 offsite copy — populated when the tenant has an active
  // `provider="s3"` TenantIntegration and the upload succeeded. Null means
  // the backup only lives on the host volume — operators must copy off-host
  // manually. `s3Key` is the object key inside the tenant's bucket.
  s3Key        String?
  s3UploadedAt DateTime?
  createdAt    DateTime  @default(now())

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  verifications BackupVerification[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("backup_jobs")
  @@schema("public")
}

// Weekly integrity check on the newest Succeeded BackupJob per tenant. The
// verify job runs `pg_restore --list` against the .sql (either local or
// S3-downloaded copy) which parses the archive's table-of-contents header
// without actually restoring — catches: file truncated, wrong format, bit
// rot, S3 partial download, missing pg_dump exit-code detection. Cheap
// enough to run on a fresh copy of every backup; doesn't need a scratch DB.
//
// Full test-restore into a scratch DB is a follow-up (needs superuser or
// CREATEDB on the app role + cleanup semantics).
model BackupVerification {
  id          String   @id @default(cuid())
  tenantId    String
  backupJobId String
  // "Succeeded" — pg_restore --list parsed the TOC without error.
  // "Failed"    — archive corrupt / truncated / wrong format / missing.
  status      String
  // "local" (from outputPath) or "s3" (downloaded from s3Key). Preferred is
  // "s3" when available so we exercise the offsite copy, not just the local
  // volume — proves the S3 bytes are still readable.
  source      String
  verifiedAt  DateTime @default(now())
  error       String?

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  backupJob BackupJob @relation(fields: [backupJobId], references: [id], onDelete: Cascade)

  @@index([tenantId, verifiedAt])
  @@index([backupJobId])
  @@map("backup_verifications")
  @@schema("public")
}

// ---------- Ops: Error Log (M6) ----------

model ErrorLog {
  id         String   @id @default(cuid())
  tenantId   String?
  service    String
  requestId  String?
  path       String
  method     String
  statusCode Int
  message    String
  stack      String?
  userId     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([service, createdAt])
  @@map("error_logs")
  @@schema("public")
}

// ---------- Integrations (L1) ----------
//
// TenantIntegration = a per-tenant connection to a named third-party
// (Razorpay, Stripe, Slack, S3, Google Calendar, generic Webhook). Credentials
// live in `secrets Json` and are considered opaque; the calling adapter
// decides which keys to read. Never returned via GET verbatim — the CRUD
// route redacts before serializing.

model TenantIntegration {
  id        String   @id @default(cuid())
  tenantId  String
  provider  String
  name      String
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  config    Json     @default("{}")
  secrets   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webhooks WebhookSubscription[]
  events   IntegrationEvent[]

  @@unique([tenantId, provider, name])
  @@index([tenantId, provider])
  @@map("tenant_integrations")
  @@schema("public")
}

// ---------- AI-assisted features (Module 54) ----------
//
// Two AI use cases sharing common infra:
//   1. Invoice extraction — upload a PDF/image of a supplier invoice,
//      LLM parses it into a Draft PurchaseInvoice for one-click submit.
//   2. Ticket triage — new DeskTicket → LLM suggests priority + category
//      + matching KB articles. High-confidence auto-applied; others
//      surfaced for agent review.
//
// The LLM provider is pluggable — reads from TenantIntegration
// (provider="openai"|"anthropic"|"google"). Every call is logged to
// the extraction / suggestion table so ops can trace token spend +
// audit AI decisions later.

model AIExtractionJob {
  id            String    @id @default(cuid())
  tenantId      String
  // What we're extracting into. v1: "PurchaseInvoice". Extensible for
  // future targets (SalesOrder from customer PO, expense receipt, etc.).
  targetDoctype String    @default("PurchaseInvoice")
  // Source file — store the ID of an Attachment row (existing infra)
  // so we don't duplicate the blob. sourceKind describes what we
  // received ("pdf" | "image" | "text").
  attachmentId  String?
  sourceKind    String    @default("pdf")
  // Status transitions: Queued → Running → Extracted → Confirmed |
  // Failed | Discarded. Confirmed = operator created the target
  // doctype from the extract.
  status        String    @default("Queued")
  // Raw model output (structured JSON matching a target-specific
  // shape). Kept for audit + re-parse if the shape evolves.
  rawOutput     Json?
  // The created target document once the operator confirms.
  //   PurchaseInvoice: stores the PI id here as a string; typed FK
  //   would fragment for future target types.
  createdDocId  String?
  errorMessage  String?
  // LLM cost tracking. Denormalized so we don't need to join a
  // separate usage log for a common query.
  provider      String? // "openai" | "anthropic" | ...
  model         String? // "gpt-4o" | "claude-3-5-sonnet" | ...
  inputTokens   Int?
  outputTokens  Int?
  latencyMs     Int?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  createdBy     String? // userId

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("ai_extraction_jobs")
  @@schema("public")
}

model AITicketSuggestion {
  id                 String   @id @default(cuid())
  tenantId           String
  ticketId           String
  // The AI's suggestions. All optional — LLM may punt on any of
  // these when confidence is low.
  suggestedPriority  String? // Urgent | High | Medium | Low
  suggestedCategory  String? // free-text; matched against tenant's category list
  matchingArticleIds String[] @default([])
  suggestedResponse  String? // draft canned-response body
  // 0-100 confidence score. When >= autoApplyThreshold (tenant
  // setting; default 80), the corresponding fields are applied to
  // the ticket automatically at create time.
  confidence         Int      @default(0)
  autoApplied        Boolean  @default(false)
  // LLM cost + audit — same pattern as AIExtractionJob.
  provider           String?
  model              String?
  inputTokens        Int?
  outputTokens       Int?
  latencyMs          Int?
  createdAt          DateTime @default(now())

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket DeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId]) // at most one suggestion per ticket
  @@index([tenantId, createdAt])
  @@map("ai_ticket_suggestions")
  @@schema("public")
}

// ---------- Duplicate detection + merge (Module 55) ----------
//
// Scanner emits DuplicateReview rows — one per candidate pair with
// score >= threshold. Operators triage in the UI (Accept → merge;
// Dismiss → mark not-a-dup; Snooze → hide for 30d).
//
// Merge writes a DuplicateMerge audit row (never mutable) capturing:
//   * keeperId (the survivor)
//   * mergedId (the eliminated row)
//   * doctype (Customer | Supplier | Item)
//   * fkCounts (JSON summary of what FKs were re-pointed)
//   * mergedSnapshot (frozen JSON of the eliminated row for rollback)

model DuplicateReview {
  id          String    @id @default(cuid())
  tenantId    String
  // Doctype the pair belongs to. Keep as string (not enum) so future
  // doctypes plug in without a schema migration.
  doctype     String // "Customer" | "Supplier" | "Item"
  leftId      String
  rightId     String
  score       Int // 0-100
  breakdown   Json // { name, email, gstin, pan, phone }
  status      String    @default("Pending") // Pending | Merged | Dismissed | Snoozed
  snoozeUntil DateTime?
  scannedAt   DateTime  @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // (leftId, rightId) ordering is normalized in the scanner (smaller
  // id first) so a re-scan doesn't create both A-B and B-A rows.
  @@unique([tenantId, doctype, leftId, rightId])
  @@index([tenantId, doctype, status])
  @@index([tenantId, score])
  @@map("duplicate_reviews")
  @@schema("public")
}

model DuplicateMerge {
  id             String   @id @default(cuid())
  tenantId       String
  doctype        String
  keeperId       String
  mergedId       String
  // Per-model summary of FK re-pointing: { PurchaseInvoice: 12, SalesOrder: 3, ... }
  fkCounts       Json
  // Frozen snapshot of the eliminated row for potential rollback.
  mergedSnapshot Json
  mergedBy       String?
  mergedAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, doctype])
  @@index([tenantId, mergedAt])
  @@map("duplicate_merges")
  @@schema("public")
}

// ---------- FX Revaluation (Module 57) ----------
//
// One row per revaluation run. Snapshots the rates used, the resulting
// per-doc lines, the totals, and the auto-posted JournalEntry id.
//
// Lifecycle: Preview → Committed | Discarded.
// A Preview row is created when the operator hits "Preview" so we
// have an audit trail even for scenarios that weren't posted. Only
// Committed rows create a JE.

model FxRevaluationRun {
  id             String    @id @default(cuid())
  tenantId       String
  // Business date being revalued (period-end). Used for the posted JE.
  asOfDate       DateTime  @db.Date
  // Snapshot of the rate table used at run time — currency → rate.
  ratesJson      Json
  // Full computed summary (lines + totals + skipped) at preview time.
  summaryJson    Json
  status         String    @default("Preview") // Preview | Committed | Discarded
  // Set once Committed. Cancelling the JE via the JE detail page does
  // NOT clear this — the run row remains with status=Committed as
  // audit. Operators wanting to undo a reval should reverse the JE.
  journalEntryId String?   @unique
  createdAt      DateTime  @default(now())
  createdBy      String?
  committedAt    DateTime?
  committedBy    String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation("FxRevalJE", fields: [journalEntryId], references: [id])

  @@index([tenantId, asOfDate])
  @@index([tenantId, status])
  @@map("fx_revaluation_runs")
  @@schema("public")
}

model WebhookSubscription {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  targetUrl     String
  events        String[] @default([])
  signingSecret String
  isActive      Boolean  @default(true)
  integrationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration TenantIntegration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  deliveries  WebhookDelivery[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("webhook_subscriptions")
  @@schema("public")
}

model WebhookDelivery {
  id             String    @id @default(cuid())
  subscriptionId String
  tenantId       String
  eventKey       String
  payload        Json
  status         String    @default("Pending")
  attempts       Int       @default(0)
  lastStatusCode Int?
  lastError      String?
  scheduledFor   DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, scheduledFor])
  @@index([subscriptionId, createdAt])
  @@map("webhook_deliveries")
  @@schema("public")
}

model IntegrationEvent {
  id            String    @id @default(cuid())
  tenantId      String
  integrationId String
  provider      String
  eventKey      String
  externalId    String
  payload       Json
  status        String    @default("Received")
  processedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration TenantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, provider, status])
  @@map("integration_events")
  @@schema("public")
}

// ---------- Portal Users (K1) ----------
//
// PortalUser is a public-facing account scoped to exactly one party
// (Customer or Supplier). Auth is separate from staff Users — different JWT
// audience, different login endpoint. Middleware populates req.portal =
// { partyType, partyId } so downstream routes can filter by that party.

model PortalUser {
  id           String    @id @default(cuid())
  tenantId     String
  email        String
  passwordHash String?
  partyType    String // Customer | Supplier
  partyId      String
  displayName  String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  // Any portal JWT with iat < tokenEpoch is rejected. Bumped on portal
  // change-password so a stolen portal token dies immediately on credential
  // rotation. Same design as User.tokenEpoch.
  tokenEpoch   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invites        PortalInvite[]
  tickets        PortalTicket[]
  consentRecords ConsentRecord[]

  @@unique([tenantId, email])
  @@index([tenantId, partyType, partyId])
  @@map("portal_users")
  @@schema("public")
}

model PortalInvite {
  id           String    @id @default(cuid())
  tenantId     String
  portalUserId String
  tokenHash    String    @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portalUser PortalUser @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, portalUserId])
  @@map("portal_invites")
  @@schema("public")
}

model PortalTicket {
  id           String   @id @default(cuid())
  tenantId     String
  name         String // TKT-0001
  portalUserId String
  partyType    String
  partyId      String
  subject      String
  status       String   @default("Open") // Open | Answered | Closed
  priority     String   @default("Normal")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portalUser PortalUser          @relation(fields: [portalUserId], references: [id], onDelete: Cascade)
  replies    PortalTicketReply[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("portal_tickets")
  @@schema("public")
}

model PortalTicketReply {
  id             String   @id @default(cuid())
  portalTicketId String
  body           String
  authorType     String // portal | staff
  authorId       String
  createdAt      DateTime @default(now())

  ticket PortalTicket @relation(fields: [portalTicketId], references: [id], onDelete: Cascade)

  @@index([portalTicketId, createdAt])
  @@map("portal_ticket_replies")
  @@schema("public")
}

// ---------- Import Jobs (J1) ----------
//
// Tracks a bulk CSV/JSON import request. Rows are persisted to
// ImportJobRow so a user can drill into which specific records failed. The
// job goes Draft → Running → Completed | Failed | Cancelled.

model ImportJob {
  id            String    @id @default(cuid())
  tenantId      String
  name          String // IMP-0001
  doctype       String
  ownerUserId   String
  fileName      String?
  mode          String    @default("create") // create | upsert | update
  keyField      String? // for upsert/update — natural key column
  totalRows     Int       @default(0)
  succeededRows Int       @default(0)
  failedRows    Int       @default(0)
  dryRun        Boolean   @default(true)
  status        String    @default("Draft") // Draft | Queued | Running | Completed | Failed | Cancelled
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows   ImportJobRow[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("import_jobs")
  @@schema("public")
}

model ImportJobRow {
  id           String  @id @default(cuid())
  importJobId  String
  rowNumber    Int
  status       String  @default("Pending") // Pending | Succeeded | Failed
  action       String? // created | updated | skipped
  targetId     String? // id of the created/updated row
  errorMessage String?
  rawJson      Json // original parsed cells (kept for retry/diff)

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId, status])
  @@map("import_job_rows")
  @@schema("public")
}

// ---------- Export Preset (J6) ----------
//
// Saved column/filter/sort layout for repeated exports of a doctype. Owner
// can share tenant-wide via isShared. Different from SavedReport in that
// its intended use is one-shot CSV/JSON download (no rendering).

model ExportPreset {
  id          String   @id @default(cuid())
  tenantId    String
  doctype     String
  ownerUserId String
  name        String
  isShared    Boolean  @default(false)
  columns     Json
  filters     Json?
  sortBy      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctype, name])
  @@map("export_presets")
  @@schema("public")
}

// ---------- List Views (I3) ----------
//
// User-defined column/filter layout for a list page.

model ListView {
  id          String   @id @default(cuid())
  tenantId    String
  doctype     String
  ownerUserId String
  name        String
  isShared    Boolean  @default(false)
  isDefault   Boolean  @default(false)
  columns     Json
  filters     Json?
  sortBy      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctype, name])
  @@index([tenantId, doctype, ownerUserId])
  @@map("list_views")
  @@schema("public")
}

// ---------- Saved Reports (Report Builder) ----------
//
// User-defined queries over a reportable doctype. Definition lives in JSONB
// so we don't have to schema-migrate every time the runner supports a new
// column/filter capability. The runner (packages/db/src/report-runner.ts)
// validates the definition against the doctype meta registry.
//
//   definition: {
//     columns: string[]        // ["name", "customer.customerName", "grandTotal"]
//     filters: {               // AND-composed
//       field: string, op: "eq"|"neq"|"gt"|"gte"|"lt"|"lte"|"in"|"contains", value: any
//     }[]
//     sortBy: { field: string, dir: "asc"|"desc" }[]
//     limit?: number
//   }

model SavedReport {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  doctype     String
  ownerUserId String
  // Any tenant user can read + run when isShared = true; else owner-only.
  isShared    Boolean  @default(false)
  // G5: role-scoped sharing. If non-empty, only users with at least one of
  // these roles can see the report (in addition to owner). Ignored when
  // isShared is true (visible to everyone in tenant).
  sharedRoles String[] @default([])
  description String?
  definition  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookmarks        ReportBookmark[]
  scheduledReports ScheduledReport[]

  @@unique([tenantId, name])
  @@index([tenantId, doctype])
  @@index([tenantId, ownerUserId])
  @@map("saved_reports")
  @@schema("public")
}

// ---------- Print: Letterhead (H1) ----------
//
// Per-tenant letterhead(s) rendered on printed docs. Logo is stored as a
// base64 data URI (data:image/png;base64,...) so the PDF renderer can embed
// it inline. When `appliesToDoctypes` is empty, this letterhead is available
// as a generic option; a request can be pinned to a specific letterhead via
// `?letterheadId=`. `isDefault` marks the fallback pick when none is chosen.

model Letterhead {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  logoBase64        String? // data URI (data:image/png;base64,...)
  addressText       String? // plain text — rendered as-is under the logo
  footerText        String? // plain text — rendered on the last page
  isDefault         Boolean  @default(false)
  appliesToDoctypes String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posProfiles POSProfile[] @relation("POSProfileLetterhead")

  @@unique([tenantId, name])
  @@index([tenantId, isDefault])
  @@map("letterheads")
  @@schema("public")
}

// ---------- Print: Print Format (H2) ----------
//
// Per-doctype tweaks to the built-in PDF template. All fields are optional
// overrides — templates apply them additively (headerText / footerText /
// thankYouNote / termsText) and toggle sections (showItemDescription,
// showTaxBreakdown, showRemarks). `isDefault` marks the format used when a
// request doesn't specify `?formatId=`.

model PrintFormat {
  id                  String   @id @default(cuid())
  tenantId            String
  doctype             String
  name                String
  isDefault           Boolean  @default(false)
  headerText          String?
  footerText          String?
  thankYouNote        String?
  termsText           String?
  showItemDescription Boolean  @default(true)
  showTaxBreakdown    Boolean  @default(true)
  showRemarks         Boolean  @default(true)
  paperSize           String   @default("A4") // A4 | Letter | Legal
  orientation         String   @default("portrait") // portrait | landscape
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctype, name])
  @@index([tenantId, doctype, isDefault])
  @@map("print_formats")
  @@schema("public")
}

// ---------- Analytics: Dashboard (G1) ----------

model Dashboard {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  ownerUserId String
  isShared    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cards      DashboardCard[]
  bookmarks  DashboardBookmark[]
  shareLinks AnalyticsShareLink[]

  @@unique([tenantId, name])
  @@index([tenantId, ownerUserId])
  @@map("dashboards")
  @@schema("public")
}

model DashboardCard {
  id          String  @id @default(cuid())
  dashboardId String
  kind        String // KPI | LineChart | BarChart | PieChart | Table | SavedReport | Text
  title       String
  subtitle    String?
  config      Json // shape depends on kind — see resolveCard()
  gridCol     Int     @default(0)
  gridRow     Int     @default(0)
  gridWidth   Int     @default(4)
  gridHeight  Int     @default(2)
  sortOrder   Int     @default(0)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("dashboard_cards")
  @@schema("public")
}

model DashboardBookmark {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  dashboardId String
  createdAt   DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, dashboardId])
  @@map("dashboard_bookmarks")
  @@schema("public")
}

// ---------- Analytics: Report Bookmark (G6) ----------

model ReportBookmark {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  savedReportId String
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savedReport SavedReport @relation(fields: [savedReportId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, savedReportId])
  @@map("report_bookmarks")
  @@schema("public")
}

// ---------- Analytics: Share Link ----------
// Public, token-signed view of a Dashboard. Anyone with the URL can view
// (optionally password-protected, optionally expiring). Zoho-Analytics-style
// "share a dashboard with a client without giving them a user account".
model AnalyticsShareLink {
  id              String    @id @default(cuid())
  tenantId        String
  dashboardId     String
  token           String    @unique
  createdByUserId String
  label           String? // optional human name for the link
  passwordHash    String? // bcrypt hash if password-protected
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime  @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([tenantId, dashboardId])
  @@index([tenantId, isActive])
  @@map("analytics_share_links")
  @@schema("public")
}

// ---------- Analytics: Scheduled Report (G7) ----------

model ScheduledReport {
  id            String    @id @default(cuid())
  tenantId      String
  name          String // SCH-0001
  savedReportId String
  frequency     String // Daily | Weekly | Monthly
  hourOfDay     Int       @default(9)
  dayOfWeek     Int       @default(1) // 0..6 for Weekly
  dayOfMonth    Int       @default(1) // 1..28 for Monthly
  emailTo       String // comma-separated emails
  format        String    @default("csv") // csv | json
  enabled       Boolean   @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  savedReport SavedReport @relation(fields: [savedReportId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, enabled, frequency])
  @@map("scheduled_reports")
  @@schema("public")
}

// ---------- Collaboration: Attachments / Comments / Notifications / Todos ----------
//
// All 4 are cross-cutting: any doctype+docId can have attachments and
// comments; notifications and todos may optionally link to a doctype+docId.
// File bytes live in the DB (Bytes column) for MVP simplicity — no S3, no
// disk paths. Fine for demos and small files; a real deployment would swap
// this for object storage.

// ---------- Zoho-Learn-style LMS ----------
// Courses contain ordered Lessons. A Lesson has a JSON block body (same
// shape as Notes — text/checklist/divider), an optional embedded Quiz, and
// a duration estimate. Users enroll in a course, mark lessons complete,
// and (once every lesson w/ a quiz has been passed) receive a Certificate.
model LearnCourse {
  id               String   @id @default(cuid())
  tenantId         String
  ownerUserId      String
  name             String
  description      String?
  coverColor       String   @default("violet") // matches notebook palette
  category         String? // e.g. "Sales onboarding"
  estimatedMinutes Int      @default(0) // rollup convenience — sum of lessons' durations
  isPublished      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lessons      LearnLesson[]
  enrollments  LearnEnrollment[]
  certificates LearnCertificate[]

  @@index([tenantId, isPublished])
  @@map("learn_courses")
  @@schema("public")
}

model LearnLesson {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  body            Json // block array — same shape as Note body
  quiz            Json? // { passingScore: 70, questions: [{ q, options: [str], correctIndex, explanation? }] }
  sortOrder       Int      @default(0)
  durationMinutes Int      @default(5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course   LearnCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LearnLessonProgress[]

  @@index([courseId, sortOrder])
  @@map("learn_lessons")
  @@schema("public")
}

model LearnEnrollment {
  id              String    @id @default(cuid())
  tenantId        String
  courseId        String
  userId          String
  enrolledAt      DateTime  @default(now())
  completedAt     DateTime?
  progressPercent Int       @default(0) // 0..100
  currentLessonId String?

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course   LearnCourse           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LearnLessonProgress[]

  @@unique([tenantId, userId, courseId])
  @@index([tenantId, userId])
  @@map("learn_enrollments")
  @@schema("public")
}

model LearnLessonProgress {
  id           String   @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())
  quizScore    Int? // 0..100 if a quiz was submitted
  quizPassed   Boolean?

  enrollment LearnEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     LearnLesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
  @@map("learn_lesson_progress")
  @@schema("public")
}

model LearnCertificate {
  id                String   @id @default(cuid())
  tenantId          String
  userId            String
  courseId          String
  certificateNumber String // e.g. LC-2026-000042 — unique per tenant
  issuedAt          DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course LearnCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, certificateNumber])
  @@unique([tenantId, userId, courseId])
  @@index([tenantId, userId])
  @@map("learn_certificates")
  @@schema("public")
}

// ---------- Zoho-Notebook-style notes ----------
// Personal (or team) notes organized into notebooks. Body is a JSON array
// of blocks — each block is either a text paragraph, a checklist item, or
// a divider. Keeps the model flexible without becoming a full doc editor.
model Notebook {
  id          String    @id @default(cuid())
  tenantId    String
  ownerUserId String
  name        String
  color       String    @default("violet") // violet | blue | green | amber | rose | slate
  icon        String?
  isShared    Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notes  Note[]

  @@index([tenantId, ownerUserId, archivedAt])
  @@map("notebooks")
  @@schema("public")
}

model Note {
  id          String    @id @default(cuid())
  tenantId    String
  notebookId  String
  ownerUserId String
  title       String
  body        Json // [{ type: 'text', text: string } | { type: 'checklist', text: string, done: boolean } | { type: 'divider' }]
  type        String    @default("Mixed") // Text | Checklist | Mixed
  tags        String[]
  color       String    @default("default") // default | yellow | pink | mint | sky | lilac
  pinned      Boolean   @default(false)
  archivedAt  DateTime?
  deletedAt   DateTime?
  reminderAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notebook Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@index([tenantId, notebookId, deletedAt, archivedAt])
  @@index([tenantId, ownerUserId, pinned, deletedAt, archivedAt])
  @@map("notes")
  @@schema("public")
}

// ---------- Zoho-WorkDrive-style file library ----------
// A standalone hierarchical file system distinct from doctype attachments.
// Folders form a tree via parentId; files live inside a folder (or root);
// each file has one-or-more versions (immutable history); optional public
// share tokens with password + expiry.
model WorkDriveFolder {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  parentId        String?
  createdByUserId String
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   WorkDriveFolder?  @relation("WorkDriveFolderTree", fields: [parentId], references: [id])
  children WorkDriveFolder[] @relation("WorkDriveFolderTree")
  files    WorkDriveFile[]

  @@index([tenantId, parentId, deletedAt])
  @@map("workdrive_folders")
  @@schema("public")
}

model WorkDriveFile {
  id              String    @id @default(cuid())
  tenantId        String
  folderId        String? // null = drive root
  name            String
  mimeType        String
  size            Int
  starred         Boolean   @default(false)
  deletedAt       DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder     WorkDriveFolder?       @relation(fields: [folderId], references: [id])
  versions   WorkDriveFileVersion[]
  shareLinks WorkDriveShareLink[]
  comments   WorkDriveComment[]

  @@index([tenantId, folderId, deletedAt])
  @@index([tenantId, starred, deletedAt])
  @@map("workdrive_files")
  @@schema("public")
}

model WorkDriveFileVersion {
  id               String   @id @default(cuid())
  fileId           String
  version          Int // 1-based, monotonically increasing per file
  size             Int
  mimeType         String
  bytes            Bytes? // one of bytes / storageKey is set (matches Attachment pattern)
  storageKey       String?
  uploadedByUserId String
  note             String? // "changed cover", "revised numbers", etc.
  createdAt        DateTime @default(now())

  file WorkDriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@index([fileId])
  @@map("workdrive_file_versions")
  @@schema("public")
}

model WorkDriveShareLink {
  id              String    @id @default(cuid())
  tenantId        String
  fileId          String
  token           String    @unique
  createdByUserId String
  label           String?
  passwordHash    String?
  expiresAt       DateTime?
  isActive        Boolean   @default(true)
  viewCount       Int       @default(0)
  lastViewedAt    DateTime?
  createdAt       DateTime  @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  file   WorkDriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([tenantId, fileId])
  @@index([tenantId, isActive])
  @@map("workdrive_share_links")
  @@schema("public")
}

model WorkDriveComment {
  id        String   @id @default(cuid())
  fileId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  file WorkDriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@map("workdrive_comments")
  @@schema("public")
}

model Attachment {
  id         String   @id @default(cuid())
  tenantId   String
  doctype    String // Any doctype string
  docId      String
  filename   String
  mimeType   String
  size       Int
  // Exactly one of bytes / storageKey is set. bytes is used when the tenant
  // has no S3 integration; storageKey is the object key in the tenant's
  // default S3-provider bucket. Downloads route based on which is populated.
  bytes      Bytes?
  storageKey String?
  uploadedBy String // userId
  uploadedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, doctype, docId])
  @@index([tenantId, uploadedBy])
  @@map("attachments")
  @@schema("public")
}

model Comment {
  id           String   @id @default(cuid())
  tenantId     String
  doctype      String
  docId        String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, doctype, docId])
  @@map("comments")
  @@schema("public")
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String // Recipient
  subject   String
  body      String?
  // Optional link to a doctype+docId — enables "click to open source doc" in UI.
  doctype   String?
  docId     String?
  isRead    Boolean  @default(false)
  // F: bucket used to check NotificationPreference toggles + digests.
  category  String   @default("direct") // workflow | mentions | digests | direct | updates | broadcast
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
  @@schema("public")
}

// ---------- Communication: Email Template (F1) ----------
//
// Reusable email template with {{var}} substitution. Render helper in
// packages/db/src/comm-render.ts.

model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  subject   String
  body      String // supports {{var}} placeholders
  category  String? // free-form grouping ("invoice", "onboarding", ...)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@unique([tenantId, name])
  @@map("email_templates")
  @@schema("public")
}

// ---------- Communication: Email Message (F2) ----------
//
// Outbound email queue. Enqueue with POST /emails/send or /emails/send-from-template.
// Process with POST /emails/process (cron-triggered): flushes Pending → Sent using
// SMTP env or logs to stdout in fake mode.

model EmailMessage {
  id                String    @id @default(cuid())
  tenantId          String
  toEmail           String
  ccEmail           String?
  bccEmail          String?
  subject           String
  body              String
  // status extended to include Suppressed (matched a Suppression row pre-send)
  status            String    @default("Pending") // Pending | Sending | Sent | Failed | Cancelled | Suppressed
  attempts          Int       @default(0)
  lastError         String?
  templateId        String?
  senderUserId      String? // who triggered the send
  linkedDoctype     String?
  linkedId          String?
  scheduledFor      DateTime?
  sentAt            DateTime?
  providerMessageId String?
  // P1 additions
  fromEmail         String? // per-message override; falls back to tenant default
  fromName          String?
  trackingEnabled   Boolean   @default(false) // wrap links + inject pixel when true (transactional opt-in)
  trackingId        String?   @unique // set when trackingEnabled; used by /t/o/:id + /t/c/:id
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template       EmailTemplate?  @relation(fields: [templateId], references: [id])
  trackingEvents TrackingEvent[]

  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, linkedDoctype, linkedId])
  @@map("email_messages")
  @@schema("public")
}

// ---------- Communication: SMS Template + Message (F3) ----------

model SmsTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  body      String // supports {{var}} placeholders
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages SmsMessage[]

  @@unique([tenantId, name])
  @@map("sms_templates")
  @@schema("public")
}

model SmsMessage {
  id                String    @id @default(cuid())
  tenantId          String
  toMobile          String
  body              String
  status            String    @default("Pending") // Pending|Sending|Sent|Failed|Cancelled|Delivered|Undelivered
  attempts          Int       @default(0)
  lastError         String?
  templateId        String?
  senderUserId      String?
  linkedDoctype     String?
  linkedId          String?
  scheduledFor      DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime? // P2: set by Twilio/MSG91 delivery-receipt webhook
  providerMessageId String?
  providerName      String? // P2: twilio | msg91 | plivo | test (fake mode)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template SmsTemplate? @relation(fields: [templateId], references: [id])

  @@index([tenantId, status, scheduledFor])
  @@map("sms_messages")
  @@schema("public")
}

// ---------- Communication: DocSubscription (F5) ----------
//
// "Watch this document" — user subscribes to a specific (doctype, docId). Any
// comment / status change / workflow transition on that doc notifies all
// subscribers.

model DocSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  doctype   String
  docId     String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, doctype, docId])
  @@index([tenantId, doctype, docId])
  @@map("doc_subscriptions")
  @@schema("public")
}

// ---------- Communication: NotificationPreference (F6) ----------
//
// Per-user delivery preferences by (category × channel). Absent row = default
// (in-app on, email/sms off).

model NotificationPreference {
  id       String  @id @default(cuid())
  tenantId String
  userId   String
  category String // workflow | mentions | digests | direct | updates | broadcast
  channel  String // inapp | email | sms
  enabled  Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, category, channel])
  @@map("notification_preferences")
  @@schema("public")
}

// ---------- Communication: Digest Schedule (F7) ----------

model DigestSchedule {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  frequency  String // Daily | Weekly
  sections   Json // e.g. ["sales_invoices","payments","expense_claims","leaves"]
  hourOfDay  Int       @default(9) // 0..23 in tenant local (UTC for MVP)
  dayOfWeek  Int       @default(1) // 0..6, used when Weekly
  enabled    Boolean   @default(true)
  lastSentAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, frequency])
  @@index([tenantId, enabled, frequency])
  @@map("digest_schedules")
  @@schema("public")
}

// ---------- Communication: Broadcast (F8) ----------
//
// One-shot email blast to a filtered audience of parties. Materializes into N
// EmailMessage rows; the broadcast row itself just tracks the launch.

model Broadcast {
  id             String    @id @default(cuid())
  tenantId       String
  name           String // BR-0001
  subject        String
  body           String
  templateId     String?
  audience       String // Customers | Suppliers | Employees | Leads | CustomList
  filter         Json? // additional filter (e.g. {customerGroupId: "..."})
  recipientCount Int       @default(0)
  status         String    @default("Draft") // Draft | Queued | Sent | Cancelled
  scheduledFor   DateTime?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("broadcasts")
  @@schema("public")
}

// ---------- Marketing P1: Suppression list (listmonk parity) ----------
//
// Per-tenant email blocklist. Populated by:
//   - Hard bounce webhook (SES/Mailgun/Postmark/SendGrid) → 1× → auto-insert
//   - Complaint webhook → 1× → auto-insert
//   - Manual admin add (support case, GDPR erase, spam-folder report)
//   - CSV import
// Send pipeline queries this table before every SendEmail — any hit is dropped
// with status="Suppressed" on the CampaignRecipient/EmailMessage row.
model Suppression {
  id         String   @id @default(cuid())
  tenantId   String
  email      String // lowercased on insert
  reason     String // HardBounce | Complaint | Manual | GdprErase | SpamFolder | Import
  source     String? // ses | mailgun | postmark | sendgrid | manual | api | import
  detail     String? // provider-specific bounce/complaint reason
  campaignId String? // if bounce was tied to a specific campaign send
  createdAt  DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId, reason])
  @@map("suppressions")
  @@schema("public")
}

// ---------- Marketing P1: TrackingEvent (per-open/click/bounce log) ----------
//
// One row per tracking event. Rolled-up counters live on Campaign/CampaignRecipient
// for cheap reads; this table backs detail views + timeline analytics.
// Types: Open, Click, Delivered, Bounce, Complaint, Unsubscribe, Deferred, Suppressed
model TrackingEvent {
  id             String   @id @default(cuid())
  tenantId       String
  campaignId     String?
  recipientId    String? // CampaignRecipient FK if known
  emailMessageId String? // EmailMessage FK for transactional-side events
  type           String // see comment above
  targetUrl      String? // Click: destination URL (raw, pre-rewrite)
  ip             String?
  userAgent      String?
  meta           Json? // provider payload excerpt for audit / debugging
  occurredAt     DateTime @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign  Campaign?          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipient CampaignRecipient? @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  message   EmailMessage?      @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([tenantId, campaignId, type])
  @@index([tenantId, occurredAt])
  @@index([recipientId])
  @@index([emailMessageId])
  @@map("tracking_events")
  @@schema("public")
}

// ---------- Marketing P1: MediaAsset (marketing image/file library) ----------
//
// Separate from generic Attachment because marketing needs: folder-org, image
// dimensions for the email editor, and per-tenant dedup by sha256 (uploading
// the same logo 20× stores once).
model MediaAsset {
  id          String   @id @default(cuid())
  tenantId    String
  folder      String   @default("root") // pseudo-folder for admin UI org
  filename    String // as uploaded
  storageKey  String // S3 key or local relative path
  contentType String
  sizeBytes   Int
  width       Int? // for images
  height      Int?
  sha256      String // dedup key within tenant
  uploadedBy  String? // userId
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sha256])
  @@index([tenantId, folder])
  @@map("media_assets")
  @@schema("public")
}

// ---------- Marketing P2: A/B testing (CampaignVariant) ----------
//
// Optional per-Campaign fan-out. When a Campaign has variants, the send
// pipeline assigns each CampaignRecipient a variant using the weightPercent
// values (rounded up to 100%). Winner-picker scheduler tick promotes the
// best variant by open/click rate after N% of recipients have been sent.
model CampaignVariant {
  id            String   @id @default(cuid())
  tenantId      String
  campaignId    String
  variantKey    String // "A" | "B" | "C" (limit 3 in code)
  weightPercent Int // e.g. 33 / 33 / 34; must sum to 100 at commit time
  subject       String? // override; falls back to campaign.subject
  bodyHtml      String? // override; falls back to campaign.bodyHtml
  fromEmail     String?
  fromName      String?
  totalSent     Int      @default(0)
  totalOpened   Int      @default(0)
  totalClicked  Int      @default(0)
  totalBounced  Int      @default(0)
  isWinner      Boolean  @default(false) // true after winner-picker promotes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign   Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@unique([campaignId, variantKey])
  @@index([tenantId, campaignId])
  @@map("campaign_variants")
  @@schema("public")
}

// ---------- Marketing P2: MarketingJourney (multi-step automation graph) ----------
//
// Visual journey: a directed graph of Trigger → Wait → Action → Branch nodes.
// nodesJson + edgesJson store the graph as JSON blobs (React Flow-compatible
// shape). Scheduler tick advances JourneyEnrollment.currentNodeId per graph.
// Journey types: Manual (POST /enroll), ListAdd (webhook from ContactList.add),
// LeadCreated, FormSubmit, TagAdded, ScheduledDate.
model MarketingJourney {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  status         String   @default("Draft") // Draft | Active | Paused | Archived
  triggerType    String // Manual | ListAdd | LeadCreated | FormSubmit | TagAdded | ScheduledDate
  triggerConfig  Json? // e.g. {listId} for ListAdd, {formId} for FormSubmit, {tagName} for TagAdded
  // Graph: React Flow-compatible shape { nodes: [{id, type, position, data}], edges: [{id, source, target, label?}] }
  nodesJson      Json     @default("[]")
  edgesJson      Json     @default("[]")
  totalEnrolled  Int      @default(0)
  totalCompleted Int      @default(0)
  totalFailed    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments JourneyEnrollment[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("marketing_journeys")
  @@schema("public")
}

// Per-contact position in a journey graph. Scheduler tick queries
// (status=Active, nextTickAt <= now) and advances the enrollment through the
// node graph. Node "action" types (SendEmail/SendSms/SendWhatsapp) enqueue
// their respective message row and set nextTickAt = now (fall-through).
// Node "wait" type sets nextTickAt = now + wait duration.
model JourneyEnrollment {
  id            String    @id @default(cuid())
  tenantId      String
  journeyId     String
  contactType   String // Customer | Lead
  contactId     String
  emailTo       String?
  mobileTo      String?
  currentNodeId String? // null before start; final node's id on complete
  status        String    @default("Active") // Active | Completed | Failed | Paused | Exited
  nextTickAt    DateTime?
  enrolledAt    DateTime  @default(now())
  completedAt   DateTime?
  lastError     String?

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journey MarketingJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, contactType, contactId])
  @@index([tenantId, status, nextTickAt])
  @@map("journey_enrollments")
  @@schema("public")
}

// ---------- Marketing P2: WhatsappTemplate (WABA-approved template) ----------
//
// WhatsApp Business API mandates Meta-approval for every marketing template.
// This row mirrors what's registered in the WABA account and tracks its
// approval status. Body can carry {{1}}, {{2}}, ... positional merge vars.
model WhatsappTemplate {
  id             String   @id @default(cuid())
  tenantId       String
  name           String // matches Meta template name (a-z, digits, underscore)
  category       String // AUTHENTICATION | MARKETING | UTILITY
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED | PAUSED
  language       String   @default("en_US")
  headerType     String? // TEXT | IMAGE | VIDEO | DOCUMENT
  headerText     String?
  bodyText       String // supports {{1}}, {{2}}, ... positional vars
  footerText     String?
  variables      Json? // ordered list of merge-tag friendly names
  wabaTemplateId String? // Meta's returned template id after approval
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages WhatsappMessage[]

  @@unique([tenantId, name, language])
  @@index([tenantId, status])
  @@map("whatsapp_templates")
  @@schema("public")
}

// ---------- Marketing P2: WhatsappMessage (outbound + inbound log) ----------
//
// Both send and receive tracked in one table (direction = "outbound" | "inbound").
// Outbound: send via Meta Graph API /messages, provider returns wamid ->
// providerMessageId. Status transitions via inbound webhook status events:
// Sent -> Delivered -> Read.
model WhatsappMessage {
  id                String    @id @default(cuid())
  tenantId          String
  direction         String    @default("outbound") // outbound | inbound
  toMobile          String // E.164 (e.g. +919876543210)
  fromMobile        String? // for inbound
  templateId        String?
  body              String // rendered body (post-merge)
  mediaUrl          String? // for images/docs (Meta media_id or public URL)
  status            String    @default("Pending") // Pending|Sending|Sent|Failed|Cancelled|Delivered|Read
  attempts          Int       @default(0)
  lastError         String?
  senderUserId      String?
  linkedDoctype     String?
  linkedId          String?
  scheduledFor      DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  providerMessageId String? // Meta's wamid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template WhatsappTemplate? @relation(fields: [templateId], references: [id])

  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, direction, createdAt])
  @@map("whatsapp_messages")
  @@schema("public")
}

// ---------- Marketing P3: WebinarEvent + WebinarRegistration ----------
//
// Hosted/promoted webinars integrated with Zoom / Webex / Google Meet.
// Registrations flow through a WebForm (existing model) — the form's
// targetType extends to "WebinarRegistration". A JourneyEnrollment can also
// spawn from registration (triggerType=WebinarRegistered).
model WebinarEvent {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  description     String?
  status          String   @default("Draft") // Draft | Scheduled | Live | Ended | Cancelled
  provider        String // Zoom | Webex | GoogleMeet | Manual (in-person)
  externalId      String? // provider-side meeting id after create
  joinUrl         String? // shareable attendee URL
  hostUrl         String? // host launch URL (do NOT expose to attendees)
  startAt         DateTime
  endAt           DateTime
  timezone        String   @default("Asia/Kolkata")
  capacity        Int? // null = no cap
  registerFormId  String? // FK to WebForm used for registration
  actualAttendees Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrations WebinarRegistration[]

  @@unique([tenantId, name, startAt])
  @@index([tenantId, status, startAt])
  @@map("webinar_events")
  @@schema("public")
}

model WebinarRegistration {
  id           String    @id @default(cuid())
  tenantId     String
  webinarId    String
  email        String
  name         String?
  mobile       String?
  contactType  String? // Customer | Lead (if resolved)
  contactId    String?
  status       String    @default("Registered") // Registered | Reminded | Attended | NoShow | Cancelled
  registeredAt DateTime  @default(now())
  attendedAt   DateTime?
  notes        String?

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  webinar WebinarEvent @relation(fields: [webinarId], references: [id], onDelete: Cascade)

  @@unique([webinarId, email])
  @@index([tenantId, webinarId, status])
  @@map("webinar_registrations")
  @@schema("public")
}

// ---------- Meeting Scheduler (Bookings) ----------
//
// Public "book a slot" flow, Calendly / Zoho Bookings equivalent.
//
// Concepts:
//   * MeetingType — a bookable definition (title, duration, buffer,
//     public slug). Owner is a User; slug is unique per tenant so the
//     public URL is /public/booking/:slug.
//   * AvailabilityWindow — weekly recurring windows the owner is free.
//     dayOfWeek 0..6 (0 = Sunday, ISO-ish), startMinute/endMinute are
//     minutes-from-midnight in the window's stated timezone. If
//     meetingTypeId is null, the window applies to ALL of the owner's
//     meeting types (owner-level default).
//   * BookedMeeting — a confirmed booking. Public flow inserts with
//     status=Booked; owner or invitee (via cancellationToken) can flip
//     to Cancelled. startsAt/endsAt stored as UTC.
//
// Slot generation lives in packages/db/src/booking-slots.ts and is
// pure so it can be unit-tested without a DB.
model MeetingType {
  id               String   @id @default(cuid())
  tenantId         String
  ownerUserId      String
  slug             String // public URL segment, unique per tenant
  title            String
  description      String?
  durationMinutes  Int // e.g. 15, 30, 60
  bufferMinutes    Int      @default(0) // gap enforced before + after each booking
  minNoticeMinutes Int      @default(60) // earliest bookable slot from now
  maxAdvanceDays   Int      @default(30) // farthest bookable slot from now
  colorHex         String?
  locationType     String   @default("Video") // Video | Phone | InPerson | Custom
  locationDetails  String?
  redirectUrl      String? // where to send invitee after booking
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  availabilityWindows AvailabilityWindow[]
  bookings            BookedMeeting[]

  @@unique([tenantId, slug])
  @@index([tenantId, ownerUserId, active])
  @@map("meeting_types")
  @@schema("public")
}

model AvailabilityWindow {
  id            String   @id @default(cuid())
  tenantId      String
  ownerUserId   String
  meetingTypeId String? // null → applies to all owner types
  dayOfWeek     Int // 0 = Sunday .. 6 = Saturday
  startMinute   Int // 0..1440
  endMinute     Int // 0..1440, > startMinute
  timezone      String   @default("Asia/Kolkata")
  createdAt     DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meetingType MeetingType? @relation(fields: [meetingTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerUserId, dayOfWeek])
  @@map("availability_windows")
  @@schema("public")
}

model BookedMeeting {
  id                 String   @id @default(cuid())
  tenantId           String
  meetingTypeId      String
  ownerUserId        String
  startsAt           DateTime // UTC
  endsAt             DateTime // UTC
  inviteeName        String
  inviteeEmail       String
  inviteePhone       String?
  inviteeNotes       String?
  inviteeTimezone    String? // reported by browser at booking time
  status             String   @default("Booked") // Booked | Cancelled | Completed | NoShow
  cancellationReason String?
  cancellationToken  String   @unique @default(cuid()) // used in public cancel URL
  meetingUrl         String? // resolved from MeetingType.locationDetails at book time
  // Reminder tick stamps this after queueing the invitee reminder email.
  // Null → not yet reminded (or start time is > reminder-lead-hours out).
  // Non-null → already sent; prevents double-reminders on scheduler re-runs.
  reminderSentAt     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  meetingType MeetingType @relation(fields: [meetingTypeId], references: [id])

  @@index([tenantId, ownerUserId, startsAt])
  @@index([tenantId, meetingTypeId, startsAt])
  @@index([tenantId, status, startsAt])
  // Cheap index for the reminder tick: pending Booked meetings starting soon.
  @@index([status, reminderSentAt, startsAt])
  @@map("booked_meetings")
  @@schema("public")
}

// ---------- Marketing P3: MarketingApproval workflow ----------
//
// Draft → PendingApproval → Approved → Scheduled/Sending. Rejected returns to
// Draft with rejectionReason set. Applies to Campaign + SocialPost + Broadcast
// via a polymorphic (doctype, docId) pointer.
model MarketingApproval {
  id              String    @id @default(cuid())
  tenantId        String
  doctype         String // Campaign | SocialPost | Broadcast
  docId           String
  status          String    @default("Pending") // Pending | Approved | Rejected | Withdrawn
  requestedBy     String // userId
  requestedAt     DateTime  @default(now())
  approvedBy      String?
  approvedAt      DateTime?
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  notes           String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, doctype, docId])
  @@index([tenantId, status, requestedAt])
  @@map("marketing_approvals")
  @@schema("public")
}

// ---------- Marketing P3: BrandKit (per-tenant brand system) ----------
//
// Single row per tenant (unique on tenantId). Injected into email templates
// via merge vars {{brand.logoUrl}}, {{brand.primaryColor}}, etc. Fonts stored
// as CSS-family strings; assets store S3 keys through MediaAsset references.
model BrandKit {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  logoAssetId    String? // MediaAsset FK — primary logo
  faviconAssetId String?
  primaryColor   String   @default("#1e40af") // hex
  secondaryColor String   @default("#0ea5e9")
  accentColor    String   @default("#f59e0b")
  neutralColor   String   @default("#111827")
  headingFont    String   @default("Inter, sans-serif")
  bodyFont       String   @default("Inter, sans-serif")
  footerHtml     String? // company address / unsubscribe boilerplate
  socialLinks    Json? // { twitter, linkedin, facebook, instagram }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("brand_kits")
  @@schema("public")
}

// ---------- Marketing P3: AttributionTouchpoint (revenue attribution) ----------
//
// Every marketing interaction that could influence a sale writes a row here:
// campaign open/click, journey enrollment/completion, form submit, webinar
// register/attend. When a SalesInvoice is submitted for a Customer, the
// attribution engine looks at recent touchpoints and assigns revenue per
// model (last-touch, first-touch, linear). Powers the ROI dashboard.
model AttributionTouchpoint {
  id                  String   @id @default(cuid())
  tenantId            String
  contactType         String // Customer | Lead
  contactId           String
  sourceType          String // Campaign | Journey | WebForm | Webinar | SocialPost
  sourceId            String
  event               String // Open | Click | Enrolled | Completed | Submitted | Registered | Attended
  occurredAt          DateTime @default(now())
  attributedRevenue   Decimal  @default(0) @db.Decimal(18, 4) // filled retroactively when SI submits
  attributedInvoiceId String? // FK to SalesInvoice when attributed

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactType, contactId, occurredAt])
  @@index([tenantId, sourceType, sourceId])
  @@index([attributedInvoiceId])
  @@map("attribution_touchpoints")
  @@schema("public")
}

// ---------- Marketing P3: EditorialNote (content calendar) ----------
//
// Free-form note on the content calendar — a placeholder for planned content
// that doesn't yet have a Campaign/SocialPost/Broadcast row. Once turned into
