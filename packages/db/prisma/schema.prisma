// ------------------------------- POS ----------------------------------------
// Point-of-Sale: cashier terminal + session model. Mirrors ERPNext.
//   POSProfile        — terminal config: warehouse, price list, walk-in
//                       customer, accepted payment methods (with the account
//                       each method deposits into), letterhead, allowed users.
//   POSOpeningEntry   — session open: cashier picks a profile, declares an
//                       opening balance per method, and gets an active
//                       session id used to stamp POS invoices.
//   POSClosingEntry   — session close: cashier counts each method, system
//                       computes expected from posted invoices, difference
//                       goes to Cash Short/Over (booked as an expense/income
//                       adjustment in Round Off if no dedicated account).
//
// POS invoices are stored as SalesInvoice rows with isPos=true and
// posOpeningId set — so all downstream reporting (GST, GL, aging) works
// unchanged. The POS checkout endpoint (services/accounting-service/src/
// routes/pos-invoices.ts) creates the SI + PaymentEntry in one transaction
// and submits both. See docs/ARCHITECTURE.md for the voucher lifecycle.

model POSProfile {
  id                String   @id @default(cuid())
  tenantId          String
  name              String // stable slug per tenant, e.g. "store-main-01"
  title             String // display label shown on session-open dropdown
  warehouseId       String? // v1: informational; stock-integrated POS is v2
  priceListId       String? // when set, drives auto-fill of item rates
  defaultCustomerId String? // walk-in customer for anonymous checkout
  incomeAccountId   String? // per-terminal override, else tenant default
  letterheadId      String?
  // Accepted payment methods and the account each deposits into. Shape:
  //   [{ mode: "Cash"|"Card"|"UPI"|"Razorpay",
  //      accountId: string,       // cash-in-hand / card clearing / UPI clearing
  //      isDefault?: boolean,     // pre-selected in split-tender modal
  //      integrationId?: string   // TenantIntegration ref (Razorpay only)
  //   }]
  // Validated at write time by the pos-profiles route.
  paymentMethods    Json
  disabled          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse       Warehouse?        @relation("POSProfileWarehouse", fields: [warehouseId], references: [id])
  priceList       PriceList?        @relation("POSProfilePriceList", fields: [priceListId], references: [id])
  defaultCustomer Customer?         @relation("POSProfileDefaultCustomer", fields: [defaultCustomerId], references: [id])
  incomeAccount   Account?          @relation("POSProfileIncomeAccount", fields: [incomeAccountId], references: [id])
  letterhead      Letterhead?       @relation("POSProfileLetterhead", fields: [letterheadId], references: [id])
  openingEntries  POSOpeningEntry[]
  closingEntries  POSClosingEntry[]
  salesInvoices   SalesInvoice[]    @relation("SIPosProfile")

  @@unique([tenantId, name])
  @@index([tenantId, disabled])
  @@map("pos_profiles")
  @@schema("public")
}

model POSOpeningEntry {
  id              String    @id @default(cuid())
  tenantId        String
  name            String // e.g. POS-OPEN-0001
  posProfileId    String
  userId          String // the cashier who opened the session
  openTime        DateTime  @default(now())
  closeTime       DateTime?
  status          String    @default("Open") // Open | Closed
  // Opening float per payment method. Shape: [{mode, amount}]. Only
  // meaningful for Cash (the physical drawer float); other modes typically
  // seed 0 but we keep the shape uniform for the closing reconciliation.
  openingBalances Json
  notes           String?
  customData      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posProfile    POSProfile       @relation(fields: [posProfileId], references: [id])
  user          User             @relation("POSOpeningUser", fields: [userId], references: [id])
  closing       POSClosingEntry?
  salesInvoices SalesInvoice[]   @relation("SIPosOpening")

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, userId, status])
  @@map("pos_opening_entries")
  @@schema("public")
}

model POSClosingEntry {
  id               String   @id @default(cuid())
  tenantId         String
  name             String // e.g. POS-CLOSE-0001
  posProfileId     String
  openingEntryId   String   @unique // one closing per opening
  userId           String
  postingDate      DateTime @default(now())
  status           String   @default("Draft") // Draft | Submitted | Cancelled
  // Expected per method = opening float + sum(PE.paidAmount by method) over
  // the session. Counted = what the cashier physically counted. Difference =
  // counted − expected (positive = surplus, negative = shortage). Booked as
  // one JE on submit to Cash Short/Over (routes to defaultRoundOffAccountId
  // when no dedicated account configured; documented in the route).
  expectedByMode   Json // [{mode, opening, sales, expected}]
  countedByMode    Json // [{mode, counted}]
  differenceByMode Json // [{mode, difference}]
  totalSales       Decimal  @default(0) @db.Decimal(18, 4)
  invoiceCount     Int      @default(0)
  totalDifference  Decimal  @default(0) @db.Decimal(18, 4) // sum of |difference|
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  posProfile   POSProfile      @relation(fields: [posProfileId], references: [id])
  openingEntry POSOpeningEntry @relation(fields: [openingEntryId], references: [id])
  user         User            @relation("POSClosingUser", fields: [userId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, postingDate])
  @@map("pos_closing_entries")
  @@schema("public")
}

// ---------------------------- Website / CMS ---------------------------------
// Public content: WebPage (static pages — /about, /pricing, /contact) and
// BlogPost (chronological articles at /blog/:slug).
//
// Both mirror LandingPage's shape (HTML body, publish gate) but are meant
// for evergreen marketing content rather than campaign-driven landing pages.
// LandingPage remains for high-conversion pages with view-count tracking;
// WebPage/BlogPost stay lean — no analytics, no linked WebForm.
//
// Public URLs are served by portal-web (basePath=/portal):
//   GET /portal/site/:slug         → WebPage
//   GET /portal/blog                → BlogPost list (all published)
//   GET /portal/blog/:slug          → BlogPost
// Backend read endpoints live at /public/web-pages/:slug + /public/blog-posts
// on crm-service and require no auth (published gate enforced server-side).
//
// Slug uniqueness: publicSlug is @unique globally (not per-tenant), matching
// LandingPage/WebForm — a multi-tenant SaaS would resolve this via subdomain
// routing in production, out of scope here.

model WebPage {
  id          String    @id @default(cuid())
  tenantId    String
  name        String // internal admin label ("About Us page v2")
  publicSlug  String    @unique // URL segment (about, pricing, contact)
  title       String // <title> + og:title
  description String? // meta description + og:description
  bodyHtml    String // rendered body (raw HTML — editor is a textarea)
  headHtml    String? // extra <head> chunk (custom CSS, tracking pixels)
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isPublished])
  @@map("web_pages")
  @@schema("public")
}

model BlogPost {
  id            String    @id @default(cuid())
  tenantId      String
  name          String // internal admin label
  publicSlug    String    @unique
  title         String
  excerpt       String? // shown on the /blog index card + og:description
  bodyHtml      String
  authorName    String? // free-text — Author doctype is future work
  category      String? // free-text; no BlogCategory doctype (add later)
  featuredImage String? // URL to a hosted image (S3 / CDN)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId, isPublished, publishedAt])
  @@index([tenantId, category])
  @@map("blog_posts")
  @@schema("public")
}

// ---------------------------- E-commerce ------------------------------------
// WebsiteItem is a 1:1 extension of Item with web-facing fields. Kept as a
// separate table so admin/staff Item CRUD stays lean (Items without a
// WebsiteItem row simply aren't shoppable). Mirrors ERPNext's "Website Item"
// approach.
//
// Cart lives entirely in the browser's localStorage on portal-web — it's a
// list of { itemId, qty } — so there's no Cart / CartItem model server-side.
// Checkout POSTs the full cart to /public/checkout, which creates a Customer
// (if the email is new) plus a Sales Order in Draft status. Staff process
// the SO from crm-web as they would any other order.
//
// publicSlug = ItemCode alias for URLs (e.g. /shop/SKU-001). Global @unique
// matches the LandingPage/WebForm/WebPage/BlogPost pattern; multi-tenant
// slug conflicts resolved via subdomain in production, out of scope here.

model WebsiteItem {
  id               String    @id @default(cuid())
  tenantId         String
  itemId           String    @unique // 1:1 with Item; delete cascades
  publicSlug       String    @unique // typically item.itemCode, editable
  webItemName      String // override of item.itemName for the storefront
  shortDescription String? // 1-2 line teaser shown on grid cards
  descriptionHtml  String? // long-form description on the detail page
  imageUrl         String? // primary hosted image URL
  galleryUrls      String[]  @default([]) // additional images (Postgres string[])
  webPrice         Decimal?  @db.Decimal(18, 4) // overrides item.standardRate; null → use standardRate
  isPublished      Boolean   @default(false)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   Item   @relation("WebsiteItemItem", fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId, isPublished])
  @@map("website_items")
  @@schema("public")
}

// ---------------------------- Product Bundles -------------------------------
// One row per (bundle-parent, component) pair. E.g. a "Gift Basket" bundle
// with 3 chocolates + 1 card = 4 BundleComponent rows.
//
// When a Sales Order line references the parent (Item.isProductBundle=true),
// convert-to-Delivery-Note explodes the bundle line into one DN line per
// component (qty = SO qty × component qty), each carrying salesOrderItemId
// back to the original bundle line for audit + partial-fulfilment tallying.
//
// The parent Item itself typically has isStockItem=false so it never
// participates in the stock ledger — only its components do.

model BundleComponent {
  id              String   @id @default(cuid())
  tenantId        String
  // The bundle Item (must have isProductBundle=true — enforced at write time).
  parentItemId    String
  // The component Item shipped when the bundle is fulfilled.
  componentItemId String
  // How many units of the component ship per one unit of the bundle.
  qty             Decimal  @db.Decimal(18, 4)
  // Display order in the bundle-components editor + on printed pack lists.
  // Optional — nulls sort last.
  sortOrder       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentItem    Item   @relation("BundleParent", fields: [parentItemId], references: [id], onDelete: Cascade)
  componentItem Item   @relation("BundleComponentItem", fields: [componentItemId], references: [id])

  // Same (parent, component) can't appear twice — bump qty instead.
  @@unique([tenantId, parentItemId, componentItemId])
  @@index([tenantId, parentItemId])
  @@map("bundle_components")
  @@schema("public")
}

// ═════════════════════════════════════════════════════════════════════
// E-SIGNATURE WORKFLOW
// Envelope → SignatureRequest (per signer, in order) → audit trail.
// Provider-agnostic: adapters live in packages/db/src/esign-providers.ts
// and dispatch off TenantIntegration.provider ("DocuSign" | "ZohoSign" |
// "Stub"). The envelope carries the source doctype (SalesOrder / PO /
// Quotation / etc.) so downstream automation can react on "all signers
// completed".
// ═════════════════════════════════════════════════════════════════════

model SignatureEnvelope {
  id             String   @id @default(cuid())
  tenantId       String
  name           String   // ENV-0001
  subject        String
  message        String?
  sourceDoctype  String?  // "SalesOrder" | "Quotation" | "PurchaseOrder" | ...
  sourceId       String?  // FK into the source table — soft ref
  documentUrl    String?  // S3 URL of the rendered PDF to sign
  status         String   @default("Draft") // Draft | Sent | Completed | Declined | Voided | Expired
  provider       String   @default("Stub") // DocuSign | ZohoSign | Stub
  externalId     String?  // provider-side envelope id
  sequential     Boolean  @default(true) // true = signers sign in order; false = parallel
  expiresAt      DateTime?
  createdBy      String
  sentAt         DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  signers  SignatureRequest[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, sourceDoctype, sourceId])
  @@map("signature_envelopes")
  @@schema("public")
}

model SignatureRequest {
  id            String   @id @default(cuid())
  envelopeId    String
  tenantId      String
  order         Int      @default(0) // 1-based for sequential; ignored when parallel
  signerName    String
  signerEmail   String
  role          String?  // e.g. "Buyer", "Seller", "Witness"
  status        String   @default("Pending") // Pending | Sent | Signed | Declined
  signedAt      DateTime?
  signedIp      String?
  declineReason String?
  accessToken   String   @unique @default(cuid()) // used in the public sign URL
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  envelope SignatureEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([envelopeId, order])
  @@index([tenantId, signerEmail, status])
  @@map("signature_requests")
  @@schema("public")
}

// ═════════════════════════════════════════════════════════════════════
// SHIPPING CARRIER INTEGRATION
// Adapter interface for FedEx / DHL / USPS / EasyPost. On DN submit,
// route calls the carrier to get rate quotes and (on user selection)
// buy a label. Shipment tracks the label + tracking number + updates.
// ═════════════════════════════════════════════════════════════════════

model Shipment {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String   // SHIP-0001
  deliveryNoteId     String?  // outbound (customer)
  purchaseReceiptId  String?  // inbound (supplier)
  carrier            String   // "FedEx" | "DHL" | "USPS" | "UPS" | "Bluedart" | ...
  service            String?  // "Ground" | "Express" | "Priority"
  trackingNumber     String?
  labelUrl           String?  // S3 URL of the printed label PDF
  costAmount         Decimal  @default(0) @db.Decimal(18, 4)
  costCurrency       String   @default("INR")
  weightGrams        Int?
  dimensionsCm       String?  // "30x20x10"
  fromAddress        Json     // { name, street1, street2, city, state, zip, country, phone }
  toAddress          Json
  status             String   @default("Draft") // Draft | LabelPurchased | InTransit | Delivered | Failed | Voided
  externalId         String?  // provider shipment id
  providerRateId     String?  // the rate the label was purchased against
  provider           String   @default("EasyPost") // EasyPost | Direct
  purchasedAt        DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events           ShipmentEvent[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, deliveryNoteId])
  @@index([tenantId, purchaseReceiptId])
  @@index([tenantId, trackingNumber])
  @@map("shipments")
  @@schema("public")
}

// Tracking events pulled from the carrier (delivered, in transit, etc).
model ShipmentEvent {
  id         String   @id @default(cuid())
  tenantId   String
  shipmentId String
  ts         DateTime
  status     String   // pre_transit | in_transit | out_for_delivery | delivered | return_to_sender | failure | unknown
  location   String?
  description String?
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ts])
  @@index([shipmentId, ts])
  @@map("shipment_events")
  @@schema("public")
}

// ═════════════════════════════════════════════════════════════════════
// EDUCATION VERTICAL (ERPNext Education parity)
// Program → Course → Student + Enrollment; Fee schedule → Fee posting
// hooks into the existing SalesInvoice / PaymentEntry machinery.
// ═════════════════════════════════════════════════════════════════════

model Program {
  id           String   @id @default(cuid())
  tenantId     String
  name         String   // "B.Tech CSE 2026"
  code         String   // "BTECH-CSE-26"
  academicYear String?  // "2026-27"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courses     Course[]
  enrollments StudentEnrollment[]
  feeSchedules FeeSchedule[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("programs")
  @@schema("public")
}

model Course {
  id         String   @id @default(cuid())
  tenantId   String
  programId  String
  code       String   // "CS101"
  name       String   // "Intro to CS"
  credits    Decimal  @default(3) @db.Decimal(4, 1)
  instructorEmployeeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program    Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  instructor Employee? @relation("CourseInstructor", fields: [instructorEmployeeId], references: [id])
  assessments Assessment[]

  @@unique([tenantId, programId, code])
  @@map("courses")
  @@schema("public")
}

model Student {
  id            String   @id @default(cuid())
  tenantId      String
  studentCode   String   // "STU-0001"
  fullName      String
  email         String?
  mobile        String?
  dateOfBirth   DateTime? @db.Date
  gender        String?
  address       String?
  guardianName  String?
  guardianPhone String?
  status        String   @default("Active") // Active | Alumni | Withdrawn | Suspended
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments StudentEnrollment[]
  feePostings FeePosting[]
  assessmentResults AssessmentResult[]

  @@unique([tenantId, studentCode])
  @@index([tenantId, status])
  @@map("students")
  @@schema("public")
}

model StudentEnrollment {
  id           String   @id @default(cuid())
  tenantId     String
  studentId    String
  programId    String
  academicYear String
  section      String?  // "A", "B", ...
  status       String   @default("Active") // Active | Completed | Withdrawn
  enrolledAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id])

  @@unique([studentId, programId, academicYear])
  @@index([tenantId, programId, status])
  @@map("student_enrollments")
  @@schema("public")
}

// Fee schedule: how much + when for a given program/academic-year.
model FeeSchedule {
  id           String   @id @default(cuid())
  tenantId     String
  name         String   // "Tuition 2026-27"
  programId    String?
  academicYear String
  amount       Decimal  @db.Decimal(18, 4)
  dueDayOfMonth Int?    // 1..31; when set, generates one posting per month
  installments  Int     @default(1) // e.g. 4 for quarterly
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id])
  postings FeePosting[]

  @@index([tenantId, active])
  @@map("fee_schedules")
  @@schema("public")
}

// One row per (student, fee-instalment) — links to a SalesInvoice for
// GL + reminders + payment tracking.
model FeePosting {
  id             String   @id @default(cuid())
  tenantId       String
  studentId      String
  feeScheduleId  String
  academicYear   String
  installmentNo  Int      @default(1)
  amount         Decimal  @db.Decimal(18, 4)
  dueDate        DateTime @db.Date
  salesInvoiceId String?  // populated after the SI is auto-generated
  status         String   @default("Due") // Due | Invoiced | Paid | Waived
  createdAt      DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeSchedule FeeSchedule  @relation(fields: [feeScheduleId], references: [id])

  @@index([tenantId, studentId, status])
  @@index([tenantId, dueDate])
  @@map("fee_postings")
  @@schema("public")
}

model Assessment {
  id        String   @id @default(cuid())
  tenantId  String
  courseId  String
  name      String   // "Midterm 1"
  maxScore  Decimal  @db.Decimal(6, 2)
  weightPct Decimal  @default(0) @db.Decimal(5, 2) // weight in final grade
  dueDate   DateTime? @db.Date
  createdAt DateTime @default(now())

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  course  Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  results AssessmentResult[]

  @@index([tenantId, courseId])
  @@map("assessments")
  @@schema("public")
}

model AssessmentResult {
  id           String   @id @default(cuid())
  tenantId     String
  assessmentId String
  studentId    String
  score        Decimal  @db.Decimal(6, 2)
  gradedAt     DateTime @default(now())
  gradedBy     String?  // userId
  comments     String?

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([tenantId, studentId])
  @@map("assessment_results")
  @@schema("public")
}

// ═════════════════════════════════════════════════════════════════════
// HEALTHCARE VERTICAL (ERPNext Healthcare parity)
// Patient → Encounter → Prescription/Observation + Appointment scheduler.
// ═════════════════════════════════════════════════════════════════════

model Patient {
  id             String   @id @default(cuid())
  tenantId       String
  mrn            String   // Medical Record Number: PAT-0001
  fullName       String
  dateOfBirth    DateTime? @db.Date
  gender         String?
  bloodGroup     String?
  email          String?
  mobile         String?
  address        String?
  emergencyName  String?
  emergencyPhone String?
  allergies      String?  // free-text; a dedicated allergen table is a future step
  notes          String?
  status         String   @default("Active") // Active | Discharged | Deceased
  customerId     String?  // link to billing entity (Customer) — nullable for cash patients
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer?             @relation("PatientCustomer", fields: [customerId], references: [id])
  appointments PatientAppointment[]
  encounters   PatientEncounter[]

  @@unique([tenantId, mrn])
  @@index([tenantId, status])
  @@map("patients")
  @@schema("public")
}

model PatientAppointment {
  id                 String   @id @default(cuid())
  tenantId           String
  patientId          String
  practitionerEmployeeId String
  startAt            DateTime
  endAt              DateTime
  reason             String?  // "Fever", "Follow-up: BP", ...
  status             String   @default("Scheduled") // Scheduled | CheckedIn | InProgress | Completed | Cancelled | NoShow
  encounterId        String?  // populated when the appointment produces an encounter
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Employee           @relation("AppointmentPractitioner", fields: [practitionerEmployeeId], references: [id])
  encounter    PatientEncounter?  @relation(fields: [encounterId], references: [id])

  @@index([tenantId, patientId, startAt])
  @@index([tenantId, practitionerEmployeeId, startAt])
  @@index([tenantId, status, startAt])
  @@map("patient_appointments")
  @@schema("public")
}

model PatientEncounter {
  id                     String   @id @default(cuid())
  tenantId               String
  patientId              String
  practitionerEmployeeId String
  encounterAt            DateTime @default(now())
  chiefComplaint         String?
  historyOfIllness       String?
  examinationFindings    String?
  diagnosis              String?  // ICD-10 codes comma-separated; a dedicated table is future work
  treatmentPlan          String?
  followUpAt             DateTime?
  status                 String   @default("Open") // Open | Completed
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant       Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient      Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner Employee                @relation("EncounterPractitioner", fields: [practitionerEmployeeId], references: [id])
  appointments PatientAppointment[]
  prescriptions Prescription[]

  @@index([tenantId, patientId, encounterAt])
  @@map("patient_encounters")
  @@schema("public")
}

model Prescription {
  id           String   @id @default(cuid())
  tenantId     String
  encounterId  String
  medication   String   // "Amoxicillin 500mg"
  dosage       String   // "1 tablet"
  frequency    String   // "Twice daily"
  durationDays Int?
  instructions String?
  createdAt    DateTime @default(now())

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  encounter PatientEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([encounterId])
  @@map("prescriptions")
  @@schema("public")
}

// ═════════════════════════════════════════════════════════════════════
// NON-PROFIT VERTICAL (ERPNext Non-Profit parity)
// Donor → Donation + Grant + Membership.
// ═════════════════════════════════════════════════════════════════════

model Donor {
  id          String   @id @default(cuid())
  tenantId    String
  donorCode   String   // DON-0001
  donorName   String
  donorType   String   @default("Individual") // Individual | Corporation | Foundation
  email       String?
  mobile      String?
  address     String?
  taxId       String?  // PAN / EIN — for tax-deduction receipts
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donations   Donation[]
  memberships Membership[]

  @@unique([tenantId, donorCode])
  @@map("donors")
  @@schema("public")
}

model Donation {
  id            String   @id @default(cuid())
  tenantId      String
  donorId       String
  amount        Decimal  @db.Decimal(18, 4)
  currency      String   @default("INR")
  postingDate   DateTime @default(now()) @db.Date
  campaignName  String?  // free-text for now; can link to Campaign later
  paymentMethod String   @default("Bank") // Bank | Cash | Cheque | Online
  reference     String?  // txn ref / cheque #
  receiptIssued Boolean  @default(false)
  receiptNumber String?  // for 80G / tax-deduction receipts
  paymentEntryId String? // link to a PE when booked via Payment Entry
  notes         String?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donor  Donor  @relation(fields: [donorId], references: [id])

  @@index([tenantId, donorId, postingDate])
  @@map("donations")
  @@schema("public")
}

model Grant {
  id          String   @id @default(cuid())
  tenantId    String
  grantorName String
  grantCode   String
  purpose     String
  totalAmount Decimal  @db.Decimal(18, 4)
  currency    String   @default("INR")
  awardedOn   DateTime @db.Date
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  status      String   @default("Active") // Active | Closed | Cancelled
  reportingCadence String? // "Monthly" | "Quarterly" | "Annually"
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, grantCode])
  @@index([tenantId, status])
  @@map("grants")
  @@schema("public")
}

model Membership {
  id           String   @id @default(cuid())
  tenantId     String
  donorId      String
  tier         String   // "Basic" | "Silver" | "Gold" | ...
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  amount       Decimal  @db.Decimal(18, 4)
  currency     String   @default("INR")
  paymentEntryId String?
  status       String   @default("Active") // Active | Expired | Cancelled
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  donor  Donor  @relation(fields: [donorId], references: [id])

  @@index([tenantId, donorId, status])
  @@index([tenantId, endDate])
  @@map("memberships")
  @@schema("public")
}

// ═════════════════════════════════════════════════════════════════════
// HOSPITALITY VERTICAL (ERPNext Hotels / Zoho Bookings for stays)
// Room → RoomBooking; check-in/check-out flow ties into SalesInvoice.
// ═════════════════════════════════════════════════════════════════════

model Room {
  id           String   @id @default(cuid())
  tenantId     String
  roomNumber   String   // "101", "Suite-B"
  roomType     String   // "Deluxe" | "Suite" | "Standard"
  capacity     Int      @default(2)
  ratePerNight Decimal  @db.Decimal(18, 4)
  currency     String   @default("INR")
  floor        String?
  amenities    String[] @default([]) // ["wifi", "ac", "breakfast"]
  status       String   @default("Available") // Available | Occupied | Cleaning | Maintenance | OutOfService
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings RoomBooking[]

  @@unique([tenantId, roomNumber])
  @@index([tenantId, status])
  @@map("rooms")
  @@schema("public")
}

model RoomBooking {
  id             String   @id @default(cuid())
  tenantId       String
  bookingCode    String   // BKG-0001
  roomId         String
  guestName      String
  guestEmail     String?
  guestPhone     String?
  guestCount     Int      @default(1)
  checkInDate    DateTime @db.Date
  checkOutDate   DateTime @db.Date
  actualCheckIn  DateTime?
  actualCheckOut DateTime?
  ratePerNight   Decimal  @db.Decimal(18, 4)
  totalAmount    Decimal  @db.Decimal(18, 4)
  currency       String   @default("INR")
  status         String   @default("Booked") // Booked | CheckedIn | CheckedOut | Cancelled | NoShow
  customerId     String?  // link to Customer for billing
  salesInvoiceId String?  // generated on check-out
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room     Room       @relation(fields: [roomId], references: [id])
  customer Customer?  @relation("RoomBookingCustomer", fields: [customerId], references: [id])

  @@unique([tenantId, bookingCode])
  @@index([tenantId, roomId, checkInDate])
  @@index([tenantId, status, checkInDate])
  @@map("room_bookings")
  @@schema("public")
}

// ═════════════════════════════════════════════════════════════════════
// AGRICULTURE VERTICAL (ERPNext Agriculture parity)
// LandUnit → CropCycle → Sowing / Harvest / SoilAnalysis events.
// ═════════════════════════════════════════════════════════════════════

model LandUnit {
  id            String   @id @default(cuid())
  tenantId      String
  name          String   // "Plot A-3"
  areaAcres     Decimal  @db.Decimal(10, 4)
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  soilType      String?
  irrigation    String?  // "Drip" | "Flood" | "Rain-fed"
  status        String   @default("Active") // Active | Fallow | Leased
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cropCycles CropCycle[]

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("land_units")
  @@schema("public")
}

model CropCycle {
  id                String   @id @default(cuid())
  tenantId          String
  landUnitId        String
  cropName          String   // "Wheat", "Cotton", "Tomato"
  variety           String?
  sowingDate        DateTime @db.Date
  expectedHarvestDate DateTime? @db.Date
  actualHarvestDate DateTime? @db.Date
  seedQty           Decimal? @db.Decimal(10, 2)
  seedUom           String?
  expectedYield     Decimal? @db.Decimal(12, 2)
  actualYield       Decimal? @db.Decimal(12, 2)
  yieldUom          String   @default("kg")
  status            String   @default("Sown") // Sown | Growing | Harvested | Failed
  totalCost         Decimal  @default(0) @db.Decimal(18, 4)
  totalRevenue      Decimal  @default(0) @db.Decimal(18, 4)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  landUnit LandUnit @relation(fields: [landUnitId], references: [id])
  activities CropActivity[]

  @@index([tenantId, landUnitId, status])
  @@index([tenantId, status])
  @@map("crop_cycles")
  @@schema("public")
}

// Per-activity log: sowing, fertilizer, pesticide, irrigation, harvest.
model CropActivity {
  id           String   @id @default(cuid())
  tenantId     String
  cropCycleId  String
  activityType String   // "Sowing" | "Fertilizer" | "Pesticide" | "Irrigation" | "Harvest" | "Inspection"
  performedAt  DateTime @default(now())
  quantity     Decimal? @db.Decimal(10, 2)
  uom          String?
  cost         Decimal  @default(0) @db.Decimal(18, 4)
  notes        String?
  createdAt    DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cropCycle CropCycle @relation(fields: [cropCycleId], references: [id], onDelete: Cascade)

  @@index([tenantId, cropCycleId, performedAt])
  @@map("crop_activities")
  @@schema("public")
}

// ═════════════════════════════════════════════════════════════════════
// AGENT RUNTIME — plan, act, remember, escalate.
//
// AgentTask   = one durable multi-step goal ("close the books for Sep")
// AgentStep   = one atomic decision or tool-call within the task
// AgentPolicy = per-tenant guardrails (max steps, cost cap, allowed
//               doctypes, human-in-the-loop mode)
//
// The planner emits a JSON plan → the executor loops through steps,
// each dispatching to an MCP tool call → tools are the existing REST
// routes exposed through the Universal MCP layer. Human interrupts
// route through the existing Workflow engine.
// ═════════════════════════════════════════════════════════════════════

model AgentPolicy {
  id                 String   @id @default(cuid())
  tenantId           String
  key                String   // "default" | "financial-agents" | "customer-facing" | ...
  maxStepsPerTask    Int      @default(50)
  maxCostUsdPerTask  Decimal  @default(1) @db.Decimal(8, 4)
  allowedDoctypes    String[] @default([]) // empty = no write scope; agent must draft-only
  humanApprovalMode  String   @default("Draft") // Autonomous | Draft | ConfirmEach
  toolAllowlist      String[] @default([]) // MCP tool names; empty = all readable, none writable
  toolDenylist       String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks  AgentTask[]

  @@unique([tenantId, key])
  @@map("agent_policies")
  @@schema("public")
}

model AgentTask {
  id             String   @id @default(cuid())
  tenantId       String
  name           String   // AGT-0001
  agentKind      String   // "TicketTriage" | "MonthClose" | "ARChaser" | "PurchaseSuggester" | ...
  goal           String   // free-text describing what the agent should achieve
  contextJson    Json     @default("{}") // input params + accumulated retrieval
  planJson       Json?    // planner's JSON plan (array of intended steps)
  status         String   @default("Queued") // Queued | Planning | Running | AwaitingHuman | Completed | Failed | Cancelled
  policyId       String?
  startedByUserId String?  // "system" for cron-triggered
  startedAt      DateTime?
  completedAt   DateTime?
  totalCostUsd  Decimal  @default(0) @db.Decimal(10, 6)
  errorMessage  String?
  // If human approval was required, this points at the step that
  // asked for it — the UI renders that step's proposed action for
  // approve/reject.
  escalatedStepId  String?  @unique
  escalatedToUserId String?
  resumeToken   String?  @unique @default(cuid()) // used by approver's link
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  policy AgentPolicy? @relation(fields: [policyId], references: [id])
  steps  AgentStep[]  @relation("TaskSteps")
  escalatedStep AgentStep? @relation("EscalatedStep", fields: [escalatedStepId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@index([tenantId, agentKind, status])
  @@map("agent_tasks")
  @@schema("public")
}

model AgentStep {
  id           String   @id @default(cuid())
  tenantId     String
  taskId       String
  ordinal      Int      // 1-based, monotonic within a task
  kind         String   // "Think" | "ToolCall" | "HumanApproval" | "Emit"
  toolName     String?  // MCP tool name for ToolCall
  inputJson    Json?
  outputJson   Json?
  provider     String?  // "anthropic" | "openai" | "ollama" | ...
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(10, 6)
  latencyMs    Int      @default(0)
  status       String   @default("Pending") // Pending | Running | Succeeded | Failed | AwaitingHuman | Skipped
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  // Agent action timeline + undo. Set when a user clicks "Undo" on this
  // step and the inverse operation succeeds. Steps with undoneAt set
  // appear in the Undone section of the timeline where they can be Redone.
  // redoneAt is set when the user clicks Redo, which replays the original
  // tool and (because the new entity has a new id) stores the redo-result
  // in redoneOutputJson so it can be undone again.
  undoneAt           DateTime?
  undoneByUserEmail  String?
  redoneAt           DateTime?
  redoneByUserEmail  String?
  redoneOutputJson   Json?

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   AgentTask @relation("TaskSteps", fields: [taskId], references: [id], onDelete: Cascade)
  escalatedFromTask AgentTask? @relation("EscalatedStep")

  @@unique([taskId, ordinal])
  @@index([tenantId, status])
  @@index([tenantId, undoneAt, finishedAt])
  @@map("agent_steps")
  @@schema("public")
}

// ═════════════════════════════════════════════════════════════════════
// SEMANTIC LAYER — Embedding row per (doctype, docId). Vector is JSON
// float array (portable) — migrate to pgvector for prod indexing.
// ═════════════════════════════════════════════════════════════════════

model Embedding {
  id           String    @id @default(cuid())
  tenantId     String
  doctype      String
  docId        String
  title        String
  content      String
  contentHash  String
  vector       Json      @default("[]")
  vectorLength Int       @default(0)
  provider     String?
  model        String?
  stale        Boolean   @default(true)
  embeddedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, doctype, docId])
  @@index([tenantId, doctype, stale])
  @@index([tenantId, stale, updatedAt])
  @@map("embeddings")
  @@schema("public")
}

// Idempotency keys for mutating endpoints (payment/invoice creates). Client
// supplies `Idempotency-Key` header; middleware persists the response and
// replays it on retry. `fingerprint` is SHA-256(body) — reusing a key with a
// different body returns 422 (client bug: key must be tied to a single request
// intent). Entries expire after 24h; a scheduled sweep prunes expired rows.
model IdempotencyKey {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String?
  endpoint       String
  key            String
  fingerprint    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
  @@schema("public")
}

// ─── Subscription-based module gating ──────────────────────────────────────
//
// Lumaara's 5 top-level modules are hardcoded in packages/shared-types/
// src/modules.ts (so UI + API share the same list). This table stores
// which modules + submodules each SubscriptionPlan unlocks.
//
// A SubscriptionPlan is tenant-scoped so operators can offer custom plans
// per customer. The default plan ("All Access") is cloned per tenant on
// signup and auto-assigned (see signup + migration). SuperAdmin users can
// edit any plan or assign a different plan via the superadmin UI.
//
// `allowedModules` holds module keys like "hrms", "payroll", "finance",
// "sales", "manufacturing". `allowedSubmodules` holds dotted keys like
// "hrms.employees", "payroll.salary-slips". A route is permitted iff the
// tenant's active plan includes both the module key AND (if the route is
// gated at submodule level) the specific submodule key.

model SubscriptionPlan {
  id                 String   @id @default(cuid())
  tenantId           String
  name               String
  tier               String // "starter" | "pro" | "enterprise" | "custom"
  priceMonthlyInr    Decimal  @db.Decimal(12, 2) @default(0)
  allowedModules     String[]
  allowedSubmodules  String[]
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions TenantSubscription[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("subscription_plans")
  @@schema("platform")
}

model TenantSubscription {
  id         String    @id @default(cuid())
  tenantId   String
  planId     String
  startDate  DateTime  @default(now())
  endDate    DateTime? // null = indefinite
  isActive   Boolean   @default(true)
  // Razorpay (or other gateway) linkage. Nullable because super-admin
  // can still create free / manually-provisioned subscriptions.
  gatewayProvider      String?   // "razorpay"
  gatewayCustomerId    String?
  gatewaySubscriptionId String?
  // Current billing cycle window — advanced by the renewal job when a
  // period's payment is captured. nextBillingAt drives the renewal
  // scheduler + the "renews on X" badge in the UI.
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  nextBillingAt        DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([tenantId, isActive])
  @@index([nextBillingAt])
  @@map("tenant_subscriptions")
  @@schema("platform")
}

// Platform-level AI providers — super-admin configurable fallback for
// tenants that don't have their own TenantIntegration row. Supports
// Anthropic (Claude), OpenAI, Brew (OpenAI-compatible), Azure OpenAI,
// and Ollama. The `provider` field is a lowercase slug; `secrets.apiKey`
// is encrypted via secrets-crypto on write.
//
// Resolution order used by resolveLLMForChat():
//   1. Tenant's own TenantIntegration (provider matches)
//   2. PlatformAiProvider with isDefault=true + isActive=true
//   3. Any PlatformAiProvider with isActive=true (first by priority)
//   4. process.env fallback (dev-only; prod requires a configured row)
model PlatformAiProvider {
  id            String   @id @default(cuid())
  provider      String   // "anthropic" | "openai" | "brew" | "azure-openai" | "ollama"
  label         String   // human-readable name, e.g. "Platform Claude Haiku"
  isActive      Boolean  @default(true)
  isDefault     Boolean  @default(false)
  priority      Int      @default(100) // lower = tried first
  defaultModel  String?  // optional per-provider override
  baseUrl       String?  // required for azure-openai + brew + ollama
  config        Json     @default("{}")
  secrets       Json     @default("{}") // encrypted; see secrets-crypto
  lastTestedAt  DateTime?
  lastTestResult String? // "ok" | error message
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([provider, isActive])
  @@index([isDefault, isActive])
  @@map("platform_ai_providers")
  @@schema("platform")
}

// Platform-level payment-gateway credentials. Right now only Razorpay —
// extend with a `provider` discriminator when adding Stripe / PayPal.
// Super admin configures these once per installation; every tenant
// transacts through the same gateway account using tenant-scoped order
// IDs so refunds + chargebacks stay attributable.
model PlatformBillingGateway {
  id            String   @id @default(cuid())
  provider      String   // "razorpay" (future: "stripe", "paypal")
  mode          String   // "test" | "live"
  isActive      Boolean  @default(true)
  config        Json     @default("{}") // keyId (non-secret)
  secrets       Json     @default("{}") // keySecret + webhookSecret (encrypted)
  lastTestedAt  DateTime?
  lastTestResult String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider, mode])
  @@map("platform_billing_gateways")
  @@schema("platform")
}

// One row per upstream gateway event (payment captured, order paid,
// subscription cancelled, etc). Ingested by the webhook handler + used
// as an audit trail and idempotency key — if Razorpay re-delivers an
// event we've already processed, we recognize it by its upstream id and
// no-op instead of double-crediting the tenant.
model BillingEvent {
  id            String   @id @default(cuid())
  tenantId      String?  // null until the handler links the event to a tenant
  provider      String   // "razorpay"
  eventType     String   // e.g. "payment.captured", "order.paid", "subscription.cancelled"
  upstreamId    String   // Razorpay's event id — used for idempotency
  payload       Json     // full webhook body, redacted of secrets
  processedAt   DateTime?
  processError  String?
  createdAt     DateTime @default(now())

  @@unique([provider, upstreamId])
  @@index([tenantId, eventType])
  @@index([createdAt])
  @@map("billing_events")
  @@schema("platform")
}

// Per-tenant subscription + payment history record. Keeps a row per
// successful charge so the tenant can see an invoice list and the
// finance team can reconcile Razorpay settlements.
model BillingInvoice {
  id              String    @id @default(cuid())
  tenantId        String
  planId          String?
  subscriptionId  String?   // FK to TenantSubscription when known
  provider        String    // "razorpay"
  upstreamOrderId String?   // Razorpay order_id
  upstreamPaymentId String? // Razorpay payment_id
  amountInr       Decimal   @db.Decimal(14, 2)
  currency        String    @default("INR")
  status          String    // "created" | "attempted" | "paid" | "refunded" | "failed"
  periodStart     DateTime?
  periodEnd       DateTime?
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId, status, createdAt])
  @@index([upstreamOrderId])
  @@map("billing_invoices")
  @@schema("platform")
}

// ─────────────────────────────────────────────────────────────────────
// Per-user UI state: saved filter views, remembered form defaults,
// and "save-as-rule" snippets that an AI output can be reused from.
// These replace the localStorage MVPs so state survives device switch,
// can be shared/team-defaulted, and tenant admins can audit what
// filters/rules exist.
// ─────────────────────────────────────────────────────────────────────

model UserListView {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  // A stable key per list page, e.g. "stock-web:pick-lists" or
  // "accounting-web:sales-invoices". Clients compute this once and pass
  // it in on save/load — no server-side registry.
  listKey   String
  name      String
  filters   Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, userId, listKey])
  @@map("user_list_views")
  @@schema("public")
}

model UserFormDefault {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  // Stable key per form, e.g. "stock-web:pick-list-create".
  formKey   String
  // The last-remembered value shape, caller-defined.
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, formKey])
  @@map("user_form_defaults")
  @@schema("public")
}

model AiRule {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  // Scope lets different flows namespace their rules without colliding,
  // e.g. "invoice-draft" / "lead-triage".
  scope      String
  name       String
  // Captured input + edited AI output — rendered back as a template when
  // the same scope asks again. Shape is caller-defined JSON.
  before     Json
  after      Json
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, userId, scope])
  @@map("ai_rules")
  @@schema("public")
}
