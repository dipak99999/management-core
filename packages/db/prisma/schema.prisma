  tenantId           String
  title              String
  notes              String?
  plannedFor         DateTime
  channels           String[] // ["Email", "SocialPost", "WhatsApp", "SMS"]
  status             String   @default("Idea") // Idea | Planned | InProgress | Ready | Done | Cancelled
  ownerUserId        String?
  colorTag           String? // display hint
  convertedToDoctype String?
  convertedToDocId   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, plannedFor])
  @@index([tenantId, status])
  @@map("editorial_notes")
  @@schema("public")
}

model Todo {
  id          String    @id @default(cuid())
  tenantId    String
  ownerUserId String
  description String
  dueDate     DateTime? @db.Date
  priority    String    @default("Medium") // Low | Medium | High
  // Optional link to a source doc.
  doctype     String?
  docId       String?
  isDone      Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

