// ==========================================================================
// P2 · Cross-module foundation entities
// Added to unblock Finance / CRM / Manufacturing reports + dashboards.
// Each entity is compact: essential fields only. Full CRUD routes + UI land
// in the per-module implementation phases (P3–P5).
// ==========================================================================

// ---------- Finance: Cost Center ----------

model CostCenter {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String?
  parentId  String?
  isGroup   Boolean  @default(false)
  disabled  Boolean  @default(false)
  budget    Decimal? @db.Decimal(18, 4)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   CostCenter?  @relation("CostCenterTree", fields: [parentId], references: [id])
  children CostCenter[] @relation("CostCenterTree")

  @@unique([tenantId, name])
  @@index([tenantId, parentId])
  @@map("cost_centers")
  @@schema("public")
}

// ---------- Multi-company (Phase 1: foundation) ----------
//
// A Tenant hosts one or more Companies (legal entities). Historically the
// codebase assumed Tenant == Company; this model introduces the split
// without breaking existing behavior:
//   - Every tenant auto-seeds ONE "default" Company matching its own name.
//   - Existing doctypes that DON'T yet carry companyId (customer, supplier,
//     item, etc.) implicitly belong to the tenant's default Company.
//   - Doctypes wired for multi-company in Phase 1 (Account, GLEntry) carry
//     an OPTIONAL companyId; null → tenant's default Company. Later phases
//     will wire more doctypes and eventually drop the fallback.
//
// Full multi-company (companyId on every doctype, per-company chart of
// accounts, consolidated financials with elimination entries) is Phase 2+.

model Company {
  id            String   @id @default(cuid())
  tenantId      String
  // Human-readable name shown on printed invoices, letterheads, etc.
  name          String
  // Short code used in numbering series ("AC" for "Acme Corp" → SI-AC-0001).
  // Deferred: series scoping. For now, code is informational + used in the
  // UI to disambiguate multi-company reports.
  code          String
  // India-specific: GSTIN + state code override. Fallback = Tenant.companyGstin.
  // Multi-state ops have one Company per state, each with its own GSTIN.
  gstin         String?
  homeStateCode String? // 2-digit numeric prefix of gstin
  pan           String?
  // Registered address. Prints on letterhead + used for GSTR-1 origin state.
  address       String?
  city          String?
  postalCode    String?
  // baseCurrency for THIS company. May differ from tenant's baseCurrency
  // (rare, but supports multi-currency conglomerates).
  baseCurrency  String   @default("INR")
  // The tenant's "default" company. Exactly one Company per tenant has
  // this true; used as the fallback when a doctype's companyId is null.
  // Enforced via a unique partial index (tenantId + isDefault when true).
  isDefault     Boolean  @default(false)
  disabled      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Multi-company Phase 4: per-company default account overrides. Every
  // field mirrors the same-named `Tenant.default*AccountId`. Resolution
  // (see packages/db/src/effective-defaults.ts) is: Company override →
  // Tenant fallback → error. Null on any field = "no override, inherit
  // from tenant".
  defaultReceivableAccountId                String?
  defaultPayableAccountId                   String?
  defaultCashAccountId                      String?
  defaultBankAccountId                      String?
  defaultIncomeAccountId                    String?
  defaultExpenseAccountId                   String?
  defaultStockInHandAccountId               String?
  defaultCogsAccountId                      String?
  defaultStockReceivedButNotBilledAccountId String?
  defaultSalaryExpenseAccountId             String?
  defaultEmployeePayableAccountId           String?
  defaultStatutoryPayableAccountId          String?
  defaultFxGainLossAccountId                String?
  defaultLoanReceivableAccountId            String?
  defaultInterestIncomeAccountId            String?
  defaultRetainedEarningsAccountId          String?
  defaultRoundOffAccountId                  String?
  defaultStockAdjustmentAccountId           String?
  defaultLoyaltyDiscountAccountId           String?
  defaultDeferredRevenueAccountId           String?

  tenant           Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accounts         Account[]                  @relation("AccountCompany")
  glEntries        GLEntry[]                  @relation("GLEntryCompany")
  salesInvoices    SalesInvoice[]             @relation("SICompany")
  purchaseInvoices PurchaseInvoice[]          @relation("PICompany")
  paymentEntries   PaymentEntry[]             @relation("PECompany")
  journalEntries   JournalEntry[]             @relation("JECompany")
  icFromJournals   IntercompanyJournalEntry[] @relation("ICFromCompany")
  icToJournals     IntercompanyJournalEntry[] @relation("ICToCompany")
  userAccess       UserCompanyAccess[]

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId, isDefault])
  @@map("companies")
  @@schema("public")
}

// ---------- Intercompany Journal Entry (Phase 4) ----------
//
// Wrapper around a pair of mirror JournalEntries — one in each Company —
// that together represent a single intercompany transaction (e.g. Company
// A pays a bill on behalf of Company B; Company A transfers cash to
// Company B's bank). Created via POST /intercompany-journals which
// atomically:
//   1. Creates the "from" JE inside `fromCompanyId` scope.
//   2. Creates the "to" JE inside `toCompanyId` scope.
//   3. Both JEs are submitted; balanced across their own company only.
//   4. This wrapper row links them so consolidation can auto-eliminate.
//
// Consolidation semantics: because both mirror JEs post to companies with
// distinct companyIds, they naturally appear in per-company reports. In
// the consolidated view they should net to zero — enforced by walking
// intercompany accounts (Account.isIntercompany=true) and eliminating.
model IntercompanyJournalEntry {
  id                 String   @id @default(cuid())
  tenantId           String
  fromCompanyId      String
  toCompanyId        String
  fromJournalId      String   @unique
  toJournalId        String   @unique
  // Canonical intercompany amount in tenant baseCurrency. Both mirror JEs
  // book their IC Receivable/Payable leg for this exact value so the two
  // sides always net to zero at consolidation.
  amount             Decimal  @db.Decimal(20, 4)
  // Multi-currency Phase 5: each side may have its own native currency +
  // conversion rate for the CASH/BANK leg. All GL posts remain in base
  // currency (invariant). When (nativeAmount * conversionRate) differs
  // from `amount`, the difference is booked to that side's FX gain/loss
  // account so the JE stays balanced. Defaults preserve the pre-Phase 5
  // single-currency semantics (currency=INR, rate=1, nativeAmount=amount).
  fromCurrency       String   @default("INR")
  fromConversionRate Decimal  @default(1) @db.Decimal(20, 6)
  fromNativeAmount   Decimal  @default(0) @db.Decimal(20, 4)
  fromFxGainLoss     Decimal  @default(0) @db.Decimal(20, 4)
  toCurrency         String   @default("INR")
  toConversionRate   Decimal  @default(1) @db.Decimal(20, 6)
  toNativeAmount     Decimal  @default(0) @db.Decimal(20, 4)
  toFxGainLoss       Decimal  @default(0) @db.Decimal(20, 4)
  narrative          String?
  postingDate        DateTime
  createdAt          DateTime @default(now())

  // Multi-company Phase 6: lifecycle.
  //   status:        "Active" | "Reversed" | "Cancelled"
  //   reversedById:  set on the ORIGINAL when a reversal was posted;
  //                  points at the new ICJE that mirrors this one with
  //                  DR/CR swapped. Original stays "Reversed" but its
  //                  GLEntries are NOT touched (audit preserved).
  //   reversesId:    set on the REVERSAL entry pointing back at the
  //                  original (inverse of reversedById).
  //   cancelledAt/cancelledBy: cancel path — marks both mirror JEs as
  //                  cancelled + calls cancelGLEntries on their GL rows,
  //                  wiping their impact from reports. Destructive
  //                  compared to reverse, but sometimes correct when
  //                  the entry was posted by mistake.
  status           String    @default("Active")
  reversedById     String?   @unique
  reversesId       String?   @unique
  // Multi-company Phase 8: attributed reversal chain. Records WHO
  // reversed the original entry. `reversedByUserId` sits on the
  // ORIGINAL entry (the one that got reversed); the reversal row
  // itself carries `reversesId` back to the original.
  reversedByUserId String?
  reversedAt       DateTime?
  cancelledAt      DateTime?
  cancelledBy      String?

  tenant      Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCompany Company                   @relation("ICFromCompany", fields: [fromCompanyId], references: [id])
  toCompany   Company                   @relation("ICToCompany", fields: [toCompanyId], references: [id])
  fromJournal JournalEntry              @relation("ICFromJournal", fields: [fromJournalId], references: [id])
  toJournal   JournalEntry              @relation("ICToJournal", fields: [toJournalId], references: [id])
  reversedBy  IntercompanyJournalEntry? @relation("ICJEReversalChain", fields: [reversedById], references: [id])
  reverses    IntercompanyJournalEntry? @relation("ICJEReversalChain")

  @@index([tenantId, postingDate])
  @@map("intercompany_journals")
  @@schema("public")
}

// ---------- Stock: Repost Item Valuation ----------
//
// When a historical stock transaction is edited/cancelled/re-posted, the
// moving-average valuation for downstream SLEs in the same (item, warehouse)
// chain becomes stale — subsequent inflow/outflow decisions were based on a
// now-different average. RepostItemValuation is the audit + trigger record:
// the operator creates a Queued row, the scheduler tick processes it inside
// a $transaction, walks SLEs from fromDate forward, recomputes each row's
// qtyAfterTransaction/valuationRate/stockValue via the same moving-average
// rules, and finally updates the Bin.
//
// Async because a long chain (thousands of SLEs) shouldn't hold the request
// thread. Status transitions Queued → Processing → Done|Failed.

model RepostItemValuation {
  id           String    @id @default(cuid())
  tenantId     String
  itemId       String
  warehouseId  String
  // Everything at or after this date is recomputed. Older SLEs are trusted.
  fromDate     DateTime  @db.Date
  status       String    @default("Queued") // Queued | Processing | Done | Failed
  startedAt    DateTime?
  completedAt  DateTime?
  slesReposted Int       @default(0)
  errorMessage String?
  createdBy    String? // userId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item      Item      @relation("RepostItemValuationItem", fields: [itemId], references: [id])
  warehouse Warehouse @relation("RepostItemValuationWarehouse", fields: [warehouseId], references: [id])

  @@index([tenantId, status, createdAt])
  @@index([tenantId, itemId, warehouseId])
  @@map("repost_item_valuations")
  @@schema("public")
}

// ---------- Accounting: Deferred Revenue recognition ----------
//
// Materialized on SI submit when an SI line references an Item with
// enableDeferredRevenue=true. One row per monthly recognition installment.
// The scheduler tick walks isBooked=false rows with dueDate <= today and
// posts JE: DR Deferred Revenue (liability) / CR Sales (income) to
// recognize each installment. Idempotency via isBooked; safe to double-fire.

model DeferredRevenueSchedule {
  id                 String    @id @default(cuid())
  tenantId           String
  salesInvoiceItemId String
  installmentNo      Int
  dueDate            DateTime  @db.Date
  amount             Decimal   @db.Decimal(18, 4)
  isBooked           Boolean   @default(false)
  bookedAt           DateTime?
  // JE voucher id posted by the tick — enables cancel/rebuild if the
  // parent SI is cancelled.
  bookedVoucherId    String?
  createdAt          DateTime  @default(now())

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoiceItem SalesInvoiceItem @relation("SIItemDeferredRev", fields: [salesInvoiceItemId], references: [id], onDelete: Cascade)

  @@unique([salesInvoiceItemId, installmentNo])
  @@index([tenantId, dueDate, isBooked])
  @@map("deferred_revenue_schedules")
  @@schema("public")
}

// ---------- Compliance: E-way bill (India GST) ----------
//
// Records the NIC portal's response after an operator (or GSP integration)
// generates an EWB against a SalesInvoice. Persisting the returned EWB
// number + validity lets the tenant:
//   - link an SI to its EWB for audit
//   - update Part-B (vehicle change during transit)
//   - extend validity when goods are delayed
//   - cancel within 24h of generation
// Payload generation stays in packages/db/src/eway-bill.ts.

model EWayBill {
  id              String    @id @default(cuid())
  tenantId        String
  salesInvoiceId  String
  // NIC portal returns a 12-digit EWB number. Unique per tenant.
  ewbNumber       String
  ewbDate         DateTime  @db.Date
  // Distance drives validity: 1 day per 200km (rounded up) for normal
  // cargo, 1 day per 20km for Over-Dimensional Cargo (ODC) / multi-modal
  // per NIC rule 138(10). Stored so /extend can recompute the ceiling.
  distanceKm      Int
  cargoType       String   @default("Normal") // Normal | ODC
  validFrom       DateTime
  validTo         DateTime
  // Part-A snapshot (denormalized from invoice at generate time so
  // subsequent SI edits don't rewrite EWB history).
  transportMode   Int // 1=Road 2=Rail 3=Air 4=Ship
  vehicleNumber   String?
  transporterId   String? // GSTIN or Trans ID of the transporter
  transporterName String?
  // Lifecycle
  status          String    @default("Active") // Active | Cancelled | Expired
  cancelledAt     DateTime?
  cancelledReason String?
  partBUpdatedAt  DateTime?
  extendedCount   Int       @default(0)
  remarks         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesInvoice SalesInvoice @relation("SIEWayBill", fields: [salesInvoiceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ewbNumber])
  @@index([tenantId, salesInvoiceId])
  @@index([tenantId, status, validTo])
  @@map("eway_bills")
  @@schema("public")
}

// ---------- CRM: Warranty family ----------
//
// One physical table with `warrantyType` = Definition / ClaimInward /
// ClaimOutward / Helpdesk. Simpler than four near-identical tables; the four
// reports filter by warrantyType at query time.

model Warranty {
  id            String    @id @default(cuid())
  tenantId      String
  warrantyType  String // Definition | ClaimInward | ClaimOutward | Helpdesk
  serialNo      String?
  itemId        String?
  customerId    String?
  supplierId    String?
  startDate     DateTime? @db.Date
  endDate       DateTime? @db.Date
  claimNo       String?
  claimDate     DateTime? @db.Date
  amount        Decimal?  @db.Decimal(18, 4)
  status        String    @default("Open") // Open | InProgress | Resolved | Closed | Rejected
  resolution    String?
  reportedBy    String?
  assignedTo    String?
  description   String?
  attachmentUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item     Item?     @relation("WarrantyItem", fields: [itemId], references: [id])
  customer Customer? @relation("WarrantyCustomer", fields: [customerId], references: [id])
  supplier Supplier? @relation("WarrantySupplier", fields: [supplierId], references: [id])

  @@index([tenantId, warrantyType, status])
  @@index([tenantId, endDate])
  @@index([tenantId, customerId])
  @@map("warranties")
  @@schema("public")
}

model PurchaseWarranty {
  id             String    @id @default(cuid())
  tenantId       String
  supplierId     String?
  itemId         String?
  purchaseDate   DateTime  @db.Date
  warrantyMonths Int       @default(12)
  expiryDate     DateTime? @db.Date
  invoiceNo      String?
  amount         Decimal?  @db.Decimal(18, 4)
  status         String    @default("Active") // Active | Expiring | Expired | Claimed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation("PurchaseWarrantySupplier", fields: [supplierId], references: [id])
  item     Item?     @relation("PurchaseWarrantyItem", fields: [itemId], references: [id])

  @@index([tenantId, expiryDate])
  @@index([tenantId, status])
  @@map("purchase_warranties")
  @@schema("public")
}

// ---------- CRM: Location Capture (GPS pings from field staff) ----------

model LocationCapture {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  employeeId String?
  capturedAt DateTime
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  accuracyM  Decimal? @db.Decimal(8, 2)
  address    String?
  purpose    String? // Visit | DayTrip | CheckIn | CheckOut | Custom
  refDoctype String?
  refDocId   String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, capturedAt])
  @@index([tenantId, employeeId, capturedAt])
  @@index([tenantId, purpose])
  @@map("location_captures")
